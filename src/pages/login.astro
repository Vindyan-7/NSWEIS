---
import PublicLayout from '../layouts/PublicLayout.astro';
import Card from '../components/ui/Card.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { createSupabaseServerClient } from '../lib/supabase/server';
import { validateLoginInput } from '../lib/validation/schemas';
import { getDashboardForRole } from '../lib/permissions/roles';

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const validation = validateLoginInput(formData);

    if (!validation.success) {
      errorMessage = Object.values(validation.errors || {})[0] || 'Invalid credentials';
    } else {
      const { email, password } = validation.data!;
      const supabase = createSupabaseServerClient(Astro);

      const { data: authData, error: authError } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (authError || !authData.user) {
        errorMessage = authError?.message || 'Authentication failed. Please check your credentials.';
      } else {
        const { data: profile } = await supabase
          .from('profiles')
          .select('*')
          .eq('id', authData.user.id)
          .single();

        if (profile) {
          if ((profile as any).active === false) {
            errorMessage = 'Your account has been deactivated. Please contact your administrator.';
          } else {
            return Astro.redirect(getDashboardForRole((profile as any).role));
          }
        } else {
          return Astro.redirect('/no-access');
        }
      }
    }
  } catch (err: any) {
    errorMessage = err?.message || 'An unexpected error occurred.';
  }
}
---

<PublicLayout title="Sign In — NSWEIS">
  <div class="login-container">
    <Card padding="lg" class="login-card glass-panel">
      <div class="login-header">
        <div class="login-brand-icon">
          <span class="brand-badge-text">NS</span>
        </div>
        <h1 class="login-title">Welcome back</h1>
        <p class="login-sub">Sign in to your NSWEIS account to access your portal</p>
      </div>

      {errorMessage && <Alert type="error" title="Sign In Failed">{errorMessage}</Alert>}

      <form method="POST" class="login-form" id="login-form">
        <Input
          label="Official Email Address"
          type="email"
          name="email"
          placeholder="your.name@institution.gov.in"
          autocomplete="email"
          required
        />
        <Input
          label="Password"
          type="password"
          name="password"
          placeholder="••••••••"
          autocomplete="current-password"
          required
        />
        <Button type="submit" variant="primary" size="lg" class="login-submit" id="btn-login-submit">
          <span class="btn-login-text">Sign In &rarr;</span>
        </Button>
      </form>

      <div class="signup-footer text-center pt-4 border-t border-subtle">
        <p class="text-sm text-muted">
          New Student? <a href="/signup" class="font-semibold text-primary">Create Student Account &rarr;</a>
        </p>
      </div>
    </Card>
  </div>
</PublicLayout>

<script>
  const form = document.getElementById('login-form');
  const submitBtn = document.getElementById('btn-login-submit');
  if (form && submitBtn) {
    form.addEventListener('submit', () => {
      submitBtn.classList.add('is-submitting');
      submitBtn.setAttribute('disabled', 'true');
      const textSpan = submitBtn.querySelector('.btn-login-text');
      if (textSpan) textSpan.textContent = 'Signing in...';
    });
  }
</script>

<style>
  .login-container {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8) var(--space-4);
  }

  .login-card {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    background: #ffffff;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .login-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .login-brand-icon {
    width: 3rem;
    height: 3rem;
    background: linear-gradient(135deg, var(--color-primary-600), var(--color-primary-700));
    color: #ffffff;
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.125rem;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
    margin-bottom: var(--space-1);
  }

  .login-title {
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
  }

  .login-sub {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: 320px;
    line-height: 1.4;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .login-submit {
    width: 100%;
    margin-top: var(--space-2);
    min-height: 48px;
    font-weight: 600;
  }

  .login-submit.is-submitting {
    opacity: 0.8;
    cursor: not-allowed;
  }

  .signup-footer {
    margin-top: var(--space-2);
  }
</style>
