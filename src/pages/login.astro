---
import PublicLayout from '../layouts/PublicLayout.astro';
import Card from '../components/ui/Card.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import NSWESILogo from '../components/brand/NSWESILogo.astro';
import { createSupabaseServerClient, createSupabaseAdminClient } from '../lib/supabase/server';
import { validateLoginInput } from '../lib/validation/schemas';
import { getDashboardForRole } from '../lib/permissions/roles';

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const validation = validateLoginInput(formData);

    if (!validation.success) {
      errorMessage = Object.values(validation.errors || {})[0] || 'Invalid credentials';
    } else {
      const { email, password } = validation.data!;
      const supabase = createSupabaseServerClient(Astro);

      const { data: authData, error: authError } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (authError || !authData.user) {
        errorMessage = authError?.message || 'Authentication failed. Please check your credentials.';
      } else {
        let { data: profile } = await supabase
          .from('profiles')
          .select('*')
          .eq('id', authData.user.id)
          .maybeSingle();

        if (!profile) {
          const adminClient = createSupabaseAdminClient();
          const { data: adminProf } = await adminClient
            .from('profiles')
            .select('*')
            .eq('id', authData.user.id)
            .maybeSingle();
          profile = adminProf;
        }

        if (profile) {
          if ((profile as any).active === false) {
            errorMessage = 'Your account has been deactivated. Please contact your administrator.';
          } else {
            let role = (profile as any).role;
            const metaRole = authData.user.user_metadata?.role;
            if (metaRole && (metaRole === 'regional_officer' || metaRole === 'clinician')) {
              role = metaRole;
            }
            return Astro.redirect(getDashboardForRole(role));
          }
        } else {
          return Astro.redirect('/no-access');
        }
      }
    }
  } catch (err: any) {
    errorMessage = err?.message || 'An unexpected error occurred.';
  }
}
---

<PublicLayout title="Sign In — NSWESI">
  <div class="login-container">
    <Card padding="lg" class="login-card glass-panel">
      <div class="login-header">
        <div class="login-brand-wrap">
          <NSWESILogo variant="full" size="md" showSubtitle={true} showTagline={false} />
        </div>
        <h1 class="login-title">Account Portal Sign In</h1>
        <p class="login-sub">Sign in to access your confidential wellbeing dashboard</p>
      </div>

      {errorMessage && <Alert type="error" title="Sign In Failed">{errorMessage}</Alert>}

      <form method="POST" class="login-form" id="login-form">
        <Input
          label="Official Email Address"
          type="email"
          name="email"
          placeholder="your.name@institution.gov.in"
          autocomplete="email"
          required
        />
        <Input
          label="Password"
          type="password"
          name="password"
          placeholder="••••••••"
          autocomplete="current-password"
          required
        />
        <Button type="submit" variant="primary" size="lg" class="login-submit" id="btn-login-submit">
          <span class="btn-login-text">Sign In &rarr;</span>
        </Button>
      </form>

      <div class="signup-footer text-center pt-4 border-t border-subtle">
        <p class="text-sm text-muted">
          New Student? <a href="/signup" class="font-semibold text-primary">Create Student Account &rarr;</a>
        </p>
      </div>
    </Card>
  </div>
</PublicLayout>

<script>
  const form = document.getElementById('login-form');
  const submitBtn = document.getElementById('btn-login-submit');
  if (form && submitBtn) {
    form.addEventListener('submit', () => {
      submitBtn.classList.add('is-submitting');
      submitBtn.setAttribute('disabled', 'true');
      const textSpan = submitBtn.querySelector('.btn-login-text');
      if (textSpan) textSpan.textContent = 'Signing in...';
    });
  }
</script>

<style>
  .login-container {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8) var(--space-4);
  }

  .login-card {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    background: #ffffff;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .login-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .login-brand-wrap {
    margin-bottom: var(--space-3);
  }

  .login-title {
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
  }

  .login-sub {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: 320px;
    line-height: 1.4;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .login-submit {
    width: 100%;
    margin-top: var(--space-2);
    min-height: 48px;
    font-weight: 600;
  }

  .login-submit.is-submitting {
    opacity: 0.8;
    cursor: not-allowed;
  }

  .signup-footer {
    margin-top: var(--space-2);
  }

  @media (max-width: 480px) {
    .login-container {
      padding: var(--space-4) var(--space-3);
    }

    .login-title {
      font-size: 1.35rem;
    }
  }
</style>
