---
import CollegeLayout from '../../layouts/CollegeLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import MetricCard from '../../components/ui/MetricCard.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import ChartCard from '../../components/analytics/ChartCard.astro';
import PrivacyNotice from '../../components/privacy/PrivacyNotice.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import { getProfile } from '../../services/users';
import {
  getCollegeParticipationMetrics,
  getCollegeCategorySummaries,
  getCollegeDepartmentSummaries,
  PRIVACY_THRESHOLD_MIN_STUDENTS,
  parseCollegeAcademicFilters,
} from '../../services/analytics';
import CollegeAcademicFilters from '../../components/analytics/CollegeAcademicFilters.astro';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

if (!user) {
  return Astro.redirect('/login');
}

const profile = await getProfile(supabase, user.id);

if (!profile || (profile.role !== 'college_officer' && profile.role !== 'super_admin')) {
  if (profile?.role === 'student') return Astro.redirect('/student/dashboard');
  if (profile?.role === 'government_admin') return Astro.redirect('/admin/dashboard');
}

const institutionId = profile?.institution_id || '11111111-1111-1111-1111-111111111111';

// Parse Academic Filters using shared helper (supports dept/department_id, year/year_level, section/section_code)
const url = new URL(Astro.request.url);
const filters = parseCollegeAcademicFilters(url.searchParams);
const deptParam = filters.department_id || '';
const yearParam = filters.year_level ? String(filters.year_level) : '';
const sectionParam = filters.section_code || '';

// Fetch departments for filter dropdown
const { data: deptList } = await (supabase.from('departments') as any).select('id, name, code').order('name');
const departments = deptList || [];

// Load analytics with academic filters applied
const participation = await getCollegeParticipationMetrics(supabase, institutionId, filters);
const categorySummaries = await getCollegeCategorySummaries(supabase, institutionId, filters);
const departmentSummaries = await getCollegeDepartmentSummaries(supabase, institutionId);

const categoryDisplayNames: Record<string, string> = {
  academic: 'Academic Support',
  sleep_rest: 'Sleep & Rest',
  emotional_wellbeing: 'Emotional Support',
  social_connection: 'Social Connection',
  family_home: 'Family & Home Support',
  financial: 'Financial Wellbeing',
  career: 'Career Readiness',
  campus_experience: 'Campus Life & Engagement',
  physical_wellbeing: 'Physical Wellbeing',
};

// Privacy threshold check: post-filter completed count must be >= 10
const isSuppressed = participation.participating_students < PRIVACY_THRESHOLD_MIN_STUDENTS;
const hasValidCategoryData = !isSuppressed && categorySummaries.some((cs) => cs.average_score !== null && cs.average_score !== undefined);

// Preserve active filters when navigating back to dashboard
const dashboardBackUrl = url.search ? `/college/dashboard${url.search}` : '/college/dashboard';
---

<CollegeLayout title="Institutional Insights" activePath="/college/insights">
  <PageHeader
    title="Institutional Insights & Analytical Breakdown"
    subtitle={`Comparative trends across wellness domains and academic departments for ${participation.active_cycle_name}`}
  >
    <a href={dashboardBackUrl}>
      <Button variant="outline" size="sm">&larr; Back to Dashboard</Button>
    </a>
  </PageHeader>

  <div class="college-insights-layout">
    {/* Reusable Shared Academic Filter Component */}
    <CollegeAcademicFilters
      departments={departments}
      selectedDepartment={deptParam}
      selectedYear={yearParam}
      selectedSection={sectionParam}
      baseUrl="/college/insights"
      totalEligible={participation.total_eligible_students}
      completedCount={participation.participating_students}
      isSuppressed={isSuppressed}
    />

    {/* Section 1: Overview Metrics */}
    <div class="metrics-grid">
      <MetricCard
        title="Check-in Participation"
        value={`${participation.participation_rate.toFixed(1)}%`}
        change="Campus-wide Engagement Rate"
        changeType="neutral"
      />
      <MetricCard
        title="Participating Students"
        value={participation.participating_students.toLocaleString()}
        change="Completed Reflection Submissions"
        changeType="neutral"
      />
      <MetricCard
        title="Privacy Protection"
        value="≥ 10 Students"
        change="Anonymous Group Threshold Enforced"
        changeType="positive"
      />
    </div>

    {/* Section 2: Category Breakdown Chart */}
    <div class="insights-grid">
      <ChartCard
        title="Category Wellness Indicators"
        subtitle="Aggregate average indicator scores (0.0 to 10.0)"
      >
        {isSuppressed ? (
          <div class="suppressed-notice-box">
            <span class="font-semibold text-primary">&bull; PRIVACY THRESHOLD ACTIVE</span>
            <p class="text-muted text-sm mt-1">
              Detailed category indicators are withheld because fewer than 10 completed student reflections exist for this cycle.
            </p>
          </div>
        ) : hasValidCategoryData ? (
          <div class="category-chart-bars">
            {categorySummaries.map((cs) => {
              const displayName = categoryDisplayNames[cs.category] || cs.category.replace('_', ' ');
              const scoreVal = cs.average_score !== null && cs.average_score !== undefined ? cs.average_score : null;
              const fillWidth = scoreVal !== null ? Math.max(12, Math.min(100, scoreVal * 10)) : 0;
              const bandClass = cs.dominant_band ? `band-${cs.dominant_band}` : 'band-stable';

              return (
                <div class="bar-row">
                  <div class="bar-header">
                    <span class="bar-label">{displayName}</span>
                    {scoreVal !== null ? (
                      <span class="bar-score font-bold">{scoreVal.toFixed(1)} / 10</span>
                    ) : (
                      <span class="bar-score text-muted">--</span>
                    )}
                  </div>
                  <div class="bar-track">
                    {scoreVal !== null ? (
                      <div class={`bar-fill ${bandClass}`} style={`width: ${fillWidth}%`}>
                        <span class="bar-inside-val">{scoreVal.toFixed(1)}</span>
                      </div>
                    ) : (
                      <div class="bar-no-data">No Data Recorded</div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="empty-category-box">
            <h4 class="empty-title font-semibold">Category analytics are not yet available for this cycle.</h4>
            <p class="empty-desc text-muted text-sm">
              Aggregate category indicators will appear automatically after completed reflections have been processed.
            </p>
          </div>
        )}
      </ChartCard>

      {/* Section 3: Department Comparison */}
      <Card padding="lg">
        <h3 class="card-section-title">Department Aggregate Comparison</h3>
        <p class="section-subtext">Group scores are displayed only for departments meeting the 10-student anonymity threshold.</p>

        <div class="dept-insights-list">
          {departmentSummaries.map((dept) => (
            <div class="dept-insight-item">
              <div class="dept-top">
                <span class="dept-name-title">{dept.department_name} ({dept.department_code})</span>
                {dept.is_suppressed ? (
                  <Badge variant="neutral" size="sm">Suppressed (&lt;10)</Badge>
                ) : (
                  <Badge variant={dept.dominant_band || 'neutral'} size="sm">
                    {dept.dominant_band?.replace('_', ' ')}
                  </Badge>
                )}
              </div>

              {dept.is_suppressed ? (
                <p class="dept-suppression-note">{dept.suppression_message || 'Insufficient group size for anonymous reporting.'}</p>
              ) : (
                <div class="dept-stats-row">
                  <span>Average Indicator: <strong>{dept.average_overall_score !== null ? `${dept.average_overall_score.toFixed(1)} / 10` : '--'}</strong></span>
                  <span>Participating: <strong>{dept.participating_student_count} students</strong></span>
                </div>
              )}
            </div>
          ))}
        </div>
      </Card>
    </div>

    <PrivacyNotice variant="full" />
  </div>
</CollegeLayout>

<style>
  .college-insights-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .insights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: var(--space-6);
  }

  .card-section-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: var(--space-1);
  }

  .section-subtext {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .category-chart-bars {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .bar-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .bar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bar-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .bar-score {
    font-size: 0.8125rem;
    color: var(--color-text-main);
  }

  .bar-track {
    height: 26px;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
    border: 1px solid var(--color-border-subtle);
  }

  .bar-fill {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: var(--space-2);
    border-radius: var(--radius-md);
    transition: width 0.3s ease;
    min-width: 32px;
  }

  .bar-fill.band-stable {
    background-color: var(--color-band-stable, #10b981);
  }

  .bar-fill.band-watch {
    background-color: var(--color-band-improving, #3b82f6);
  }

  .bar-fill.band-needs_attention {
    background-color: var(--color-band-attention, #f59e0b);
  }

  .bar-fill.band-elevated {
    background-color: var(--color-band-elevated, #ef4444);
  }

  .bar-inside-val {
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
  }

  .bar-no-data {
    height: 100%;
    display: flex;
    align-items: center;
    padding-left: var(--space-3);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .empty-category-box, .suppressed-notice-box {
    padding: var(--space-5);
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    text-align: center;
  }

  .dept-insights-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .dept-insight-item {
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
  }

  .dept-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-1);
  }

  .dept-name-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .dept-suppression-note {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .dept-stats-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  @media (max-width: 640px) {
    .insights-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
