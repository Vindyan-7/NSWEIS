---
import CollegeLayout from '../../layouts/CollegeLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import MetricCard from '../../components/ui/MetricCard.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import ParticipationDonut from '../../components/analytics/ParticipationDonut.astro';
import FiveStagePrivacyFlow from '../../components/privacy/FiveStagePrivacyFlow.astro';
import ClosedLoopDataFlow from '../../components/privacy/ClosedLoopDataFlow.astro';
import NonClinicalDisclaimer from '../../components/privacy/NonClinicalDisclaimer.astro';
import PrivacyNotice from '../../components/privacy/PrivacyNotice.astro';
import {
  LockKeyhole,
  Calendar,
  Sparkles,
  ListChecks,
  Building,
  ShieldCheck,
  Lightbulb,
  ArrowRight,
} from '@lucide/astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import { getProfile } from '../../services/users';
import { getLiveCollegeDashboardData, getCollegeStudentRoster, parseCollegeAcademicFilters } from '../../services/analytics';
import { getInstitutionInterventions } from '../../services/interventions';
import { getCollegeSupportRequests, updateCollegeSupportRequestStatus } from '../../services/privacy';

import CollegeAcademicFilters from '../../components/analytics/CollegeAcademicFilters.astro';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

if (!user) {
  return Astro.redirect('/login');
}

const profile = await getProfile(supabase, user.id);

if (!profile || (profile.role !== 'college_officer' && profile.role !== 'super_admin')) {
  if (profile?.role === 'student') return Astro.redirect('/student/dashboard');
  if (profile?.role === 'government_admin') return Astro.redirect('/admin/dashboard');
}

// SERVER-AUTHORITATIVE INSTITUTION SCOPE (CRITICAL AUDIT ITEM A & B)
const institutionId = profile?.institution_id || '11111111-1111-1111-1111-111111111111';

// Handle Support Request Status Update Actions
let supportNotice = '';
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const actionType = formData.get('action_type')?.toString();
    if (actionType === 'update_support_status') {
      const reqId = formData.get('request_id')?.toString();
      const newStatus = formData.get('status')?.toString() as any;
      if (reqId && newStatus) {
        await updateCollegeSupportRequestStatus(supabase, reqId, newStatus);
        supportNotice = `Support request status updated to '${newStatus.replace('_', ' ')}'.`;
      }
    }
  } catch (err: any) {
    console.error('[COLLEGE DASHBOARD] Support action error:', err);
  }
}

// Parse Academic Filters using shared helper (supports dept/department_id, year/year_level, section/section_code)
const url = new URL(Astro.request.url);
const filters = parseCollegeAcademicFilters(url.searchParams);
const deptParam = filters.department_id || '';
const yearParam = filters.year_level ? String(filters.year_level) : '';
const sectionParam = filters.section_code || '';

// Fetch departments for filter dropdown
const { data: deptList } = await (supabase.from('departments') as any).select('id, name, code').order('name');
const departments = deptList || [];

// Load live server-authoritative institutional analytics, roster, support requests & interventions with filter scope
const dashboardData = await getLiveCollegeDashboardData(supabase, institutionId, filters);
const interventions = await getInstitutionInterventions(supabase, institutionId);
const supportRequests = await getCollegeSupportRequests(supabase, institutionId);
const studentRoster = await getCollegeStudentRoster(supabase, institutionId, filters);

const { cycle, participation, analytics, action_intelligence, recommendation_distribution, task_activity } = dashboardData;

const ongoingInterventions = interventions.filter((i) => i.status === 'ongoing').length;
const scheduledInterventions = interventions.filter((i) => i.status === 'scheduled').length;
const completedInterventions = interventions.filter((i) => i.status === 'completed').length;
---

<CollegeLayout title="Institutional Wellness Intelligence" activePath="/college/dashboard">
  {/* Hero Header */}
  <PageHeader
    title="College Institutional Intelligence"
    subtitle={`${cycle ? cycle.name : 'Weekly Cycle'} — Anonymous aggregate well-being trends for National Institute of Technology, Apex (NITA01)`}
  >
    <a href="/college/interventions/new">
      <Button variant="primary" size="sm">+ Create Intervention</Button>
    </a>
  </PageHeader>

  <div class="college-dashboard-layout">
    {/* Reusable Shared Academic Filter Component */}
    <CollegeAcademicFilters
      departments={departments}
      selectedDepartment={deptParam}
      selectedYear={yearParam}
      selectedSection={sectionParam}
      baseUrl="/college/dashboard"
      totalEligible={participation.total_eligible_students}
      completedCount={participation.completed_students}
      isSuppressed={analytics.is_suppressed}
    />

    {/* Active Cycle Context Banner */}
    <Card padding="md" class="active-cycle-banner">
      <div class="banner-content">
        <div class="banner-left">
          <Badge variant={cycle?.status === 'active' ? 'stable' : 'neutral'} size="md">
            &bull; {cycle?.status === 'active' ? 'Cycle Active' : 'Cycle Inactive'}
          </Badge>
          <span class="inst-pill-tag">National Institute of Technology, Apex &bull; NITA01</span>
        </div>
        {cycle && (
          <div class="banner-right">
            <Calendar size={14} class="text-muted" aria-hidden="true" />
            <span class="cycle-dates">
              {new Date(cycle.starts_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} – {new Date(cycle.ends_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
          </div>
        )}
      </div>
    </Card>

    {/* Section 1: Animated KPI Cards Row */}
    <div class="section-container">
      <h3 class="section-heading">Campus Participation Overview</h3>
      <div class="kpi-cards-grid">
        <div class="kpi-card-wrap">
          <MetricCard
            title="Eligible Students"
            value={participation.total_eligible_students.toLocaleString()}
            change="Campus Student Scope"
            changeType="neutral"
          />
        </div>
        <div class="kpi-card-wrap">
          <MetricCard
            title="Started Check-in"
            value={participation.started_students.toLocaleString()}
            change="Sessions Initiated"
            changeType="neutral"
          />
        </div>
        <div class="kpi-card-wrap">
          <MetricCard
            title="Completed Reflections"
            value={participation.completed_students.toLocaleString()}
            change="Finished Check-ins"
            changeType="positive"
          />
        </div>
        <div class="kpi-card-wrap">
          <MetricCard
            title="Completion Rate"
            value={`${participation.completion_percentage.toFixed(1)}%`}
            change="Cycle Completion"
            changeType={participation.completion_percentage > 50 ? "positive" : "neutral"}
          />
        </div>
      </div>
    </div>

    {/* Section 2: Participation Intelligence (Donut + Progress Bar Grid) */}
    <div class="two-col-dashboard-grid">
      <Card padding="lg" class="donut-chart-card">
        <div class="card-title-row">
          <h3 class="card-section-title">Participation Distribution</h3>
          <Badge variant="neutral" size="sm">Operational Aggregates</Badge>
        </div>
        <p class="section-subtext">Visual breakdown of student check-in completions for the active weekly cycle.</p>

        <div class="donut-chart-wrapper">
          <ParticipationDonut
            completed={participation.completed_students}
            total={participation.total_eligible_students}
            percentage={participation.completion_percentage}
            size={160}
          />
        </div>
      </Card>

      <Card padding="lg" class="progress-bar-card">
        <div class="card-title-row">
          <h3 class="card-section-title">Weekly Participation Progress</h3>
          <span class="pct-badge font-bold">{participation.completion_percentage.toFixed(1)}%</span>
        </div>
        <p class="section-subtext">Campus participation for the active reflection cycle.</p>

        <div class="progress-container">
          <div class="progress-status-row">
            <span class="progress-count-text font-semibold">
              {participation.completed_students} / {participation.total_eligible_students} students completed
            </span>
            <span class="progress-sub-text">
              {participation.total_eligible_students - participation.completed_students} remaining
            </span>
          </div>

          <div class="progress-track-bg">
            <div class="progress-track-fill" style={`width: ${Math.max(5, participation.completion_percentage)}%;`}></div>
          </div>

          <p class="progress-footnote text-muted">
            <ShieldCheck size={14} class="inline-icon" /> Operational participation metrics remain visible to monitor engagement.
          </p>
        </div>
      </Card>
    </div>

    {/* Section 3: Reflection Analytics & Supportive Focus Distribution Grid */}
    <div class="two-col-dashboard-grid">
      {/* Category Analytics Card */}
      <Card padding="lg" class="analytics-card">
        <div class="card-title-row">
          <h3 class="card-section-title">Reflection Category Analytics</h3>
          <Badge variant="neutral" size="sm">Privacy Threshold: &ge; 10 Students</Badge>
        </div>
        <p class="section-subtext">Aggregate category indicators from completed reflections. Excludes private student text.</p>

        {analytics.is_suppressed ? (
          <div class="suppressed-privacy-card">
            <div class="suppressed-lock-icon">
              <LockKeyhole size={28} />
            </div>
            <div class="suppressed-content">
              <span class="suppressed-badge-tag">&bull; PRIVACY PROTECTED</span>
              <h4 class="suppressed-heading">Anonymous Analytics Protected</h4>
              <p class="suppressed-body">
                Category indicators are hidden because fewer than 10 students ({participation.completed_students} completed) have finished check-ins for this reflection cycle.
              </p>
              <div class="suppressed-meta-row">
                <span class="meta-pill">Current Completed: <strong>{participation.completed_students}</strong></span>
                <span class="meta-pill">Minimum Threshold: <strong>10</strong></span>
              </div>
            </div>
          </div>
        ) : (
          <div class="categories-list">
            {analytics.category_summaries.map((cs) => (
              <div class="category-row">
                <div class="cat-info">
                  <span class="cat-title">{cs.category.replace('_', ' ')}</span>
                  {cs.dominant_band && (
                    <Badge variant={cs.dominant_band} size="sm">
                      {cs.dominant_band.replace('_', ' ')}
                    </Badge>
                  )}
                </div>
                <span class="score-display font-semibold">
                  {cs.average_score !== null && cs.average_score !== undefined ? `${cs.average_score.toFixed(1)} / 10` : '--'}
                </span>
              </div>
            ))}
          </div>
        )}
      </Card>

      {/* Focus / Recommendation Distribution Card */}
      <Card padding="lg" class="focus-distribution-card">
        <div class="card-title-row">
          <h3 class="card-section-title">Supportive Focus Distribution</h3>
          <Sparkles size={18} class="text-primary" aria-hidden="true" />
        </div>
        <p class="section-subtext">Distribution of focus areas generated for students based on weekly reflection signals.</p>

        {recommendation_distribution.length > 0 ? (
          <div class="distribution-list">
            {recommendation_distribution.map((rec) => (
              <div class="distribution-item">
                <div class="dist-header">
                  <span class="dist-title font-medium">{rec.title}</span>
                  <span class="dist-pct font-semibold">{rec.percentage}% ({rec.count})</span>
                </div>
                <div class="dist-track">
                  <div class="dist-fill" style={`width: ${rec.percentage}%;`}></div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-focus-box">
            <Sparkles size={28} class="text-muted" aria-hidden="true" />
            <h4 class="empty-focus-title">No Recommendation Signals Available</h4>
            <p class="empty-focus-desc">
              Aggregate supportive focus areas will appear when privacy-safe recommendation signals are generated for completed check-ins.
            </p>
          </div>
        )}
      </Card>
    </div>

    {/* Section 4: Institutional Action Intelligence */}
    <Card padding="lg" class="action-intelligence-card">
      <div class="card-title-row">
        <div>
          <h3 class="card-section-title">Institutional Action Intelligence</h3>
          <p class="section-subtext">Automated, privacy-safe campus support recommendations derived from aggregate student reflection signals.</p>
        </div>
        <Badge variant={action_intelligence.is_suppressed ? "neutral" : "improving"} size="sm">
          {action_intelligence.is_suppressed ? "Privacy Protected (<10 Completed)" : "Active Action Signals"}
        </Badge>
      </div>

      {action_intelligence.is_suppressed ? (
        <div class="suppressed-privacy-card">
          <div class="suppressed-lock-icon">
            <LockKeyhole size={28} />
          </div>
          <div class="suppressed-content">
            <span class="suppressed-badge-tag">&bull; PRIVACY PROTECTION ACTIVE</span>
            <h4 class="suppressed-heading">Action Signals Withheld</h4>
            <p class="suppressed-body">
              {action_intelligence.suppression_notice}
            </p>
            <div class="suppressed-meta-row">
              <span class="meta-pill">Completed Reflections: <strong>{participation.completed_students}</strong></span>
              <span class="meta-pill">Required Anonymity Threshold: <strong>10</strong></span>
            </div>
          </div>
        </div>
      ) : action_intelligence.suggestions.length > 0 ? (
        <div class="action-suggestions-grid">
          {action_intelligence.suggestions.map((sug) => (
            <div class={`action-sug-item strength-${sug.signal_strength.toLowerCase()}`}>
              <div class="sug-header">
                <div class="sug-title-wrap">
                  <Lightbulb size={18} class="sug-icon" aria-hidden="true" />
                  <span class="sug-focus-title font-semibold">{sug.focus_title}</span>
                </div>
                <Badge
                  variant={
                    sug.signal_strength === 'ELEVATED'
                      ? 'declining'
                      : sug.signal_strength === 'MODERATE'
                      ? 'improving'
                      : 'neutral'
                  }
                  size="sm"
                >
                  {sug.signal_strength} SIGNAL
                </Badge>
              </div>

              <p class="sug-text">{sug.action_suggestion}</p>

              <div class="sug-footer">
                <span class="sug-meta text-muted">
                  Based on {sug.participating_count} anonymous completed check-ins
                </span>
                <a href={`/college/interventions/new?category=${sug.category}`} class="sug-action-link font-medium">
                  Create Campus Program &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-int-box">
          <Lightbulb size={24} class="text-muted" aria-hidden="true" />
          <p class="empty-state-text">No aggregate action signals requiring campus intervention at this time.</p>
        </div>
      )}
    </Card>

    {/* Section 5: Task Activity & Credits Metrics Card */}
    <Card padding="lg" class="task-activity-card">
      <div class="card-title-row">
        <h3 class="card-section-title">Activity & Task Completion Metrics</h3>
        <ListChecks size={20} class="text-primary" aria-hidden="true" />
      </div>
      <p class="section-subtext">Campus-wide tracking of voluntary well-being task completion and points awarded.</p>

      <div class="task-activity-grid">
        <div class="activity-metric-box">
          <span class="act-val font-bold">{task_activity.tasks_assigned}</span>
          <span class="act-lbl">Tasks Assigned</span>
        </div>
        <div class="activity-metric-box">
          <span class="act-val font-bold">{task_activity.tasks_completed}</span>
          <span class="act-lbl">Tasks Completed</span>
        </div>
        <div class="activity-metric-box">
          <span class="act-val font-bold">{task_activity.completion_rate}%</span>
          <span class="act-lbl">Task Completion Rate</span>
        </div>
        <div class="activity-metric-box">
          <span class="act-val font-bold text-primary">+{task_activity.total_credits_earned}</span>
          <span class="act-lbl">Points Awarded</span>
        </div>
      </div>
    </Card>

    {/* Section 6: Institutional Interventions */}
    <Card padding="lg" class="interventions-summary-card">
      <div class="card-title-row">
        <div>
          <h3 class="card-section-title">Institutional Interventions & Action Tracking</h3>
          <p class="section-subtext">Active and planned campus-wide preventative programs initiated by college leadership.</p>
        </div>
        <a href="/college/interventions">
          <Button variant="outline" size="sm">Manage Interventions ({interventions.length})</Button>
        </a>
      </div>

      <div class="int-summary-pills">
        <span class="int-pill-count">&bull; {ongoingInterventions} Active</span>
        <span class="int-pill-count">&bull; {scheduledInterventions} Scheduled</span>
        <span class="int-pill-count">&bull; {completedInterventions} Completed</span>
      </div>

      {interventions.length > 0 ? (
        <div class="interventions-preview-list">
          {interventions.slice(0, 3).map((item) => (
            <div class="int-preview-item">
              <div class="int-preview-left">
                <span class="int-cat-badge">{item.category.replace('_', ' ')}</span>
                <span class="int-preview-title font-medium">{item.title}</span>
              </div>
              <div class="int-preview-right">
                <span class="int-location">📍 {item.location}</span>
                <Badge
                  variant={
                    item.status === 'completed'
                      ? 'stable'
                      : item.status === 'ongoing'
                      ? 'improving'
                      : item.status === 'cancelled'
                      ? 'neutral'
                      : 'primary'
                  }
                  size="sm"
                >
                  {item.status}
                </Badge>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-int-box">
          <Building size={24} class="text-muted" aria-hidden="true" />
          <p class="empty-state-text">No institutional interventions have been created yet for this campus.</p>
        </div>
      )}
    </Card>

    {/* Section 6b: Student Support Requests (Contact Counsellor Workflow) */}
    <Card padding="lg" class="support-requests-card">
      <div class="card-title-row">
        <div>
          <h3 class="card-section-title">Student Support Requests</h3>
          <p class="section-subtext">Direct, confidential requests for campus counsellor contact submitted by students.</p>
        </div>
        <Badge variant={supportRequests.filter(r => r.status !== 'resolved').length > 0 ? "elevated" : "neutral"} size="sm">
          {supportRequests.filter(r => r.status !== 'resolved').length} Pending Requests
        </Badge>
      </div>

      {supportNotice && (
        <div class="p-3 mb-4 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded-lg text-xs font-semibold">
          ✓ {supportNotice}
        </div>
      )}

      {supportRequests.length > 0 ? (
        <div class="support-requests-list flex flex-col gap-3">
          {supportRequests.map((req) => (
            <div class="req-item p-4 bg-surface-subtle border border-subtle rounded-xl flex flex-col gap-2">
              <div class="flex justify-between items-center flex-wrap gap-2">
                <div>
                  <span class="font-bold text-main">{req.student_name}</span> &bull;{' '}
                  <span class="text-xs text-muted">Year {req.year_level} ({req.section_code})</span> &bull;{' '}
                  <span class="text-xs text-muted">Requested: {new Date(req.requested_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
                </div>
                <Badge variant={req.status === 'resolved' ? 'stable' : req.status === 'contact_planned' ? 'improving' : req.status === 'acknowledged' ? 'primary' : 'elevated'} size="sm">
                  {req.status.replace('_', ' ')}
                </Badge>
              </div>
              <p class="text-xs text-muted italic">"{req.notes || 'Student requested campus counsellor support contact.'}"</p>
              <div class="pt-2 border-t border-subtle flex justify-between items-center text-xs text-muted flex-wrap gap-2">
                <span class="text-xs font-medium text-emerald-700">🔒 Confidential Request &bull; Zero reflection text or answers attached</span>
                <form method="POST" class="flex gap-2">
                  <input type="hidden" name="action_type" value="update_support_status" />
                  <input type="hidden" name="request_id" value={req.id} />
                  {req.status === 'submitted' && (
                    <button type="submit" name="status" value="acknowledged" class="px-3 py-1 bg-neutral-100 text-neutral-800 rounded font-semibold hover:bg-neutral-200">
                      Acknowledge
                    </button>
                  )}
                  {req.status !== 'resolved' && (
                    <button type="submit" name="status" value="contact_planned" class="px-3 py-1 bg-primary-50 text-primary-700 border border-primary-200 rounded font-semibold hover:bg-primary-100">
                      Plan Contact
                    </button>
                  )}
                  {req.status !== 'resolved' && (
                    <button type="submit" name="status" value="resolved" class="px-3 py-1 bg-emerald-600 text-white rounded font-semibold hover:bg-emerald-700">
                      Mark Resolved ✓
                    </button>
                  )}
                </form>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-support-box p-6 text-center bg-surface-subtle border border-subtle rounded-xl text-muted text-xs">
          No student support requests currently require attention for your institution.
        </div>
      )}
    </Card>

    {/* Section 6c: Institutional Student Roster */}
    <Card padding="lg" class="student-roster-card">
      <div class="card-title-row mb-3">
        <div>
          <h3 class="card-section-title">Institutional Student Roster ({studentRoster.length})</h3>
          <p class="section-subtext">Approved operational roster showing weekly reflection participation state. Excludes private reflection answers and individual wellness scores.</p>
        </div>
        <Badge variant="neutral" size="sm">
          {deptParam || yearParam || sectionParam ? 'Filtered Cohort' : 'All Students'}
        </Badge>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-subtle text-muted uppercase font-semibold bg-surface-subtle">
              <th class="p-3">Student Name</th>
              <th class="p-3">Department</th>
              <th class="p-3">Year / Section</th>
              <th class="p-3">Cycle Completion</th>
              <th class="p-3">Support Request</th>
            </tr>
          </thead>
          <tbody>
            {studentRoster.map((st) => (
              <tr class="border-b border-subtle hover:bg-surface-subtle">
                <td class="p-3 font-semibold text-main">{st.full_name}</td>
                <td class="p-3 text-muted">{st.department_name} ({st.department_code})</td>
                <td class="p-3 text-muted">Year {st.year_level} - {st.section_code}</td>
                <td class="p-3">
                  <Badge variant={st.cycle_status === 'completed' ? 'stable' : st.cycle_status === 'in_progress' ? 'improving' : 'neutral'} size="sm">
                    {st.cycle_status.replace('_', ' ')}
                  </Badge>
                </td>
                <td class="p-3">
                  {st.has_active_support_request ? (
                    <Badge variant="elevated" size="sm">Requested Contact</Badge>
                  ) : (
                    <span class="text-muted">None</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>

    {/* Section 6d: Annual Completion & Credit Tracking Model */}
    <Card padding="md" class="annual-tracking-card bg-amber-50/50 border border-amber-200 rounded-xl">
      <div class="flex items-center gap-3">
        <span class="text-amber-700 font-bold text-sm">🗓️ Annual Completion Model:</span>
        <span class="text-xs text-amber-900">
          Annual completion tracking will populate as additional weekly cycles are completed. Weekly check-ins build towards 1 institutional academic/wellness credit per academic year.
        </span>
      </div>
    </Card>

    {/* Section 7: Closed-Loop Data Flow Component (Feature 6) */}
    <ClosedLoopDataFlow />

    {/* Section 8: Institutional Privacy Protection Panel (Feature 3) */}
    <Card padding="lg" class="officer-privacy-panel">
      <div class="privacy-header">
        <div class="flex-title">
          <h3 class="card-section-title">Institutional Privacy & Governance Status</h3>
          <Badge variant="stable" size="md">&bull; PRIVACY PROTECTION ACTIVE</Badge>
        </div>
        <p class="section-subtext">Designed around DPDP privacy principles: Architectural privacy controls strictly enforce anonymous aggregate reporting.</p>
      </div>

      <div class="privacy-check-grid">
        <div class="privacy-check-item">
          <span class="check-icon text-success">&check;</span>
          <div>
            <strong>Individual Reflections Private:</strong>
            <span class="block-text">Student response text and ratings are 100% confidential and inaccessible to officers.</span>
          </div>
        </div>
        <div class="privacy-check-item">
          <span class="check-icon text-success">&check;</span>
          <div>
