---
import CollegeLayout from '../../layouts/CollegeLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import MetricCard from '../../components/ui/MetricCard.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import PrivacyNotice from '../../components/privacy/PrivacyNotice.astro';
import { LockKeyhole, Calendar, Sparkles, ListChecks, CalendarRange } from '@lucide/astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import { getProfile } from '../../services/users';
import { getLiveCollegeDashboardData } from '../../services/analytics';
import { getInstitutionInterventions } from '../../services/interventions';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

if (!user) {
  return Astro.redirect('/login');
}

const profile = await getProfile(supabase, user.id);

if (!profile || (profile.role !== 'college_officer' && profile.role !== 'super_admin')) {
  if (profile?.role === 'student') return Astro.redirect('/student/dashboard');
  if (profile?.role === 'government_admin') return Astro.redirect('/admin/dashboard');
}

const institutionId = profile?.institution_id || '11111111-1111-1111-1111-111111111111';

// Load live server-authoritative institutional data & interventions
const dashboardData = await getLiveCollegeDashboardData(supabase, institutionId);
const interventions = await getInstitutionInterventions(supabase, institutionId);

const { cycle, participation, analytics, recommendation_distribution, task_activity } = dashboardData;
---

<CollegeLayout title="Institutional Wellness Overview" activePath="/college/dashboard">
  <PageHeader
    title="College Institutional Intelligence"
    subtitle={`Anonymous aggregate well-being trends for ${cycle ? cycle.name : 'Weekly Cycle'}`}
  >
    <a href="/college/interventions/new">
      <Button variant="primary" size="sm">+ Create Intervention</Button>
    </a>
  </PageHeader>

  <div class="college-dashboard-layout">
    {/* SECTION A: CURRENT WEEK */}
    <Card padding="lg" class="current-week-card">
      <div class="week-card-header">
        <div class="week-info">
          <span class="week-badge">Active Weekly Cycle</span>
          <h3 class="week-title">{cycle ? cycle.name : 'No Active Cycle'}</h3>
          {cycle && (
            <p class="week-dates">
              <Calendar size={14} aria-hidden="true" />
              {new Date(cycle.starts_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} – {new Date(cycle.ends_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </p>
          )}
        </div>
        <div class="week-status-badge">
          <Badge variant={cycle?.status === 'active' ? 'stable' : 'neutral'}>
            Status: {cycle ? cycle.status : 'Inactive'}
          </Badge>
        </div>
      </div>
    </Card>

    {/* SECTION B: PARTICIPATION */}
    <div class="section-container">
      <h3 class="section-heading">Campus Participation Metrics</h3>
      <div class="metrics-grid">
        <MetricCard
          title="Eligible Students"
          value={participation.total_eligible_students.toLocaleString()}
          change="Campus Student Scope"
          changeType="neutral"
        />
        <MetricCard
          title="Started Check-in"
          value={participation.started_students.toLocaleString()}
          change="Sessions Initiated"
          changeType="neutral"
        />
        <MetricCard
          title="Completed Reflections"
          value={participation.completed_students.toLocaleString()}
          change="Finished Check-ins"
          changeType="positive"
        />
        <MetricCard
          title="Completion Rate"
          value={`${participation.completion_percentage.toFixed(1)}%`}
          change="Cycle Completion"
          changeType={participation.completion_percentage > 50 ? "positive" : "neutral"}
        />
      </div>
    </div>

    {/* SECTION C & D: REFLECTION ANALYTICS & FOCUS DISTRIBUTION */}
    <div class="dashboard-section-grid">
      {/* SECTION C: WELL-BEING / REFLECTION ANALYTICS */}
      <Card padding="lg" class="analytics-card">
        <div class="section-header">
          <h3 class="card-section-title">Reflection Category Analytics</h3>
          <Badge variant="neutral" size="sm">Privacy Threshold: ≥ 10 Students</Badge>
        </div>
        <p class="section-subtext">Aggregate category indicators from completed reflections. Excludes private student text.</p>

        {analytics.is_suppressed ? (
          <div class="suppressed-box">
            <LockKeyhole size={20} class="lock-icon" aria-hidden="true" />
            <div>
              <h4 class="suppressed-title">Privacy Protection Active</h4>
              <p class="suppressed-desc">
                Data is suppressed because fewer than 10 students ({participation.completed_students} completed) have finished check-ins for this cycle.
              </p>
            </div>
          </div>
        ) : (
          <div class="categories-list">
            {analytics.category_summaries.map((cs) => (
              <div class="category-row">
                <div class="cat-info">
                  <span class="cat-title">{cs.category.replace('_', ' ')}</span>
                  {cs.dominant_band && (
                    <Badge variant={cs.dominant_band} size="sm">
                      {cs.dominant_band.replace('_', ' ')}
                    </Badge>
                  )}
                </div>
                <span class="score-display">
                  {cs.average_score !== null ? `${cs.average_score.toFixed(1)} / 10` : '--'}
                </span>
              </div>
            ))}
          </div>
        )}
      </Card>

      {/* SECTION D: FOCUS / RECOMMENDATION INSIGHTS */}
      <Card padding="lg" class="focus-distribution-card">
        <div class="section-header">
          <h3 class="card-section-title">Supportive Focus Distribution</h3>
          <Sparkles size={18} class="text-primary" aria-hidden="true" />
        </div>
        <p class="section-subtext">Distribution of focus areas generated for students based on weekly reflection signals.</p>

        {recommendation_distribution.length > 0 ? (
          <div class="distribution-list">
            {recommendation_distribution.map((rec) => (
              <div class="distribution-item">
                <div class="dist-header">
                  <span class="dist-title">{rec.title}</span>
                  <span class="dist-pct">{rec.percentage}% ({rec.count})</span>
                </div>
                <div class="dist-track">
                  <div class="dist-fill" style={`width: ${rec.percentage}%;`}></div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty-state-text">No recommendation distribution available for this cycle yet.</p>
        )}
      </Card>
    </div>

    {/* SECTION E: TASK ACTIVITY */}
    <Card padding="lg" class="task-activity-card">
      <div class="section-header">
        <h3 class="card-section-title">Activity & Task Completion Metrics</h3>
        <ListChecks size={20} class="text-primary" aria-hidden="true" />
      </div>
      <p class="section-subtext">Campus-wide tracking of voluntary well-being task completion and credits awarded.</p>

      <div class="task-activity-grid">
        <div class="activity-metric-box">
          <span class="act-val">{task_activity.tasks_assigned}</span>
          <span class="act-lbl">Tasks Assigned</span>
        </div>
        <div class="activity-metric-box">
          <span class="act-val">{task_activity.tasks_completed}</span>
          <span class="act-lbl">Tasks Completed</span>
        </div>
        <div class="activity-metric-box">
          <span class="act-val">{task_activity.completion_rate}%</span>
          <span class="act-lbl">Task Completion Rate</span>
        </div>
        <div class="activity-metric-box">
          <span class="act-val">+{task_activity.total_credits_earned}</span>
          <span class="act-lbl">Credits Awarded</span>
        </div>
      </div>
    </Card>

    {/* SECTION F: INSTITUTIONAL INTERVENTIONS */}
    <Card padding="lg" class="interventions-summary-card">
      <div class="section-header">
        <h3 class="card-section-title">Institutional Interventions & Action Tracking</h3>
        <a href="/college/interventions">
          <Button variant="outline" size="sm">Manage Interventions ({interventions.length})</Button>
        </a>
      </div>
      <p class="section-subtext">Active and planned campus-wide preventative programs initiated by college leadership.</p>

      {interventions.length > 0 ? (
        <div class="interventions-preview-list">
          {interventions.slice(0, 3).map((item) => (
            <div class="int-preview-item">
              <div class="int-preview-left">
                <span class="int-cat-badge">{item.category.replace('_', ' ')}</span>
                <span class="int-preview-title">{item.title}</span>
              </div>
              <div class="int-preview-right">
                <span class="int-location">📍 {item.location}</span>
                <Badge
                  variant={
                    item.status === 'completed'
                      ? 'stable'
                      : item.status === 'ongoing'
                      ? 'improving'
                      : item.status === 'cancelled'
                      ? 'neutral'
                      : 'primary'
                  }
                  size="sm"
                >
                  {item.status}
                </Badge>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="empty-state-text">No institutional interventions have been created yet for this campus.</p>
      )}
    </Card>

    {/* College Officer Privacy Protection Panel */}
    <Card padding="lg" class="officer-privacy-panel">
      <div class="privacy-header">
        <div class="flex-title">
          <h3 class="card-section-title">Institutional Privacy & Governance Status</h3>
          <Badge variant="stable" size="md">&bull; PRIVACY PROTECTION ACTIVE</Badge>
        </div>
        <p class="section-subtext">Architectural privacy controls strictly enforce anonymous aggregate reporting.</p>
      </div>

      <div class="privacy-check-grid">
        <div class="privacy-check-item">
          <span class="check-icon text-success">&check;</span>
          <div>
            <strong>Individual Reflections Private:</strong>
            <span class="block-text">Student response text and ratings are 100% confidential and inaccessible to officers.</span>
          </div>
        </div>
        <div class="privacy-check-item">
          <span class="check-icon text-success">&check;</span>
          <div>
            <strong>Anonymity Threshold ({participation.completed_students} / 10 Completed):</strong>
            <span class="block-text">
              {analytics.is_suppressed
                ? "SUFFERED / HIDDEN: Category averages are masked because fewer than 10 students completed reflections."
                : "REPORTING: Group size meets minimum privacy threshold (&ge;10 completed reflections)."}
            </span>
          </div>
        </div>
        <div class="privacy-check-item">
          <span class="check-icon text-success">&check;</span>
          <div>
            <strong>Institution Scope Enforced:</strong>
            <span class="block-text">Server-authoritative queries isolate data to your assigned campus ({institutionId}).</span>
          </div>
        </div>
      </div>
    </Card>

    <PrivacyNotice variant="full" />
  </div>
</CollegeLayout>

<style>
  .college-dashboard-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .current-week-card {
    background: linear-gradient(135deg, #ffffff 0%, var(--color-primary-50) 100%);
    border-left: 4px solid var(--color-primary-600);
  }

  .week-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .week-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-700);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .week-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: var(--space-1);
  }

  .week-dates {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .section-heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: var(--space-3);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  .dashboard-section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: var(--space-6);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-1);
  }

  .card-section-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .section-subtext {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .suppressed-box {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
  }

  .lock-icon {
    color: var(--color-primary-600);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .suppressed-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .suppressed-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .categories-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .category-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
  }

  .cat-info {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .cat-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-main);
    text-transform: capitalize;
  }

  .score-display {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .distribution-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .distribution-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .dist-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
  }

  .dist-title {
    font-weight: 600;
    color: var(--color-text-main);
  }

  .dist-pct {
    font-weight: 700;
    color: var(--color-primary-600);
  }

  .dist-track {
    height: 8px;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .dist-fill {
    height: 100%;
    background-color: var(--color-primary-600);
    border-radius: var(--radius-full);
  }

  .task-activity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
  }

  .activity-metric-box {
    padding: var(--space-4);
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .act-val {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary-600);
  }

  .act-lbl {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .interventions-preview-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .int-preview-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
  }

  .int-preview-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .int-cat-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary-700);
    background-color: var(--color-primary-50);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    text-transform: capitalize;
  }

  .int-preview-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .int-preview-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .int-location {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .empty-state-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
