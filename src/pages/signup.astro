<script>
  // Dynamic academic cascading, summaries, password toggle & submission lock
  const instSelect = document.getElementById('institution_select') as HTMLSelectElement | null;
  const deptSelect = document.getElementById('department_select') as HTMLSelectElement | null;
  const yearSelect = document.getElementById('year_select') as HTMLSelectElement | null;
  const secSelect = document.getElementById('section_select') as HTMLSelectElement | null;
  const loadingIndicator = document.getElementById('structure-loading-indicator');
  const emptyAlert = document.getElementById('structure-empty-alert');
  const emptyMessage = document.getElementById('structure-empty-message');

  // Placement summary card
  const summaryCard = document.getElementById('placement-summary-card');
  const summaryDeptText = document.getElementById('placement-dept-text');
  const summaryMetaText = document.getElementById('placement-meta-text');

  let currentStructure: {
    departments: Array<{ id: string; name: string; code: string }>;
    years: Array<{ year_level: number; label: string }>;
    sections: Array<{ id: string; department_id: string; year_level: number; section_code: string }>;
  } = { departments: [], years: [], sections: [] };

  function updatePlacementSummary() {
    if (!summaryCard || !summaryDeptText || !summaryMetaText) return;
    const instVal = instSelect?.value;
    const deptVal = deptSelect?.value;
    const yearVal = yearSelect?.value;
    const secVal = secSelect?.value;

    if (instVal && deptVal && yearVal && secVal) {
      const deptOption = deptSelect?.options[deptSelect.selectedIndex]?.text || '';
      const yearOption = yearSelect?.options[yearSelect.selectedIndex]?.text || '';
      const secOption = secSelect?.options[secSelect.selectedIndex]?.text || '';

      summaryDeptText.textContent = deptOption;
      summaryMetaText.textContent = `${yearOption} · ${secOption}`;
      summaryCard.classList.remove('hidden');
    } else {
      summaryCard.classList.add('hidden');
    }
  }

  function filterSections() {
    if (!secSelect) return;
    const selectedDeptId = deptSelect ? deptSelect.value : '';
    const selectedYear = yearSelect ? Number(yearSelect.value) : NaN;

    const prevValue = secSelect.value;
    secSelect.innerHTML = '';

    const defaultOption = document.createElement('option');
    defaultOption.value = '';
    defaultOption.textContent = '-- Select Section --';
    secSelect.appendChild(defaultOption);

    if (!currentStructure.sections || currentStructure.sections.length === 0) {
      updatePlacementSummary();
      return;
    }

    const availableSections = currentStructure.sections.filter((s) => {
      const deptMatches = !s.department_id || s.department_id === selectedDeptId;
      const yearMatches = !s.year_level || s.year_level === selectedYear;
      return deptMatches && yearMatches;
    });

    const uniqueCodes = new Set<string>();
    const uniqueSections: Array<{ section_code: string }> = [];

    availableSections.forEach((s) => {
      if (!uniqueCodes.has(s.section_code)) {
        uniqueCodes.add(s.section_code);
        uniqueSections.push(s);
      }
    });

    uniqueSections.sort((a, b) => a.section_code.localeCompare(b.section_code));

    uniqueSections.forEach((s) => {
      const opt = document.createElement('option');
      opt.value = s.section_code;
      opt.textContent = `Section ${s.section_code}`;
      if (s.section_code === prevValue) {
        opt.selected = true;
      }
      secSelect.appendChild(opt);
    });

    updatePlacementSummary();
  }

  if (instSelect) {
    instSelect.addEventListener('change', async () => {
      const institutionId = instSelect.value;

      if (!institutionId) {
        if (deptSelect) {
          deptSelect.innerHTML = '<option value="">-- Select College First --</option>';
          deptSelect.disabled = true;
        }
        if (yearSelect) {
          yearSelect.innerHTML = '<option value="">-- Select College First --</option>';
          yearSelect.disabled = true;
        }
        if (secSelect) {
          secSelect.innerHTML = '<option value="">-- Select College First --</option>';
          secSelect.disabled = true;
        }
        if (emptyAlert) emptyAlert.classList.add('hidden');
        updatePlacementSummary();
        return;
      }

      if (loadingIndicator) loadingIndicator.classList.remove('hidden');
      if (emptyAlert) emptyAlert.classList.add('hidden');

      if (deptSelect) deptSelect.disabled = true;
      if (yearSelect) yearSelect.disabled = true;
      if (secSelect) secSelect.disabled = true;

      try {
        const res = await fetch(`/api/academic-structure?institution_id=${encodeURIComponent(institutionId)}`);
        if (!res.ok) {
          throw new Error('Failed to fetch academic structure');
        }

        const data = await res.json();
        currentStructure = data;

        if (deptSelect) {
          deptSelect.innerHTML = '<option value="">-- Select Department --</option>';
          if (data.departments && data.departments.length > 0) {
            data.departments.forEach((d: any) => {
              const opt = document.createElement('option');
              opt.value = d.id;
              opt.textContent = `${d.name} (${d.code})`;
              deptSelect.appendChild(opt);
            });
            deptSelect.disabled = false;
          }
        }

        if (yearSelect) {
          yearSelect.innerHTML = '<option value="">-- Select Year --</option>';
          if (data.years && data.years.length > 0) {
            data.years.forEach((y: any) => {
              const opt = document.createElement('option');
              opt.value = String(y.year_level);
              opt.textContent = y.label;
              yearSelect.appendChild(opt);
            });
            yearSelect.disabled = false;
          }
        }

        if (secSelect) {
          secSelect.innerHTML = '<option value="">-- Select Section --</option>';
          if (data.sections && data.sections.length > 0) {
            secSelect.disabled = false;
            filterSections();
          }
        }

        const hasDepts = data.departments && data.departments.length > 0;
        const hasYears = data.years && data.years.length > 0;
        const hasSections = data.sections && data.sections.length > 0;

        if (!hasDepts || !hasYears || !hasSections) {
          if (emptyAlert && emptyMessage) {
            emptyMessage.textContent = 'Your institution has not completed its academic setup yet. Please contact your college administrator.';
            emptyAlert.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (emptyAlert && emptyMessage) {
          emptyMessage.textContent = 'Academic structure is temporarily unavailable. Please try again or contact your administrator.';
          emptyAlert.classList.remove('hidden');
        }
      } finally {
        if (loadingIndicator) loadingIndicator.classList.add('hidden');
        updatePlacementSummary();
      }
    });
  }

  if (deptSelect) deptSelect.addEventListener('change', filterSections);
  if (yearSelect) yearSelect.addEventListener('change', filterSections);
  if (secSelect) secSelect.addEventListener('change', updatePlacementSummary);

  // If institution is pre-selected on load, trigger fetch
  if (instSelect && instSelect.value && (!deptSelect || deptSelect.children.length <= 1)) {
    instSelect.dispatchEvent(new Event('change'));
  }

  // Password Visibility Toggle
  document.querySelectorAll('.pwd-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;
      const input = document.getElementById(targetId) as HTMLInputElement | null;
      if (!input) return;

      const eyeIcon = btn.querySelector('.icon-eye');
      const eyeOffIcon = btn.querySelector('.icon-eye-off');

      if (input.type === 'password') {
        input.type = 'text';
        eyeIcon?.classList.add('hidden');
        eyeOffIcon?.classList.remove('hidden');
      } else {
        input.type = 'password';
        eyeIcon?.classList.remove('hidden');
        eyeOffIcon?.classList.add('hidden');
      }
    });
  });

  // Password Requirements Real-Time Feedback
  const pwdInput = document.getElementById('password_input') as HTMLInputElement | null;
  const confirmPwdInput = document.getElementById('confirm_password_input') as HTMLInputElement | null;
  const reqLength = document.getElementById('req-length');
  const reqMatch = document.getElementById('req-match');

  function checkPasswordReqs() {
    const val = pwdInput?.value || '';
    const confirmVal = confirmPwdInput?.value || '';

    if (reqLength) {
      if (val.length >= 6) {
        reqLength.classList.add('valid');
      } else {
        reqLength.classList.remove('valid');
      }
    }

    if (reqMatch) {
      if (val && confirmVal && val === confirmVal) {
        reqMatch.classList.add('valid');
      } else {
        reqMatch.classList.remove('valid');
      }
    }
  }

  if (pwdInput) pwdInput.addEventListener('input', checkPasswordReqs);
  if (confirmPwdInput) confirmPwdInput.addEventListener('input', checkPasswordReqs);

  // Prevent Double Submission & Show Loading State on Submit
  const signupForm = document.getElementById('student-signup-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('btn-submit-signup') as HTMLButtonElement | null;
  const btnSpinner = document.getElementById('btn-spinner');

  if (signupForm && submitBtn) {
    signupForm.addEventListener('submit', () => {
      // Allow browser validation to pass first
      if (!signupForm.checkValidity()) return;

      submitBtn.disabled = true;
      const textSpan = submitBtn.querySelector('.btn-text-content');
      if (textSpan) textSpan.textContent = 'Creating your account...';
      const arrowIcon = submitBtn.querySelector('.btn-arrow');
      if (arrowIcon) arrowIcon.classList.add('hidden');
      if (btnSpinner) btnSpinner.classList.remove('hidden');
    });
  }
</script>

