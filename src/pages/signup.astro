---
import PublicLayout from '../layouts/PublicLayout.astro';
import {
  ShieldCheck,
  CheckCircle2,
  ArrowRight,
  ExternalLink,
  Lock,
  Eye,
  EyeOff,
  Check,
} from '@lucide/astro';
import NSWESILogo from '../components/brand/NSWESILogo.astro';
import { createSupabaseServerClient, createSupabaseAdminClient } from '../lib/supabase/server';
import { updateStudentConsent } from '../services/privacy';
import {
  getInstitutionAcademicStructure,
  validateStudentAcademicPlacement,
} from '../services/provisioning';

let errorMessage = '';
let isSuccess = false;
let createdAccountSummary: {
  fullName: string;
  email: string;
  collegeName: string;
  departmentName: string;
  yearLabel: string;
  sectionCode: string;
  studentRollNo: string;
} | null = null;

let formValues = {
  email: '',
  full_name: '',
  student_roll_no: '',
  institution_id: '',
  department_id: '',
  year_level: '',
  section_code: '',
};

const supabase = createSupabaseServerClient(Astro);
const adminClient = createSupabaseAdminClient();

// 1. Fetch active institutions (Source of Truth)
const { data: institutionsData } = await adminClient
  .from('institutions')
  .select('id, name, code, active')
  .eq('active', true)
  .order('name');

const validInstitutions: any[] = institutionsData || [];

const institutionOptions = [
  { value: '', label: '-- Select Your College / Institution --' },
  ...validInstitutions.map((inst: any) => ({
    value: inst.id,
    label: `${inst.name} (${inst.code})`,
  })),
];

// Pre-load academic structure if an institution was submitted
let initialStructure = {
  departments: [] as any[],
  years: [] as any[],
  sections: [] as any[],
};

if (formValues.institution_id) {
  initialStructure = await getInstitutionAcademicStructure(supabase, formValues.institution_id);
}

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get('email')?.toString().trim().toLowerCase() || '';
    const password = formData.get('password')?.toString() || '';
    const confirmPassword = formData.get('confirm_password')?.toString() || '';
    const fullName = formData.get('full_name')?.toString().trim() || '';
    const studentRollNo = formData.get('student_roll_no')?.toString().trim() || '';
    const institutionId = formData.get('institution_id')?.toString()?.trim() || '';
    const departmentId = formData.get('department_id')?.toString()?.trim() || '';
    const yearLevelRaw = formData.get('year_level')?.toString() || '';
    const sectionCode = formData.get('section_code')?.toString()?.trim().toUpperCase() || '';
    const privacyConsent = formData.get('privacy_consent')?.toString();

    formValues = {
      email,
      full_name: fullName,
      student_roll_no: studentRollNo,
      institution_id: institutionId,
      department_id: departmentId,
      year_level: yearLevelRaw,
      section_code: sectionCode,
    };

    if (institutionId) {
      initialStructure = await getInstitutionAcademicStructure(supabase, institutionId);
    }

    // CRITICAL ROLE RULE: Ignore any client-submitted role value and hardcode to 'student'
    const HARDCODED_STUDENT_ROLE = 'student';

    // 1. Server-side Input Validation with human-readable error messages
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const yearLevel = yearLevelRaw ? Number(yearLevelRaw) : NaN;

    if (!email || !password || !confirmPassword || !fullName || !institutionId || !departmentId || !yearLevelRaw || !sectionCode) {
      errorMessage = 'Please complete all required fields to proceed.';
    } else if (!emailRegex.test(email)) {
      errorMessage = 'Please enter a valid official email address.';
    } else if (password !== confirmPassword) {
      errorMessage = 'Passwords do not match. Please re-enter your password.';
    } else if (password.length < 6) {
      errorMessage = 'Password must be at least 6 characters long.';
    } else if (!privacyConsent || privacyConsent !== 'accepted') {
      errorMessage = 'Please review and accept the privacy consent before creating your account.';
    } else {
      // 2. Server-Authoritative Academic Placement Validation (Enforces configured hierarchy)
      const placementCheck = await validateStudentAcademicPlacement(supabase, {
        institutionId,
        departmentId,
        yearLevel,
        sectionCode,
      });

      if (!placementCheck.valid) {
        errorMessage = "We couldn't verify this academic placement. Please refresh your academic details and try again.";
      } else {
        // 3. Create Auth User with auto-confirmed email so student can log in immediately
        const { data: createData, error: createError } = await adminClient.auth.admin.createUser({
          email,
          password,
          email_confirm: true,
          user_metadata: {
            full_name: fullName,
            role: HARDCODED_STUDENT_ROLE,
          },
        });

        let userObj = createData?.user;
        let signUpError = createError;

        if (createError && !createError.message?.toLowerCase().includes('already')) {
          const { data: signUpData, error: sErr } = await supabase.auth.signUp({
            email,
            password,
            options: {
              data: {
                full_name: fullName,
                role: HARDCODED_STUDENT_ROLE,
              },
            },
          });
          userObj = signUpData?.user;
          signUpError = sErr;
          if (userObj?.id) {
            await adminClient.auth.admin.updateUserById(userObj.id, { email_confirm: true });
          }
        }

        const isDuplicateUser =
          signUpError?.message?.toLowerCase().includes('already registered') ||
          signUpError?.message?.toLowerCase().includes('already exists') ||
          (userObj && userObj.identities && userObj.identities.length === 0);

        if (signUpError || !userObj || isDuplicateUser) {
          if (isDuplicateUser) {
            errorMessage = 'This email is already registered. Try signing in instead.';
          } else {
            errorMessage = "We couldn't create your account right now. Please try again in a moment.";
          }
        } else {
          const userId = userObj.id;

          // 4. Create/Upsert Student Profile in public.profiles via Admin Client
          const profilePayload: any = {
            id: userId,
            full_name: fullName,
            role: HARDCODED_STUDENT_ROLE, // Hardcoded student role ONLY
            institution_id: institutionId,
            department_id: departmentId,
            student_roll_no: studentRollNo || null,
            year_level: yearLevel,
            section_code: sectionCode,
            active: true,
            created_at: new Date().toISOString(),
            updated_at: new Date().toISOString(),
          };

          const { error: profileError } = await (adminClient.from('profiles') as any).upsert(
            profilePayload,
            { onConflict: 'id' }
          );

          if (profileError) {
            console.error('[SIGNUP] Profile creation error:', profileError);
            try {
              await adminClient.auth.admin.deleteUser(userId);
            } catch (delErr) {
              console.error('[SIGNUP] Auth rollback error:', delErr);
            }
            errorMessage = "We couldn't create your account right now. Please try again in a moment.";
          } else {
            // 5. Persist DPDP Privacy Consent Server-Side with Policy Version & Timestamp
            await updateStudentConsent(supabase, userId, 'active');

            // 6. Resolve clean display names for dedicated success screen
            const matchedInst = validInstitutions.find((i: any) => i.id === institutionId);
            const matchedDept = initialStructure.departments.find((d: any) => d.id === departmentId);
            const matchedYear = initialStructure.years.find((y: any) => String(y.year_level) === String(yearLevel));

            createdAccountSummary = {
              fullName,
              email,
              collegeName: matchedInst ? `${matchedInst.name} (${matchedInst.code})` : 'Configured Institution',
              departmentName: matchedDept ? `${matchedDept.name} (${matchedDept.code})` : 'Configured Department',
              yearLabel: matchedYear ? matchedYear.label : `Year ${yearLevel}`,
              sectionCode,
              studentRollNo: studentRollNo || '',
            };

            isSuccess = true;
          }
        }
      }
    }
  } catch (err: any) {
    console.error('[SIGNUP] System error during registration:', err);
    errorMessage = "We couldn't create your account right now. Please try again in a moment.";
  }
}
---

<PublicLayout
  title={isSuccess ? "Account Created — NSWESI" : "Create Student Account — NSWESI"}
  brandName="NSWESI"
  navRightAction={{ label: "Sign in", href: "/login", subtext: "Already have an account?" }}
>
  <div class="signup-page-wrapper">
    <div class="signup-card-container">
      {isSuccess && createdAccountSummary ? (
        /* ============================================================ */
        /* DEDICATED SUCCESS EXPERIENCE (PHASE 20.1)                    */
        /* ============================================================ */
        <div class="success-experience-card" role="region" aria-label="Account Created Successfully">
          <div class="success-brand-header">
            <NSWESILogo variant="compact" size="sm" />
          </div>
          <div class="success-icon-badge" aria-hidden="true">
            <CheckCircle2 size={38} class="success-check-icon" />
          </div>

          <h1 class="success-title">Account Created Successfully</h1>
          <p class="success-welcome">Welcome to NSWESI, {createdAccountSummary.fullName}</p>
          <p class="success-subtitle">
            Your confidential student account is active and linked to your institution's wellbeing network.
          </p>

          <div class="success-summary-box">
            <div class="summary-section">
              <h2 class="summary-section-title">Account</h2>
              <div class="summary-row">
                <span class="summary-field-label">Official Email:</span>
                <span class="summary-field-value">{createdAccountSummary.email}</span>
              </div>
            </div>

            <div class="summary-divider"></div>

            <div class="summary-section">
              <h2 class="summary-section-title">Academic Placement</h2>
              <div class="summary-grid">
                <div class="summary-row">
                  <span class="summary-field-label">College:</span>
                  <span class="summary-field-value">{createdAccountSummary.collegeName}</span>
                </div>
                <div class="summary-row">
                  <span class="summary-field-label">Department:</span>
                  <span class="summary-field-value">{createdAccountSummary.departmentName}</span>
                </div>
                <div class="summary-row">
                  <span class="summary-field-label">Academic Year:</span>
                  <span class="summary-field-value">{createdAccountSummary.yearLabel}</span>
                </div>
                <div class="summary-row">
                  <span class="summary-field-label">Section:</span>
                  <span class="summary-field-value">Section {createdAccountSummary.sectionCode}</span>
                </div>
                {createdAccountSummary.studentRollNo && (
                  <div class="summary-row">
                    <span class="summary-field-label">Student Roll No:</span>
                    <span class="summary-field-value">{createdAccountSummary.studentRollNo}</span>
                  </div>
                )}
              </div>
            </div>
          </div>

          <div class="next-steps-card">
            <h3 class="next-steps-title">What's next?</h3>
            <ol class="next-steps-list">
              <li>
                <span class="step-num-pill">1</span>
                <span>Sign in with your official email address and password</span>
              </li>
              <li>
                <span class="step-num-pill">2</span>
                <span>Open your private <strong>Student Dashboard</strong></span>
              </li>
              <li>
                <span class="step-num-pill">3</span>
                <span>Complete your weekly wellness reflection when an active cycle is open</span>
              </li>
              <li>
                <span class="step-num-pill">4</span>
                <span>Explore confidential wellbeing activities, motivation points, and campus support</span>
              </li>
            </ol>
          </div>

          <div class="success-actions">
            <a href="/login" class="btn-success-primary" id="btn-goto-login">
              <span>Go to Student Login</span>
              <ArrowRight size={18} />
            </a>
            <a href="/" class="btn-success-secondary">Return to Home</a>
          </div>

          <div class="trust-footer-note">
            <ShieldCheck size={14} class="text-emerald" />
            <span>DPDP Act Protected · Non-clinical supportive student ecosystem</span>
          </div>
        </div>
      ) : (
        /* ============================================================ */
        /* SINGLE-PAGE GUIDED ONBOARDING JOURNEY (PHASE 20.1A)          */
        /* ============================================================ */
        <>
          <header class="onboarding-hero text-center">
            <div class="onboarding-brand-wrap">
              <NSWESILogo variant="compact" size="md" href="/" />
            </div>
            <div class="privacy-pill">
              <Lock size={12} class="privacy-pill-icon" aria-hidden="true" />
              <span>Private student onboarding</span>
            </div>
            <h1 class="hero-title">Create your student account</h1>
            <p class="hero-subtitle">
              Join your institution's confidential weekly reflection and student wellbeing support network.
            </p>
          </header>

          <!-- 3-Step Visual Roadmap -->
          <nav class="step-indicator-bar" aria-label="Onboarding Roadmap">
            <div class="step-pill active" id="step-pill-1">
              <span class="step-number">01</span>
              <span class="step-text">Academic Details</span>
            </div>
            <div class="step-line"></div>
            <div class="step-pill active" id="step-pill-2">
              <span class="step-number">02</span>
              <span class="step-text">Personal Details</span>
            </div>
            <div class="step-line"></div>
            <div class="step-pill active" id="step-pill-3">
              <span class="step-number">03</span>
              <span class="step-text">Privacy & Consent</span>
            </div>
          </nav>

          {errorMessage && (
            <div class="error-banner" role="alert" aria-live="assertive">
              <div class="error-icon-box">!</div>
              <div class="error-text-content">
                <span class="error-title">Unable to create account</span>
                <p class="error-desc">{errorMessage}</p>
              </div>
            </div>
          )}

          <div class="onboarding-journey-wrap">
            <form method="POST" class="onboarding-form" id="student-signup-form" novalidate>
              {/* ============================================================ */}
              {/* SECTION 01 — ACADEMIC DETAILS                                */}
              {/* ============================================================ */}
              <section class="onboarding-section" id="stage-academic">
                <div class="section-badge-header">
                  <div class="section-number-pill">01</div>
                  <div class="section-title-group">
                    <h2 class="section-main-title">Academic Details</h2>
                    <p class="section-main-desc">Select your institution and academic placement.</p>
                  </div>
                </div>

                <div class="field-block mt-5">
                  <label for="institution_select" class="field-label">
                    College / Institution <span class="field-required">*</span>
                  </label>
                  <select
                    id="institution_select"
                    name="institution_id"
                    class="field-select"
                    required
                  >
                    {institutionOptions.map((opt) => (
                      <option value={opt.value} selected={formValues.institution_id === opt.value}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                </div>

                <div id="structure-loading-indicator" class="loading-state-box hidden" aria-live="polite">
                  <span class="spinner-dot"></span>
                  <span>Retrieving academic structure for this institution...</span>
                </div>

                <div id="structure-empty-alert" class="structure-alert-box hidden" role="status">
                  <h4 class="alert-title">Academic structure unavailable</h4>
                  <p class="alert-desc" id="structure-empty-message">
                    Your institution has not completed its academic setup yet. Please contact your college administrator.
                  </p>
                </div>

                <div class="fields-grid mt-4">
                  <div class="field-block">
                    <label for="department_select" class="field-label">
                      Department / Branch <span class="field-required">*</span>
                    </label>
                    <select
                      id="department_select"
                      name="department_id"
                      class="field-select"
                      required
                      disabled={!formValues.institution_id}
                    >
                      <option value="">{formValues.institution_id ? '-- Select Department --' : '-- Select College First --'}</option>
                      {initialStructure.departments.map((d) => (
                        <option value={d.id} selected={formValues.department_id === d.id}>
                          {d.name} ({d.code})
                        </option>
                      ))}
                    </select>
                  </div>

                  <div class="field-block">
                    <label for="year_select" class="field-label">
                      Academic Year <span class="field-required">*</span>
                    </label>
                    <select
                      id="year_select"
                      name="year_level"
                      class="field-select"
                      required
                      disabled={!formValues.institution_id}
                    >
                      <option value="">{formValues.institution_id ? '-- Select Year --' : '-- Select College First --'}</option>
                      {initialStructure.years.map((y) => (
                        <option value={y.year_level} selected={formValues.year_level === String(y.year_level)}>
                          {y.label}
                        </option>
                      ))}
                    </select>
                  </div>
                </div>

                <div class="fields-grid mt-4">
                  <div class="field-block">
                    <label for="section_select" class="field-label">
                      Section <span class="field-required">*</span>
                    </label>
                    <select
                      id="section_select"
                      name="section_code"
                      class="field-select"
                      required
                      disabled={!formValues.institution_id}
                    >
                      <option value="">{formValues.institution_id ? '-- Select Section --' : '-- Select College First --'}</option>
                      {initialStructure.sections.map((s) => (
                        <option value={s.section_code} selected={formValues.section_code === s.section_code}>
                          Section {s.section_code}
                        </option>
                      ))}
                    </select>
                  </div>

                  <div class="field-block">
                    <label for="student_roll_no" class="field-label">
                      Student Roll No / University ID
                    </label>
                    <input
                      type="text"
                      id="student_roll_no"
                      name="student_roll_no"
                      class="field-input"
                      value={formValues.student_roll_no}
                      placeholder="e.g. 2024CSE042"
                      autocomplete="off"
                    />
                  </div>
                </div>

                <!-- Academic Placement Confirmation Summary (Section 5) -->
                <div id="placement-summary-card" class="placement-summary-card hidden" aria-live="polite">
                  <div class="summary-check-icon">
                    <Check size={16} />
                  </div>
                  <div class="summary-info">
                    <span class="summary-badge-text">Your academic placement</span>
                    <p class="summary-detail-main" id="placement-dept-text">—</p>
                    <p class="summary-detail-sub" id="placement-meta-text">—</p>
                  </div>
                </div>
              </section>

              {/* SEPARATION DIVIDER BETWEEN 01 AND 02 (48-56px spacing) */}
              <div class="section-divider-line" aria-hidden="true"></div>

              {/* ============================================================ */}
              {/* SECTION 02 — PERSONAL DETAILS                                */}
              {/* ============================================================ */}
              <section class="onboarding-section" id="stage-personal">
                <div class="section-badge-header">
                  <div class="section-number-pill">02</div>
                  <div class="section-title-group">
                    <h2 class="section-main-title">Personal Details</h2>
                    <p class="section-main-desc">Enter your official credentials for your NSWESI account.</p>
                  </div>
                </div>

                <div class="fields-grid mt-5">
                  <div class="field-block">
                    <label for="full_name" class="field-label">
                      Full Name <span class="field-required">*</span>
                    </label>
                    <input
                      type="text"
                      id="full_name"
                      name="full_name"
                      class="field-input"
                      value={formValues.full_name}
                      placeholder="e.g. Rahul Sharma"
                      required
                      autocomplete="name"
                    />
                  </div>

                  <div class="field-block">
                    <label for="email" class="field-label">
                      Official Email Address <span class="field-required">*</span>
                    </label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      class="field-input"
                      value={formValues.email}
                      placeholder="rahul.sharma@college.edu.in"
                      required
                      autocomplete="email"
                    />
                    <span class="field-hint">Use an email address you can access for your NSWESI account.</span>
                  </div>
                </div>

                <div class="fields-grid mt-4">
                  <div class="field-block">
                    <label for="password_input" class="field-label">
                      Password <span class="field-required">*</span>
                    </label>
                    <div class="password-input-wrap">
                      <input
                        type="password"
                        id="password_input"
                        name="password"
                        class="field-input pr-10"
                        placeholder="••••••••"
                        required
                        autocomplete="new-password"
                      />
                      <button
                        type="button"
                        class="pwd-toggle-btn"
                        data-target="password_input"
                        aria-label="Toggle password visibility"
                      >
                        <span class="icon-eye"><Eye size={18} /></span>
                        <span class="icon-eye-off hidden"><EyeOff size={18} /></span>
                      </button>
                    </div>
                  </div>

                  <div class="field-block">
                    <label for="confirm_password_input" class="field-label">
                      Confirm Password <span class="field-required">*</span>
                    </label>
                    <div class="password-input-wrap">
                      <input
                        type="password"
                        id="confirm_password_input"
                        name="confirm_password"
                        class="field-input pr-10"
                        placeholder="••••••••"
                        required
                        autocomplete="new-password"
                      />
                      <button
                        type="button"
                        class="pwd-toggle-btn"
                        data-target="confirm_password_input"
                        aria-label="Toggle password visibility"
                      >
                        <span class="icon-eye"><Eye size={18} /></span>
                        <span class="icon-eye-off hidden"><EyeOff size={18} /></span>
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Password Requirements Checklist (Section 6) -->
                <div class="password-reqs-card mt-3" id="password-reqs-card">
                  <span class="reqs-title">Password requirements</span>
                  <div class="reqs-list">
                    <span class="req-item" id="req-length">
                      <span class="req-check-icon">✓</span> Minimum 6 characters
                    </span>
                    <span class="req-item" id="req-match">
                      <span class="req-check-icon">✓</span> Passwords match
                    </span>
                  </div>
                </div>
              </section>

              {/* SEPARATION DIVIDER BETWEEN 02 AND 03 (48-56px spacing) */}
              <div class="section-divider-line" aria-hidden="true"></div>

              {/* ============================================================ */}
              {/* SECTION 03 — PRIVACY & CONSENT                               */}
              {/* ============================================================ */}
              <section class="onboarding-section" id="stage-privacy">
                <div class="section-badge-header">
                  <div class="section-number-pill">03</div>
                  <div class="section-title-group">
                    <h2 class="section-main-title">Privacy & Consent</h2>
                    <p class="section-main-desc">Your weekly reflections are confidential and protected.</p>
                  </div>
                </div>

                <div class="privacy-guarantee-card mt-5">
                  <div class="privacy-header-row">
                    <div class="privacy-shield-icon">
                      <ShieldCheck size={20} />
                    </div>
                    <div>
                      <h4 class="privacy-card-title">Your Privacy Comes First</h4>
                      <p class="privacy-card-sub">Confidential Student Wellbeing Guarantee · Protected under DPDP Standards</p>
                    </div>
                  </div>

                  <ul class="privacy-commitments-list">
                    <li>
                      <CheckCircle2 size={16} class="check-bullet" />
                      <span>Your reflections belong strictly to your private student account.</span>
                    </li>
                    <li>
                      <CheckCircle2 size={16} class="check-bullet" />
                      <span>Individual responses are not displayed to college, regional, or government staff.</span>
                    </li>
                    <li>
                      <CheckCircle2 size={16} class="check-bullet" />
                      <span>Aggregate reporting uses strict privacy protection thresholds and is never tied to marks or grades.</span>
                    </li>
                  </ul>

                  <div class="privacy-link-bar">
                    <a href="/privacy-policy" target="_blank" rel="noopener noreferrer" class="privacy-policy-link">
                      <span>Read NSWESI Privacy Policy & DPDP Data Governance</span>
                      <ExternalLink size={13} />
                    </a>
                  </div>
                </div>

                <div class="consent-agreement-box mt-5">
                  <label class="consent-label" for="privacy_consent_cb">
                    <input
                      type="checkbox"
                      id="privacy_consent_cb"
                      name="privacy_consent"
                      value="accepted"
                      required
                      class="consent-input-checkbox"
                    />
                    <span class="consent-caption">
                      I have reviewed the <a href="/privacy-policy" target="_blank" rel="noopener noreferrer" class="link-inline">NSWESI Privacy Policy</a> and explicitly consent to the confidential processing of my reflections for personal wellbeing support.
                    </span>
                  </label>
                </div>
              </section>

              {/* SEPARATION DIVIDER BEFORE FINAL CTA */}
              <div class="cta-divider-line" aria-hidden="true"></div>

              {/* ============================================================ */}
              {/* DEDICATED FINAL CTA AREA (Section 7)                         */}
              {/* ============================================================ */}
              <div class="final-cta-container">
                <h3 class="final-cta-title">Ready to join NSWESI?</h3>
                <p class="final-cta-desc">
                  Your account will be created securely using the information provided above.
                </p>

