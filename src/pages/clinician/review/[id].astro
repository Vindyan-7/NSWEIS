---
import ClinicianLayout from '../../../layouts/ClinicianLayout.astro';
import PageHeader from '../../../components/navigation/PageHeader.astro';
import Card from '../../../components/ui/Card.astro';
import Button from '../../../components/ui/Button.astro';
import Badge from '../../../components/ui/Badge.astro';
import Alert from '../../../components/ui/Alert.astro';
import Input from '../../../components/ui/Input.astro';
import Select from '../../../components/ui/Select.astro';
import { createSupabaseServerClient } from '../../../lib/supabase/server';
import { getProfile } from '../../../services/users';
import {
  getQuestionForReview,
  approveQuestion,
  requestQuestionChange,
} from '../../../services/clinician';
import { updateQuestionWithOptions } from '../../../services/question-management';
import type { WellnessCategory } from '../../../types/domain';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

if (!user) {
  return Astro.redirect('/login');
}

const profile = await getProfile(supabase, user.id);

if (!profile || profile.role !== 'clinician') {
  return Astro.redirect('/no-access');
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/clinician/dashboard');

const CATEGORIES: WellnessCategory[] = [
  'academic', 'sleep_rest', 'emotional_wellbeing', 'social_connection', 'family_home',
  'financial', 'career', 'campus_experience', 'physical_wellbeing', 'digital_balance',
];

let message = '';
let isError = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action_type')?.toString();

  if (action === 'approve') {
    const result = await approveQuestion(supabase, id, user.id);
    if (result.success) return Astro.redirect('/clinician/dashboard?tab=review&reviewed=1');
    message = result.error || 'Could not approve this item.';
    isError = true;
  } else if (action === 'request_change') {
    const notes = formData.get('review_notes')?.toString().trim() || '';
    if (!notes) {
      message = 'Add a note describing what needs to change.';
      isError = true;
    } else {
      const result = await requestQuestionChange(supabase, id, notes);
      if (result.success) return Astro.redirect('/clinician/dashboard?tab=review&feedback_sent=1');
      message = result.error || 'Could not send feedback.';
      isError = true;
    }
  } else if (action === 'save_revision') {
    const text = formData.get('question_text')?.toString().trim() || '';
    const category = formData.get('category')?.toString() as WellnessCategory;
    const optionLabels = formData.getAll('option_text[]').map((v) => v.toString().trim());
    const optionCodes = formData.getAll('option_code[]').map((v) => v.toString().trim());
    const optionScores = formData.getAll('option_score[]').map((v) => parseFloat(v.toString()));

    if (!text || !category || optionLabels.some((l) => !l) || optionScores.some((s) => isNaN(s))) {
      message = 'Every field, including each option, is required.';
      isError = true;
    } else {
      const result = await updateQuestionWithOptions(
        supabase,
        id,
        { text, category, review_notes: null },
        optionCodes.map((code, idx) => ({
          option_code: code || `OPT_${idx + 1}`,
          label: optionLabels[idx],
          score: optionScores[idx],
          signal_value: optionScores[idx],
          order_index: idx + 1,
        }))
      );
      if (result.success) return Astro.redirect('/clinician/dashboard?tab=drafts&revised=1');
      message = result.error || 'Could not save your revision.';
      isError = true;
    }
  }
}

const question = await getQuestionForReview(supabase, id);

if (!question) {
  return Astro.redirect('/clinician/dashboard?tab=review');
}

// A clinician may never review their own item — the DB constraint and
// policy back this up, but the UI should never even offer the option.
const isOwnItem = question.authored_by === user.id;
const alreadyReviewed = !!question.clinical_reviewed_at;
const sortedOptions = (question.options || []).slice().sort((a, b) => a.order_index - b.order_index);
---

<ClinicianLayout title="Peer Review" activePath="/clinician/review">
  <PageHeader title={isOwnItem ? 'Your Draft' : 'Peer Review'} subtitle={`W${question.week_number ?? '—'} · ${question.category.replace(/_/g, ' ')}`}>
    <a href="/clinician/dashboard?tab=review">
      <Button variant="outline" size="sm">&larr; Back to Queue</Button>
    </a>
  </PageHeader>

  {message && (
    <Alert type="error" title="Could not complete that action">{message}</Alert>
  )}

  {isOwnItem && alreadyReviewed && (
    <Alert type="info" title="Already reviewed">
      Reviewed by {question.reviewer_name || 'another clinician'} on {new Date(question.clinical_reviewed_at as string).toLocaleDateString()}.
      {question.activated_at ? ' It is now active.' : ' Awaiting regional activation.'}
      {' '}Editing an already-reviewed item isn't available here — that would mean the review no longer covers what's live.
    </Alert>
  )}

  {!isOwnItem && alreadyReviewed && (
    <Alert type="info" title="Already reviewed">
      Reviewed by {question.reviewer_name || 'another clinician'} on {new Date(question.clinical_reviewed_at as string).toLocaleDateString()}.
      {question.activated_at ? ' It is now active.' : ' Awaiting regional activation — no button here, that step belongs to the regional tier.'}
    </Alert>
  )}

  {isOwnItem && !alreadyReviewed ? (
    <Card padding="lg" class="review-card">
      {question.review_notes && (
        <Alert type="warning" title="A reviewer asked for a change">{question.review_notes}</Alert>
      )}

      <form method="POST" class="revise-form">
        <input type="hidden" name="action_type" value="save_revision" />

        <div class="form-grid">
          <Select
            label="Domain (Category)"
            name="category"
            required
            value={question.category}
            options={CATEGORIES.map((c) => ({ value: c, label: c.replace(/_/g, ' ') }))}
          />
        </div>

        <div class="text-field">
          <label class="field-label" for="question_text">Question Text</label>
          <textarea id="question_text" name="question_text" rows="3" required>{question.text}</textarea>
        </div>

        <h3 class="options-heading">Answer Options</h3>
        <div class="options-grid">
          {(sortedOptions.length > 0 ? sortedOptions : [0, 1, 2, 3, 4].map((i) => ({ option_code: 'ABCDE'[i], label: '', score: '' }))).map((opt: any) => (
            <div class="option-row">
              <Input label="Code" name="option_code[]" value={opt.option_code} required />
              <Input label="Label" name="option_text[]" value={opt.label} required />
              <Input label="Score (0–10)" name="option_score[]" type="number" min="0" max="10" step="0.5" value={opt.score} required />
            </div>
          ))}
        </div>

        <div class="form-actions">
          <Button type="submit" variant="primary" size="lg">Save Revision</Button>
        </div>
      </form>
    </Card>
  ) : (
    <Card padding="lg" class="review-card">
      <div class="q-tags">
        <Badge variant="neutral" size="sm">{question.category.replace(/_/g, ' ')}</Badge>
        {question.depth_level && <Badge variant="primary" size="sm">{question.depth_level}</Badge>}
        <span class="q-author">Authored by {question.author_name || 'another clinician'}</span>
      </div>

      <p class="q-text">{question.text}</p>

      <div class="options-list">
        {sortedOptions.map((opt) => (
          <div class="option-item">
            <span class="opt-code">{opt.option_code || opt.id.slice(0, 4)}</span>
            <span class="opt-label">{opt.label}</span>
            <span class="opt-score">score {opt.score}</span>
          </div>
        ))}
      </div>

      {!isOwnItem && !alreadyReviewed && (
        <div class="review-actions">
          <form method="POST" class="approve-form">
            <input type="hidden" name="action_type" value="approve" />
            <Button type="submit" variant="primary" size="lg">Approve</Button>
          </form>

          <form method="POST" class="change-form">
            <input type="hidden" name="action_type" value="request_change" />
            <textarea name="review_notes" rows="3" placeholder="What needs to change before this can be approved?" required></textarea>
            <Button type="submit" variant="outline" size="md">Request Change</Button>
          </form>
        </div>
      )}
    </Card>
  )}
</ClinicianLayout>

<style>
  .review-card {
    margin-top: var(--space-4);
  }

  .q-tags {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .q-author {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .q-text {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: var(--space-5);
    line-height: 1.5;
  }

  .options-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .option-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
  }

  .opt-code {
    font-weight: 700;
    color: var(--color-primary-700);
    width: 2rem;
  }

  .opt-label {
    flex: 1;
    color: var(--color-text-main);
  }

  .opt-score {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-family: monospace;
  }

  .review-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-subtle);
  }

  .change-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .change-form textarea {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    font-family: inherit;
    font-size: 0.9375rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-default);
    resize: vertical;
  }

  .revise-form {
    margin-top: var(--space-4);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .text-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-6);
  }

  .field-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-main);
  }

  .text-field textarea {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    font-size: 1rem;
    font-family: inherit;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-default);
    resize: vertical;
  }

  .options-heading {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: var(--space-4);
  }

  .options-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .option-row {
    display: grid;
    grid-template-columns: 5rem 1fr 10rem;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 640px) {
    .option-row {
      grid-template-columns: 1fr;
    }
  }
</style>
