---
import ClinicianLayout from '../../layouts/ClinicianLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import MetricCard from '../../components/ui/MetricCard.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import { getProfile } from '../../services/users';
import {
  getClinicianQueueCounts,
  getMyDraftQuestions,
  getPendingReviewQuestions,
  getActiveQuestions,
  deleteOrDeactivateQuestion,
} from '../../services/clinician';
import { FilePlus2, ClipboardCheck, Flag, CheckCircle2, ArrowRight, Trash2, Layers, Pencil, ChevronDown, ListChecks } from '@lucide/astro';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

if (!user) {
  return Astro.redirect('/login');
}

const profile = await getProfile(supabase, user.id);

if (!profile || profile.role !== 'clinician') {
  return Astro.redirect('/no-access');
}

let message = '';
let isError = false;

if (Astro.request.method === 'POST') {
  try {
    const contentType = Astro.request.headers.get('content-type') || '';
    if (contentType.includes('multipart/form-data') || contentType.includes('application/x-www-form-urlencoded')) {
      const formData = await Astro.request.formData();
      const actionType = formData.get('action_type')?.toString();

      if (actionType === 'delete_question') {
        const questionId = formData.get('question_id')?.toString() || '';
        if (questionId) {
          const res = await deleteOrDeactivateQuestion(supabase, questionId, user.id);
          if (res.success) {
            message = 'Question deleted successfully.';
          } else {
            message = res.error || 'Failed to delete question.';
            isError = true;
          }
        }
      }
    }
  } catch (err: any) {
    message = err.message || 'An unexpected error occurred.';
    isError = true;
  }
}

const url = new URL(Astro.request.url);
const activeTab = url.searchParams.get('tab') || 'drafts';
const selectedWeek = url.searchParams.get('week') || 'all';
if (!message && url.searchParams.get('updated') === '1') {
  message = 'Question and response options updated successfully.';
}

const counts = await getClinicianQueueCounts(supabase, user.id);

let draftQuestions: Awaited<ReturnType<typeof getMyDraftQuestions>> = [];
let reviewQuestions: Awaited<ReturnType<typeof getPendingReviewQuestions>> = [];
let activeQuestions: Awaited<ReturnType<typeof getActiveQuestions>> = [];

if (activeTab === 'drafts') {
  draftQuestions = await getMyDraftQuestions(supabase, user.id);
} else if (activeTab === 'review') {
  reviewQuestions = await getPendingReviewQuestions(supabase, user.id);
} else if (activeTab === 'active') {
  activeQuestions = await getActiveQuestions(supabase);
}

const categoryLabel = (cat: string) => cat.replace(/_/g, ' ');

// Distinct week numbers for Active Library filtering
const weekNumbers = Array.from(new Set(activeQuestions.map((q) => q.week_number || 1))).sort((a, b) => a - b);

const filteredActiveQuestions = selectedWeek === 'all'
  ? activeQuestions
  : activeQuestions.filter((q) => (q.week_number || 1) === parseInt(selectedWeek, 10));

// Group questions by week for structured week-by-week presentation
const questionsByWeek = new Map<number, typeof activeQuestions>();
filteredActiveQuestions.forEach((q) => {
  const w = q.week_number || 1;
  if (!questionsByWeek.has(w)) questionsByWeek.set(w, []);
  questionsByWeek.get(w)!.push(q);
});

const layoutActivePath = activeTab === 'review' ? '/clinician/review' : '/clinician/dashboard';
---

<ClinicianLayout title="Clinician Dashboard" activePath={layoutActivePath}>
  <PageHeader title="Question Bank" subtitle="Author, review, and maintain the instrument.">
    <a href="/clinician/questions/new">
      <Button variant="primary" size="md">
        <FilePlus2 size={16} aria-hidden="true" /> Author a Question
      </Button>
    </a>
  </PageHeader>

  {message && (
    <Alert type={isError ? 'error' : 'success'} title={isError ? 'Notice' : 'Success'}>
      {message}
    </Alert>
  )}

  <div class="metrics-grid">
    <MetricCard title="My Drafts" value={counts.myDrafts} subtitle="Authored by you, not yet reviewed" />
    <MetricCard title="Awaiting My Review" value={counts.awaitingMyReview} subtitle="Authored by other clinicians" />
    <MetricCard title="Open Flags" value={counts.flagged} subtitle="Raised by college officers" />
    <MetricCard title="Active in Library" value={counts.active} subtitle="Live, assignable to students" />
  </div>

  <div class="tab-bar">
    <a href="?tab=drafts" class={`tab-btn ${activeTab === 'drafts' ? 'active' : ''}`}>My Drafts</a>
    <a href="?tab=review" class={`tab-btn ${activeTab === 'review' ? 'active' : ''}`}>Awaiting My Review</a>
    <a href="/clinician/flags" class="tab-btn">
      Flags {counts.flagged > 0 && <span class="tab-count">{counts.flagged}</span>}
    </a>
    <a href="?tab=active" class={`tab-btn ${activeTab === 'active' ? 'active' : ''}`}>Active Library</a>
  </div>

  {activeTab === 'drafts' && (
    <Card padding="lg">
      {draftQuestions.length === 0 ? (
        <EmptyState title="No drafts in progress" description="Author a question to start it through the review chain." icon={FilePlus2} />
      ) : (
        <div class="q-list">
          {draftQuestions.map((q) => (
            <div class="q-row">
              <div class="q-main">
                <div class="q-tags">
                  <span class="q-code-badge">{q.question_code || (q as any).code || 'Q-DRAFT'}</span>
                  <span class="q-week-badge">Week {q.week_number || 1}</span>
                  <Badge variant="neutral" size="sm">{categoryLabel(q.category)}</Badge>
                  {q.depth_level && <Badge variant="primary" size="sm">{q.depth_level}</Badge>}
                  {q.clinical_reviewed_at ? (
                    <Badge variant="watch" size="sm">Reviewed — awaiting activation</Badge>
                  ) : (
                    <Badge variant="neutral" size="sm">Draft — awaiting peer review</Badge>
                  )}
                </div>
                <p class="q-text">{q.text}</p>
                {q.review_notes && (
                  <p class="q-notes">
                    <strong>Reviewer feedback:</strong> {q.review_notes}
                  </p>
                )}
              </div>
              <div class="q-actions">
                <a href={`/clinician/review/${q.id}`}>
                  <Button variant="outline" size="sm">View <ArrowRight size={14} aria-hidden="true" /></Button>
                </a>
                <form method="POST" class="delete-form" onsubmit="return confirm('Are you sure you want to delete this draft question?');">
                  <input type="hidden" name="action_type" value="delete_question" />
                  <input type="hidden" name="question_id" value={q.id} />
                  <button type="submit" class="btn-delete" title="Delete Draft">
                    <Trash2 size={15} />
                  </button>
                </form>
              </div>
            </div>
          ))}
        </div>
      )}
    </Card>
  )}

  {activeTab === 'review' && (
    <Card padding="lg">
      {reviewQuestions.length === 0 ? (
        <EmptyState title="Nothing waiting on you" description="No other clinician has a draft pending review right now." icon={ClipboardCheck} />
      ) : (
        <div class="q-list">
          {reviewQuestions.map((q) => (
            <div class="q-row">
              <div class="q-main">
                <div class="q-tags">
                  <span class="q-code-badge">{q.question_code || (q as any).code || 'Q-REVIEW'}</span>
                  <span class="q-week-badge">Week {q.week_number || 1}</span>
                  <Badge variant="neutral" size="sm">{categoryLabel(q.category)}</Badge>
                  {q.depth_level && <Badge variant="primary" size="sm">{q.depth_level}</Badge>}
                  <span class="q-author">by {q.author_name || 'another clinician'}</span>
                </div>
                <p class="q-text">{q.text}</p>
              </div>
              <div class="q-actions">
                <a href={`/clinician/review/${q.id}`}>
                  <Button variant="primary" size="sm">Review <ArrowRight size={14} aria-hidden="true" /></Button>
                </a>
              </div>
            </div>
          ))}
        </div>
      )}
    </Card>
  )}

  {activeTab === 'active' && (
    <div class="active-library-container">
      {/* Week Filter Pills Bar */}
      <div class="week-filter-bar glass-panel">
        <div class="week-filter-label">
          <Layers size={16} class="text-primary" />
          <span>Filter by Reflection Cycle:</span>
        </div>
        <div class="week-pills">
          <a
            href="?tab=active&week=all"
            class={`week-pill ${selectedWeek === 'all' ? 'active' : ''}`}
          >
            All Cycles ({activeQuestions.length})
          </a>
          {weekNumbers.map((w) => {
            const count = activeQuestions.filter((q) => (q.week_number || 1) === w).length;
            return (
              <a
                href={`?tab=active&week=${w}`}
                class={`week-pill ${selectedWeek === String(w) ? 'active' : ''}`}
              >
                Week {w} Reflection ({count})
              </a>
            );
          })}
        </div>
      </div>

      {activeQuestions.length === 0 ? (
        <Card padding="lg">
          <EmptyState title="Nothing active yet" description="Activated questions will appear here once the regional tier signs off." icon={CheckCircle2} />
        </Card>
      ) : filteredActiveQuestions.length === 0 ? (
        <Card padding="lg">
          <EmptyState title={`No questions for Week ${selectedWeek}`} description="There are no active questions assigned to this week reflection cycle." icon={CheckCircle2} />
        </Card>
      ) : (
        <div class="week-sections-stack">
          {Array.from(questionsByWeek.entries()).map(([weekNum, questions]) => (
            <Card padding="lg">
              <div class="week-section-header">
                <div class="week-header-title">
                  <span class="week-number-badge">Week {weekNum}</span>
                  <h3 class="week-title-text">Weekly Reflection Cycle — Week {weekNum}</h3>
                </div>
                <span class="week-count-tag">{questions.length} Questions Allotted</span>
              </div>

              <div class="q-list">
                {questions.map((q) => {
                  const opts = (q as any).options || [];
                  return (
                    <div class="q-card-wrapper" id={`q-card-${q.id}`}>
                      <div class="q-row">
                        <div
                          class="q-main q-clickable"
                          data-toggle-target={`q-opts-${q.id}`}
                          role="button"
                          tabindex="0"
                          title="Click to view or hide response options"
                        >
                          <div class="q-tags">
                            <span class="q-code-badge">{q.question_code || (q as any).code || 'Q-ACTIVE'}</span>
                            <span class="q-week-badge">Week {q.week_number || weekNum}</span>
                            <Badge variant="neutral" size="sm">{categoryLabel(q.category)}</Badge>
                            {q.depth_level && <Badge variant="primary" size="sm">{q.depth_level}</Badge>}
                            <Badge variant="stable" size="sm">Active</Badge>
                            <span class="q-options-badge">
                              <ListChecks size={13} />
                              <span>{opts.length} Options</span>
                            </span>
                          </div>
                          <div class="q-text-line">
                            <p class="q-text">{q.text}</p>
                            <button
                              type="button"
                              class="btn-toggle-options"
                              data-target={`q-opts-${q.id}`}
                              aria-expanded="false"
                              title="Toggle response options"
                            >
                              <span class="toggle-label">View Options</span>
                              <ChevronDown size={15} class="chevron-arrow" />
                            </button>
                          </div>
                          <span class="q-meta">Authored by {q.author_name || '—'} · reviewed by {q.reviewer_name || '—'} · activated by {q.activator_name || '—'}</span>
                        </div>
                        <div class="q-actions">
                          <a href={`/clinician/questions/edit/${q.id}`} class="btn-edit" title="Edit Question & Options">
                            <Pencil size={14} />
                            <span>Edit</span>
                          </a>
                          <form method="POST" class="delete-form" onsubmit="return confirm('Are you sure you want to delete this active question from the library?');">
                            <input type="hidden" name="action_type" value="delete_question" />
                            <input type="hidden" name="question_id" value={q.id} />
                            <button type="submit" class="btn-delete" title="Delete Question">
                              <Trash2 size={15} />
                              <span>Delete</span>
                            </button>
                          </form>
                        </div>
                      </div>

                      {/* Expandable Options Review Drawer */}
                      <div class="q-options-drawer hidden" id={`q-opts-${q.id}`}>
                        <div class="drawer-header">
                          <div class="drawer-header-info">
                            <ListChecks size={15} class="text-primary" />
                            <span class="drawer-title">Response Options & Scoring</span>
                            <span class="drawer-count">({opts.length} configured choices)</span>
                          </div>
                          <a href={`/clinician/questions/edit/${q.id}`} class="drawer-edit-btn">
                            <Pencil size={13} />
                            <span>Edit in Full Editor</span>
                          </a>
                        </div>

                        {opts.length === 0 ? (
                          <div class="drawer-empty">
                            <span>No response options configured for this question yet.</span>
                          </div>
                        ) : (
                          <div class="drawer-options-grid">
                            {opts.map((opt: any, optIdx: number) => (
                              <div class="drawer-option-card">
                                <div class="opt-left">
                                  <span class="opt-num-badge">{opt.order_index ?? optIdx + 1}</span>
                                  <span class="opt-code-tag">{opt.option_code || `OPT_${optIdx + 1}`}</span>
                                  <span class="opt-label-text">{opt.label}</span>
                                </div>
                                <div class="opt-right">
                                  <span class="opt-score-badge" title="Clinical assessment score weight">
                                    Score: {opt.score ?? opt.signal_value ?? 0}
                                  </span>
                                </div>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </Card>
          ))}
        </div>
      )}
    </div>
  )}
</ClinicianLayout>

<style>
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .tab-bar {
    display: flex;
    gap: var(--space-2);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: var(--space-5);
    overflow-x: auto;
  }

  .tab-btn {
    padding: var(--space-3) var(--space-4);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-muted);
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tab-btn.active {
    color: var(--color-primary-700);
    border-bottom-color: var(--color-primary-600);
  }

  .tab-count {
    background: var(--color-band-elevated-bg);
    color: var(--color-band-elevated);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    padding: 0.0625rem 0.5rem;
  }

  .active-library-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .week-filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-surface);
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .week-filter-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .week-pills {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .week-pill {
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .week-pill:hover {
    color: var(--color-primary-700);
    border-color: var(--color-primary-300);
  }

  .week-pill.active {
    background-color: var(--color-primary-600);
    color: white;
    border-color: var(--color-primary-600);
  }

  .week-sections-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .week-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border-subtle);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .week-header-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .week-number-badge {
    padding: 0.25rem 0.65rem;
    background-color: var(--color-primary-100);
    color: var(--color-primary-800);
    font-weight: 700;
    font-size: 0.8125rem;
    border-radius: var(--radius-md);
  }

  .week-title-text {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .week-count-tag {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .q-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .q-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-surface);
  }

  .q-main {
    flex: 1;
    min-width: 0;
  }

  .q-tags {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .q-code-badge {
    padding: 0.125rem 0.5rem;
    background: #0f172a;
    color: #f8fafc;
    font-family: monospace;
    font-weight: 700;
    font-size: 0.75rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.025em;
  }

  .q-week-badge {
    padding: 0.125rem 0.5rem;
    background: rgba(99, 102, 241, 0.12);
    color: var(--color-primary-700);
    font-weight: 600;
    font-size: 0.75rem;
    border-radius: var(--radius-sm);
  }

  .q-author {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .q-text {
    font-size: 0.9375rem;
    color: var(--color-text-main);
    font-weight: 500;
    line-height: 1.5;
  }

  .q-notes {
    margin-top: var(--space-2);
    font-size: 0.8125rem;
    color: var(--color-band-attention);
    background: var(--color-band-attention-bg);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
  }

  .q-meta {
    display: block;
    margin-top: var(--space-2);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .q-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .delete-form {
    display: inline-block;
    margin: 0;
  }

  .btn-delete {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #ef4444;
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-delete:hover {
    background-color: #fee2e2;
    border-color: #fca5a5;
    color: #dc2626;
  }

  /* Edit Button */
  .btn-edit {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #4f46e5;
    background-color: #eef2ff;
    border: 1px solid #c7d2fe;
    border-radius: var(--radius-md);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-edit:hover {
    background-color: #e0e7ff;
    border-color: #a5b4fc;
    color: #3730a3;
  }

  /* Card Wrapper & Options Drawer */
  .q-card-wrapper {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    transition: all 0.2s ease;
    overflow: hidden;
  }

  .q-card-wrapper:hover {
    border-color: #cbd5e1;
    box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.05);
  }

  .q-card-wrapper.is-open {
    border-color: #c7d2fe;
    box-shadow: 0 4px 12px -2px rgba(99, 102, 241, 0.08);
  }

  .q-clickable {
    cursor: pointer;
    user-select: none;
  }

  .q-text-line {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-top: 4px;
  }

  .btn-toggle-options {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #4f46e5;
    background: #eef2ff;
    border: 1px solid #c7d2fe;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .btn-toggle-options:hover {
    background: #e0e7ff;
    color: #3730a3;
  }

  .chevron-arrow {
    transition: transform 0.2s ease;
  }

  .chevron-arrow.rotated {
    transform: rotate(180deg);
  }

  .q-options-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #4338ca;
    background: #eef2ff;
    border: 1px solid rgba(99, 102, 241, 0.2);
    padding: 2px 8px;
    border-radius: var(--radius-full, 9999px);
  }

  /* Expandable Options Drawer */
  .q-options-drawer {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    padding: 1rem 1.25rem;
    animation: drawerFadeIn 0.2s ease-out;
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed #e2e8f0;
  }

  .drawer-header-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .drawer-title {
    font-size: 0.8125rem;
