<script>
  function setupOptionToggles() {
    document.querySelectorAll('.q-clickable').forEach((el) => {
      el.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.btn-edit') || target.closest('.btn-delete') || target.closest('form')) {
          return;
        }

        const targetId = el.getAttribute('data-toggle-target');
        if (!targetId) return;

        const drawer = document.getElementById(targetId);
        if (!drawer) return;

        const isHidden = drawer.classList.contains('hidden');
        drawer.classList.toggle('hidden');

        const wrapper = el.closest('.q-card-wrapper');
        const chevron = wrapper?.querySelector('.chevron-arrow');
        const toggleBtn = wrapper?.querySelector('.btn-toggle-options');
        const toggleLabel = wrapper?.querySelector('.toggle-label');

        if (isHidden) {
          chevron?.classList.add('rotated');
          toggleBtn?.setAttribute('aria-expanded', 'true');
          if (toggleLabel) toggleLabel.textContent = 'Hide Options';
          wrapper?.classList.add('is-open');
        } else {
          chevron?.classList.remove('rotated');
          toggleBtn?.setAttribute('aria-expanded', 'false');
          if (toggleLabel) toggleLabel.textContent = 'View Options';
          wrapper?.classList.remove('is-open');
        }
      });
    });
  }

  setupOptionToggles();
  document.addEventListener('astro:page-load', setupOptionToggles);
</script>
