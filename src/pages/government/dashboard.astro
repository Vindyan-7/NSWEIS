---
import GovernmentLayout from '../../layouts/GovernmentLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import MetricCard from '../../components/ui/MetricCard.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import FiveStagePrivacyFlow from '../../components/privacy/FiveStagePrivacyFlow.astro';
import PrivacyNotice from '../../components/privacy/PrivacyNotice.astro';
import { ShieldCheck } from '@lucide/astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import { getProfile } from '../../services/users';
import { getLiveGovernmentDashboardData } from '../../services/analytics';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

if (!user) {
  return Astro.redirect('/login');
}

const profile = await getProfile(supabase, user.id);

if (!profile || (profile.role !== 'government_admin' && profile.role !== 'super_admin')) {
  if (profile?.role === 'student') return Astro.redirect('/student/dashboard');
  if (profile?.role === 'college_officer') return Astro.redirect('/college/dashboard');
  return Astro.redirect('/login');
}

// Server-authoritative scope-authorized multi-college analytics
const dashboardData = await getLiveGovernmentDashboardData(supabase, user.id);
const { cycle, participation, institution_summaries, privacy } = dashboardData;
---

<GovernmentLayout title="Government Wellness Intelligence" activePath="/government/dashboard">
  <PageHeader
    title="Government Wellness Intelligence"
    subtitle={`Statewide anonymous aggregate participation and institutional trends for ${cycle ? cycle.name : 'Weekly Cycle'}`}
  >
    <a href="/admin/institutions">
      <Button variant="outline" size="sm">View Institutional Directory &rarr;</Button>
    </a>
  </PageHeader>

  <div class="gov-dashboard-layout">
    {/* Top Aggregate Metric Cards */}
    <div class="metrics-grid">
      <MetricCard
        title="Authorized Institutions"
        value={participation.total_institutions.toString()}
        change={`${participation.institutions_with_activity} Reporting Active Check-ins`}
        changeType="neutral"
      />
      <MetricCard
        title="Eligible Students"
        value={participation.total_eligible_students.toLocaleString()}
        change="Total Active Student Roster"
        changeType="neutral"
      />
      <MetricCard
        title="Started Check-ins"
        value={participation.started_students.toLocaleString()}
        change="Initiated Weekly Check-ins"
        changeType="neutral"
      />
      <MetricCard
        title="Completed Reflections"
        value={participation.completed_students.toLocaleString()}
        change="Completed Weekly Sessions"
        changeType="neutral"
      />
      <MetricCard
        title="Overall Completion Rate"
        value={`${participation.completion_percentage.toFixed(1)}%`}
        change={participation.is_suppressed ? "Global signals suppressed (<10 completed)" : "Statewide Reflection Rate"}
        changeType={participation.is_suppressed ? "neutral" : "positive"}
      />
    </div>

    {/* Comparative Benchmarking Table */}
    <Card padding="lg">
      <div class="section-header">
        <div>
          <h3 class="card-section-title">Institutional Participation Comparison</h3>
          <p class="section-subtext">Anonymous aggregate completion rates per institution, sorted by completion percentage. Student privacy threshold (&ge; 10 completed check-ins) enforced.</p>
        </div>
        <a href="/admin/insights" class="header-link">Detailed Analytics &rarr;</a>
      </div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Institution</th>
              <th>Code</th>
              <th>State</th>
              <th>Eligible Students</th>
              <th>Started</th>
              <th>Completed</th>
              <th>Completion Rate</th>
              <th>Privacy Status</th>
              <th>Interventions</th>
            </tr>
          </thead>
          <tbody>
            {institution_summaries.map((inst) => (
              <tr>
                <td class="font-medium">{inst.institution_name}</td>
                <td><span class="code-badge">{inst.institution_code}</span></td>
                <td>{inst.state}</td>
                <td>{inst.eligible_students.toLocaleString()}</td>
                <td>{inst.started_students.toLocaleString()}</td>
                <td>{inst.completed_students.toLocaleString()}</td>
                <td class="font-semibold">{inst.completion_percentage.toFixed(1)}%</td>
                <td>
                  {inst.is_suppressed ? (
                    <Badge variant="neutral" size="sm">Suppressed (&lt;10)</Badge>
                  ) : (
                    <Badge variant="stable" size="sm">Reporting (&ge;10)</Badge>
                  )}
                </td>
                <td>{inst.active_interventions_count} Active</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>

    {/* Section 4: Government Privacy & Governance Panel */}
    <Card padding="lg">
      <div class="section-header">
        <div>
          <h3 class="card-section-title">NSWEIS Data Governance Status</h3>
          <p class="section-subtext">Architectural privacy boundaries enforced across all authorized institutions.</p>
        </div>
        <Badge variant="stable" size="md">&bull; GOVERNANCE PROTECTED</Badge>
      </div>

      <div class="gov-privacy-grid">
        <div class="gov-privacy-box">
          <span class="box-label">Access Scope</span>
          <span class="box-val text-primary font-semibold">Authorised Institutions Only</span>
        </div>
        <div class="gov-privacy-box">
          <span class="box-label">Student-Level Data</span>
          <span class="box-val text-danger font-semibold">&cross; BLOCKED</span>
        </div>
        <div class="gov-privacy-box">
          <span class="box-label">Private Reflections</span>
          <span class="box-val text-danger font-semibold">&cross; BLOCKED</span>
        </div>
        <div class="gov-privacy-box">
          <span class="box-label">Aggregate Institutional Data</span>
          <span class="box-val text-success font-semibold">&check; ALLOWED</span>
        </div>
        <div class="gov-privacy-box">
          <span class="box-label">Privacy Threshold</span>
          <span class="box-val font-semibold">10 Completed Check-ins</span>
        </div>
        <div class="gov-privacy-box">
          <span class="box-label">Institution Scope & RLS</span>
          <span class="box-val text-success font-semibold">&check; SERVER ACTIVE</span>
        </div>
      </div>
    </Card>

    {/* Section 5: Five-Stage Privacy Data Flow */}
    <FiveStagePrivacyFlow />

    {/* Section 6: Privacy & Data Protection Notice */}
    <Card padding="lg" class="privacy-card">
      <div class="privacy-content">
        <div class="privacy-icon">
          <ShieldCheck size={24} class="text-primary" />
        </div>
        <div class="privacy-text">
          <h4 class="privacy-title">Statewide Privacy & Data Protection Guarantee</h4>
          <p class="privacy-body">{privacy.notice}</p>
        </div>
      </div>
    </Card>

    <PrivacyNotice variant="full" />
  </div>
</GovernmentLayout>

<style>
  .gov-dashboard-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-4);
    gap: var(--space-4);
  }

  .card-section-title {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .section-subtext {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .header-link {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .header-link:hover {
    text-decoration: underline;
  }

  .table-wrapper {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .data-table th {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    font-size: var(--font-size-xs);
    letter-spacing: 0.05em;
  }

  .code-badge {
    background-color: var(--color-bg-secondary);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-family: monospace;
    font-size: var(--font-size-xs);
    color: var(--color-text-main);
  }

  .font-medium {
    font-weight: 500;
  }

  .font-semibold {
    font-weight: 600;
  }

  .privacy-card {
    background-color: var(--color-bg-secondary);
    border-left: 4px solid var(--color-primary);
  }

  .privacy-content {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .privacy-title {
    font-size: var(--font-size-md);
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: var(--space-1);
  }

  .privacy-body {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  .gov-privacy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .gov-privacy-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .box-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .box-val {
    font-size: var(--font-size-sm);
  }
</style>
