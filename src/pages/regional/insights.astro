---
import RegionalLayout from '../../layouts/RegionalLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import MetricCard from '../../components/ui/MetricCard.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import ChartCard from '../../components/analytics/ChartCard.astro';
import PrivacyNotice from '../../components/privacy/PrivacyNotice.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import { getProfile } from '../../services/users';
import {
  getGovernmentParticipationMetrics,
  getGovernmentCategorySummaries,
  getGovernmentInstitutionSummaries,
  getGovernmentTrends,
} from '../../services/analytics';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

if (!user) {
  return Astro.redirect('/login');
}

const profile = await getProfile(supabase, user.id);

if (!profile || (profile.role !== 'regional_officer' && profile.role !== 'government_admin' && profile.role !== 'super_admin')) {
  return Astro.redirect('/no-access');
}

const metrics = await getGovernmentParticipationMetrics(supabase, user.id);
const categorySummaries = await getGovernmentCategorySummaries(supabase, user.id);
const institutionSummaries = await getGovernmentInstitutionSummaries(supabase, user.id);
const trends = await getGovernmentTrends(supabase, user.id);

const isDataSuppressed = metrics.is_suppressed || categorySummaries.every((cs) => cs.is_suppressed);
---

<RegionalLayout title="Regional Aggregate Insights" activePath="/regional/insights">
  <PageHeader
    title="Regional Well-being & Participation Insights"
    subtitle={`Aggregated well-being trends and comparative indicators across regional institutions for ${metrics.active_cycle_name}`}
  >
    <a href="/regional/dashboard">
      <Button variant="outline" size="sm">&larr; Back to Dashboard</Button>
    </a>
  </PageHeader>

  <div class="regional-insights-layout">
    <div class="metrics-grid">
      <MetricCard
        title="Regional Scope"
        value={`${metrics.authorized_institutions_count} Institutions`}
        change={isDataSuppressed ? "Reporting Active Data: Suppressed (<10)" : `${metrics.active_reporting_institutions_count} Actively Reporting`}
        changeType="neutral"
      />
      <MetricCard
        title="Participating Population"
        value={isDataSuppressed ? "Insufficient data" : metrics.participating_students.toLocaleString()}
        change={isDataSuppressed ? "Privacy threshold: ≥10 students required" : `${metrics.participation_rate.toFixed(1)}% Regional Participation`}
        changeType="neutral"
      />
      <MetricCard
        title="Privacy Protection"
        value="≥ 10 Students"
        change="Threshold Enforced Server-side"
        changeType="positive"
      />
    </div>

    <div class="insights-section-grid">
      {/* Category Indicators Bar Breakdown */}
      <ChartCard
        title="Regional Category Indicators"
        subtitle="Aggregate average indicator scores (0.0 to 10.0) across regional scope"
      >
        <div class="category-bars">
          {categorySummaries.map((cs) => (
            <div class="bar-row">
              <span class="bar-label">{cs.category.replace('_', ' ')}</span>
              <div class="bar-track">
                {cs.is_suppressed ? (
                  <div class="bar-suppressed">Suppressed (&lt;10 students)</div>
                ) : (
                  <div
                    class={`bar-fill band-${cs.dominant_band}`}
                    style={`width: ${((cs.average_score || 0) * 10)}%`}
                  >
                    <span class="bar-val">{cs.average_score?.toFixed(1)}</span>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </ChartCard>

      {/* Institutional Comparison Table */}
      <Card padding="lg">
        <h3 class="card-section-title">Regional Institutions Status</h3>
        <p class="section-subtext">Comparative status for campuses in your assigned regional jurisdiction.</p>

        <div class="inst-comp-list">
          {institutionSummaries.map((inst) => (
            <div class="inst-comp-item">
              <div class="inst-comp-top">
                <span class="inst-comp-name">{inst.institution_name} ({inst.institution_code})</span>
                {inst.is_suppressed ? (
                  <Badge variant="neutral" size="sm">Suppressed (&lt;10)</Badge>
                ) : (
                  <Badge variant={inst.dominant_band || 'neutral'} size="sm">
                    {inst.dominant_band?.replace('_', ' ')}
                  </Badge>
                )}
              </div>

              {inst.is_suppressed ? (
                <p class="suppressed-note">Insufficient group size for anonymous reporting.</p>
              ) : (
                <div class="inst-comp-meta">
                  <span>Completed: <strong>{inst.completed_students}</strong></span>
                  <span>Rate: <strong>{inst.participation_rate.toFixed(1)}%</strong></span>
                  <span>Avg: <strong>{inst.average_overall_score?.toFixed(1) || 'N/A'}</strong>/10</span>
                </div>
              )}
            </div>
          ))}
          {institutionSummaries.length === 0 && (
            <p class="text-sm text-muted">No institutions registered in this region yet.</p>
          )}
        </div>
      </Card>
    </div>

    {/* Longitudinal Trends Section */}
    <Card padding="lg">
      <h3 class="card-section-title">Participation & Trend Trajectory</h3>
      <p class="section-subtext">Historical comparison of check-in completions and overall index.</p>

      {trends.length === 0 ? (
        <p class="text-sm text-muted">No historical cycle data available yet for trend analysis.</p>
      ) : (
        <div class="trends-table-wrap">
          <table class="trends-table">
            <thead>
              <tr>
                <th>Cycle Name</th>
                <th>Check-in Window</th>
                <th>Participating Students</th>
                <th>Participation Rate</th>
                <th>Avg Wellbeing Score</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {trends.map((t) => (
                <tr>
                  <td class="font-medium">{t.cycle_name}</td>
                  <td>{new Date(t.start_date).toLocaleDateString()} - {new Date(t.end_date).toLocaleDateString()}</td>
                  <td>{t.participating_students.toLocaleString()}</td>
                  <td>{t.participation_rate.toFixed(1)}%</td>
                  <td>
                    {t.average_score !== null ? (
                      <strong>{t.average_score.toFixed(1)} / 10</strong>
                    ) : (
                      <span class="text-muted">Suppressed</span>
                    )}
                  </td>
                  <td>
                    <Badge variant={t.is_active ? 'stable' : 'neutral'} size="sm">
                      {t.is_active ? 'Active' : 'Closed'}
                    </Badge>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </Card>

    <PrivacyNotice variant="full" />
  </div>
</RegionalLayout>

<style>
  .regional-insights-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .insights-section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: var(--space-6);
  }

  .card-section-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .section-subtext {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .category-bars {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .bar-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .bar-label {
    width: 140px;
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: capitalize;
    color: var(--color-text-main);
    flex-shrink: 0;
  }

  .bar-track {
    flex: 1;
    height: 24px;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
    position: relative;
  }

  .bar-fill {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: var(--space-2);
    border-radius: var(--radius-sm);
    transition: width 0.3s ease;
  }

  .bar-val {
    font-size: 0.75rem;
    font-weight: 700;
    color: white;
  }

  .bar-fill.band-stable { background-color: var(--color-success); }
  .bar-fill.band-watch { background-color: #3b82f6; }
  .bar-fill.band-needs_attention { background-color: var(--color-warning); }
  .bar-fill.band-elevated { background-color: var(--color-danger); }

  .bar-suppressed {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
    background-color: var(--color-bg-subtle);
  }

  .inst-comp-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .inst-comp-item {
    padding: var(--space-3);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-surface);
  }

  .inst-comp-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .inst-comp-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .suppressed-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .inst-comp-meta {
    display: flex;
    gap: var(--space-4);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .trends-table-wrap {
    overflow-x: auto;
  }

  .trends-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .trends-table th,
  .trends-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .trends-table th {
    font-weight: 600;
    color: var(--color-text-muted);
    background-color: var(--color-bg-subtle);
  }

  .font-medium {
    font-weight: 600;
    color: var(--color-text-main);
  }
</style>
