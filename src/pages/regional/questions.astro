    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-surface);
    transition: all 0.15s ease;
  }

  .active-q-card:hover {
    border-color: var(--color-border-strong);
  }

  .active-q-main {
    flex: 1;
    min-width: 0;
  }

  .active-q-tags {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .active-q-text {
    font-size: 0.9375rem;
    color: var(--color-text-main);
    font-weight: 500;
    line-height: 1.5;
  }

  .active-q-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .active-q-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .btn-delete {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #ef4444;
