    color: #047857;
    border: 1px solid #a7f3d0;
    font-weight: 600;
    font-size: 0.75rem;
    border-radius: var(--radius-sm);
  }

  .question-body {
    margin-bottom: var(--space-4);
  }

  .question-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-main);
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }

  .options-container {
    margin-bottom: var(--space-3);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
