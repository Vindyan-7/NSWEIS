---
import RegionalLayout from '../../layouts/RegionalLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import Alert from '../../components/ui/Alert.astro';
import Badge from '../../components/ui/Badge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { Stethoscope, Plus, UserCheck, Shield, Power } from '@lucide/astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import { getProfile } from '../../services/users';
import {
  provisionStaffAccount,
  getManagedStaffAccounts,
  toggleStaffAccountStatus,
} from '../../services/provisioning';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

if (!user) {
  return Astro.redirect('/login');
}

const profile = await getProfile(supabase, user.id);

if (!profile || (profile.role !== 'regional_officer' && profile.role !== 'government_admin' && profile.role !== 'super_admin')) {
  return Astro.redirect('/no-access');
}

let message = '';
let isError = false;

if (Astro.request.method === 'POST') {
  try {
    const contentType = Astro.request.headers.get('content-type') || '';
    if (contentType.includes('multipart/form-data') || contentType.includes('application/x-www-form-urlencoded')) {
      const formData = await Astro.request.formData();
      const actionType = formData.get('action_type')?.toString();

      if (actionType === 'toggle_status') {
        const targetUserId = formData.get('target_user_id')?.toString() || '';
        const newStatus = formData.get('new_status')?.toString() === 'true';

        const res = await toggleStaffAccountStatus(supabase, user.id, targetUserId, newStatus);
        if (!res.success) {
          message = res.error || 'Failed to update account status.';
          isError = true;
        } else {
          message = `Clinician status updated to ${newStatus ? 'Active' : 'Deactivated'}.`;
        }
      } else {
        const fullName = formData.get('full_name')?.toString().trim() || '';
        const email = formData.get('email')?.toString().trim() || '';
        const password = formData.get('password')?.toString() || '';
        const confirmPassword = formData.get('confirm_password')?.toString() || '';

        const res = await provisionStaffAccount(supabase, user.id, {
          fullName,
          email,
          password,
          confirmPassword,
          targetRole: 'clinician',
        });

        if (!res.success) {
          message = res.error || 'Failed to provision Clinician.';
          isError = true;
        } else {
          message = `Clinician account for '${fullName}' (${email}) provisioned successfully. Account is immediately active.`;
        }
      }
    }
  } catch (err: any) {
    message = err.message || 'An unexpected error occurred.';
    isError = true;
  }
}

const allStaff = await getManagedStaffAccounts(supabase, user.id);
const clinicians = allStaff.filter((s) => s.role === 'clinician');
---

<RegionalLayout title="Regional Clinical Team" activePath="/regional/clinicians">
  <PageHeader
    title="Regional Clinical Team Management"
    subtitle="Provision and manage psychological & clinical experts who author and peer-review reflection items for your region"
  >
    <a href="/regional/dashboard">
      <Button variant="outline" size="sm">&larr; Back to Dashboard</Button>
    </a>
  </PageHeader>

  <div class="regional-clinicians-layout">
    {message && (
      <Alert type={isError ? 'error' : 'success'} title={isError ? 'Notice' : 'Success'}>
        {message}
      </Alert>
    )}

    <div class="grid-layout">
      {/* 1. Create Clinician Form */}
      <Card padding="lg">
        <div class="card-header-row">
          <Stethoscope size={20} class="text-primary" />
          <h3 class="card-title">Provision New Clinician / Counsellor</h3>
        </div>
        <p class="section-subtext">
          Create credentials for a clinician. Clinicians author questions and perform peer review within your regional jurisdiction.
        </p>

        <form method="POST" class="form-stack">
          <Input
            label="Clinician Full Name"
            name="full_name"
            placeholder="Dr. Kavita Rao, MD (Psychiatry)"
            required
          />

          <Input
            label="Official Email Address"
            type="email"
            name="email"
            placeholder="dr.kavita@nsweis.gov.in"
            required
          />

          <div class="form-row-2">
            <Input
              label="Password (min 8 chars)"
              type="password"
              name="password"
              placeholder="••••••••"
              required
            />
            <Input
              label="Confirm Password"
              type="password"
              name="confirm_password"
              placeholder="••••••••"
              required
            />
          </div>

          <Button type="submit" variant="primary" class="btn-submit">
            <Plus size={15} /> Provision Clinician Account
          </Button>
        </form>
      </Card>

      {/* 2. Clinicians Directory */}
      <Card padding="lg">
        <div class="card-header-row">
          <UserCheck size={20} class="text-primary" />
          <h3 class="card-title">Regional Clinical Team ({clinicians.length})</h3>
        </div>
        <p class="section-subtext">
          Active clinicians authorized to author questions and review draft items in your region.
        </p>

        {clinicians.length === 0 ? (
          <EmptyState
            title="No Clinicians Provisioned"
            description="Use the form on the left to provision clinicians for this region."
          />
        ) : (
          <div class="table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Clinician</th>
                  <th>Role</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {clinicians.map((c) => (
                  <tr>
                    <td>
                      <div class="user-info">
                        <strong>{c.full_name}</strong>
                        <span class="user-sub">{c.id.slice(0, 8)}...</span>
                      </div>
                    </td>
                    <td>
                      <Badge variant="primary" size="sm">Clinician</Badge>
                    </td>
                    <td>
                      <Badge variant={c.active ? 'stable' : 'neutral'} size="sm">
                        {c.active ? 'Active' : 'Inactive'}
                      </Badge>
                    </td>
                    <td class="date-cell">
                      {new Date(c.created_at).toLocaleDateString()}
                    </td>
                    <td>
                      <form method="POST" class="inline-form">
                        <input type="hidden" name="action_type" value="toggle_status" />
                        <input type="hidden" name="target_user_id" value={c.id} />
                        <input type="hidden" name="new_status" value={c.active ? 'false' : 'true'} />
                        <Button
                          type="submit"
                          variant={c.active ? 'outline' : 'primary'}
                          size="sm"
                        >
                          <Power size={13} /> {c.active ? 'Deactivate' : 'Activate'}
                        </Button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </Card>
    </div>
  </div>
</RegionalLayout>

<style>
  .regional-clinicians-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .grid-layout {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-6);
  }

  .card-header-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .section-subtext {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .form-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .btn-submit {
    margin-top: var(--space-2);
    width: 100%;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .data-table th {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-subtle);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-main);
  }

  .user-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .user-sub {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .date-cell {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .inline-form {
    display: inline-block;
  }

  @media (max-width: 1024px) {
    .grid-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
