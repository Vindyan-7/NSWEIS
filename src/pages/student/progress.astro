---
import StudentLayout from '../../layouts/StudentLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import PrivacyNotice from '../../components/privacy/PrivacyNotice.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import { getStudentJourney } from '../../services/student-journey';
import {
  TrendingUp,
  CalendarCheck,
  ListChecks,
  Coins,
  CheckCircle2,
  Sparkles,
  ArrowRight,
  Clock3,
} from '@lucide/astro';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

if (!user) {
  return Astro.redirect('/login');
}

const journey = await getStudentJourney(supabase, user.id);
---

<StudentLayout title="Your Well-being Journey" activePath="/student/progress">
  <PageHeader
    title="Your Well-being Journey"
    subtitle="Track your weekly reflections, activity completion, and personal consistency over time."
  >
    <a href="/student/tasks">
      <Button variant="outline" size="sm">
        <ListChecks size={16} aria-hidden="true" /> View Active Tasks
      </Button>
    </a>
  </PageHeader>

  <div class="progress-page-layout">
    {/* Participation Continuity Card */}
    <Card padding="lg" class="continuity-card">
      <div class="continuity-flex">
        <div class="continuity-icon">
          <Sparkles size={24} aria-hidden="true" />
        </div>
        <div>
          <h3 class="continuity-title">{journey.participationStreakText}</h3>
          <p class="continuity-text">
            {journey.participationChangeText}
          </p>
        </div>
      </div>
    </Card>

    {/* Metrics Summary Grid */}
    <div class="metrics-grid">
      <Card padding="md">
        <div class="metric-item">
          <div class="icon-box primary">
            <Clock3 size={20} aria-hidden="true" />
          </div>
          <div>
            <span class="label">Current Reflection</span>
            <span class="value font-sm">
              {journey.reflectionStatus === 'completed' && <Badge variant="stable" size="sm">Completed</Badge>}
              {journey.reflectionStatus === 'in_progress' && <Badge variant="primary" size="sm">In Progress</Badge>}
              {journey.reflectionStatus === 'not_started' && <Badge variant="neutral" size="sm">Pending</Badge>}
            </span>
          </div>
        </div>
      </Card>

      <Card padding="md">
        <div class="metric-item">
          <div class="icon-box primary">
            <TrendingUp size={20} aria-hidden="true" />
          </div>
          <div>
            <span class="label">Task Completion Rate</span>
            <span class="value">{journey.taskCompletionPercentage}%</span>
          </div>
        </div>
      </Card>

      <Card padding="md">
        <div class="metric-item">
          <div class="icon-box success">
            <CheckCircle2 size={20} aria-hidden="true" />
          </div>
          <div>
            <span class="label">Activities Completed</span>
            <span class="value">{journey.completedTasksCount}</span>
          </div>
        </div>
      </Card>

      <Card padding="md">
        <div class="metric-item">
          <div class="icon-box accent">
            <Coins size={20} aria-hidden="true" />
          </div>
          <div>
            <span class="label">Total Credits Earned</span>
            <span class="value">+{journey.totalCreditsEarned}</span>
          </div>
        </div>
      </Card>
    </div>

    {/* Current Weekly Focus Card */}
    {journey.currentFocusTitle && (
      <Card padding="lg" class="focus-card">
        <div class="focus-header">
          <span class="focus-badge">Your Focus For This Week</span>
          <h3 class="focus-title">{journey.currentFocusTitle}</h3>
          {journey.currentFocusDescription && (
            <p class="focus-description">{journey.currentFocusDescription}</p>
          )}
        </div>
        <div class="focus-actions">
          <a href="/student/tasks">
            <Button variant="primary" size="sm">
              View Focus in My Tasks <ArrowRight size={14} aria-hidden="true" />
            </Button>
          </a>
        </div>
      </Card>
    )}

    {/* Weekly Participation History Table */}
    <Card padding="lg">
      <h3 class="card-title">Weekly Reflection & Activity History</h3>
      <p class="card-subtitle">Chronological record of your completed weekly check-ins and reflection actions.</p>

      {journey.weeklyHistory.length > 0 && journey.weeklyHistory.some((w) => w.checkInCompleted || w.completedTasksCount > 0) ? (
        <div class="table-wrapper">
          <table class="participation-table">
            <thead>
              <tr>
                <th>Cycle Week</th>
                <th>Weekly Reflection</th>
                <th>Activities Completed</th>
                <th>Credits Earned</th>
                <th>Weekly Focus</th>
              </tr>
            </thead>
            <tbody>
              {journey.weeklyHistory.map((week) => (
                <tr>
                  <td class="font-medium">Week {week.weekNumber}</td>
                  <td>
                    {week.checkInCompleted ? (
                      <Badge variant="stable" size="sm">
                        <CheckCircle2 size={12} aria-hidden="true" /> Completed
                      </Badge>
                    ) : (
                      <Badge variant="neutral" size="sm">Pending</Badge>
                    )}
                  </td>
                  <td>{week.completedTasksCount} activities</td>
                  <td>
                    <span class="credit-highlight">+{week.creditsEarned} Credits</span>
                  </td>
                  <td class="text-subtle font-sm">
                    {week.focusTitle || 'Self-Reflection'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <EmptyState
          title="No Progress History Yet"
          description="Complete your first weekly reflection to start building your well-being journey."
          icon={CalendarCheck}
        />
      )}
    </Card>

    <PrivacyNotice variant="full" />
  </div>
</StudentLayout>

<style>
  .progress-page-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .continuity-card {
    background-color: var(--color-primary-50);
    border-left: 4px solid var(--color-primary-500);
  }

  .continuity-flex {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .continuity-icon {
    color: var(--color-primary-600);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .continuity-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary-900);
    margin-bottom: 0.25rem;
  }

  .continuity-text {
    font-size: 0.875rem;
    color: var(--color-primary-800);
    line-height: 1.5;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .metric-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .icon-box {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-box.primary {
    background-color: var(--color-primary-100);
    color: var(--color-primary-700);
  }

  .icon-box.success {
    background-color: #d1fae5;
    color: #047857;
  }

  .icon-box.watch {
    background-color: #e0f2fe;
    color: #0369a1;
  }

  .icon-box.accent {
    background-color: #fef3c7;
    color: #b45309;
  }

  .label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .value {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .font-sm {
    font-size: 0.875rem;
  }

  .focus-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-primary-200);
  }

  .focus-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-700);
    text-transform: uppercase;
    letter-spacing: 0.05em;

  }

  .focus-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: var(--space-1);
    margin-bottom: var(--space-2);
  }

  .focus-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .focus-actions {
    margin-top: var(--space-4);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .card-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .table-wrapper {
    overflow-x: auto;
  }

  .participation-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .participation-table th,
  .participation-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .participation-table th {
    background-color: var(--color-bg-subtle);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .font-medium {
    font-weight: 600;
    color: var(--color-text-main);
  }

  .text-subtle {
    color: var(--color-text-muted);
  }

  .credit-highlight {
    font-weight: 700;
    color: #047857;
  }
</style>
