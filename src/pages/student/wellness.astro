---
import StudentLayout from '../../layouts/StudentLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import WellnessSnapshot from '../../components/wellness/WellnessSnapshot.astro';
import CategoryIndicator from '../../components/wellness/CategoryIndicator.astro';
import PrivacyNotice from '../../components/privacy/PrivacyNotice.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import { calculateTrend } from '../../lib/scoring/engine';
import {
  getLatestCompletedAssessment,
  getStudentAssessmentHistory,
} from '../../services/assessments';
import { getRecommendationsForAssessment } from '../../services/recommendations';
import { BookOpen, HeartHandshake, ArrowRight, Sparkles } from '@lucide/astro';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

const latestData = user ? await getLatestCompletedAssessment(supabase, user.id) : null;
const history = user ? await getStudentAssessmentHistory(supabase, user.id) : [];

const previousAssessment = history.length > 1 ? history[1] : null;

const trend = calculateTrend(
  latestData?.assessment.overall_indicator || 7.5,
  previousAssessment?.overall_indicator
);

let recommendations: any[] = [];
if (latestData?.assessment?.id) {
  recommendations = await getRecommendationsForAssessment(supabase, latestData.assessment.id);
}
---

<StudentLayout title="Wellness Summary" activePath="/student/wellness">
  <PageHeader
    title="Wellness Summary & Focus Actions"
    subtitle="Personalized self-reflection results and supportive well-being focus steps"
  />

  {!latestData ? (
    <Card padding="lg">
      <EmptyState
        title="No completed check-ins found"
        description="Complete your weekly check-in to view your wellness summary and personalized focus steps."
      >
        <a href="/student/check-in">
          <Button variant="primary">Start Weekly Reflection</Button>
        </a>
      </EmptyState>
    </Card>
  ) : (
    <div class="wellness-summary-layout">
      {/* Wellness Snapshot */}
      <WellnessSnapshot
        score={latestData.assessment.overall_indicator || 7.5}
        band={latestData.assessment.overall_band || 'stable'}
        lastCheckInDate={new Date(latestData.assessment.completed_at || '').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        totalCheckIns={history.length}
      />

      {/* What Changed Section */}
      <Card padding="lg">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <h3 class="card-section-title" style="margin-bottom: 0;">What Changed</h3>
          <Badge variant={trend === 'improving' ? 'improving' : trend === 'declining' ? 'declining' : 'neutral'}>
            Trend: {trend.replace('_', ' ')}
          </Badge>
        </div>
        {previousAssessment ? (
          <p class="comparison-text">
            Compared with your previous check-in on {new Date(previousAssessment.completed_at || '').toLocaleDateString()}, your overall indicator shifted from <strong>{previousAssessment.overall_indicator}</strong> to <strong>{latestData.assessment.overall_indicator}</strong> ({trend}).
          </p>
        ) : (
          <p class="comparison-text">
            This is your first completed reflection. Future check-ins will track your progress over time.
          </p>
        )}
      </Card>

      {/* Category Breakdown */}
      <div class="category-breakdown-section">
        <h3 class="card-section-title">Category Breakdown</h3>
        <div class="category-grid">
          {latestData.scores.map((cs) => (
            <CategoryIndicator
              category={cs.category}
              score={cs.score}
              band={cs.band}
            />
          ))}
        </div>
      </div>

      {/* Personalized Well-being Focus Recommendations */}
      <Card padding="lg" class="recommendations-card">
        <div class="rec-section-header">
          <Sparkles size={20} class="text-primary" aria-hidden="true" />
          <h3 class="card-section-title" style="margin-bottom: 0;">Your Focus for This Week</h3>
        </div>
        <p class="section-subtext">Supportive, practical focus steps based on your latest reflection.</p>
        
        <div class="recommendations-list">
          {recommendations.length > 0 ? (
            recommendations.map((rec) => (
              <div class="recommendation-item">
                <div class="rec-header">
                  <span class="rec-cat">{rec.category.replace('_', ' ')}</span>
                  <span class="rec-added-tag">Added to your weekly tasks</span>
                </div>
                <h4 class="rec-title">{rec.title}</h4>
                <p class="rec-desc">{rec.description}</p>
                
                <div class="rec-action-row">
                  <a href="/student/tasks" class="view-task-link">
                    View in My Tasks <ArrowRight size={14} aria-hidden="true" />
                  </a>
                </div>
              </div>
            ))
          ) : (
            <div class="empty-rec-box">
              <p class="empty-rec">Your indicators look steady! Continue maintaining your regular study and sleep routines.</p>
            </div>
          )}
        </div>
      </Card>

      {/* Institutional Support Pathways */}
      <Card padding="lg" class="support-card">
        <h3 class="card-section-title">Institutional Student Support Pathways</h3>
        <p class="section-subtext">Access voluntary student welfare resources provided by your campus.</p>
        <div class="support-grid">
          <div class="support-item">
            <div class="support-item-header">
              <BookOpen size={18} class="support-icon" aria-hidden="true" />
              <h5>Academic Mentorship</h5>
            </div>
            <p>Peer tutoring, academic advising, and exam preparation assistance.</p>
          </div>
          <div class="support-item">
            <div class="support-item-header">
              <HeartHandshake size={18} class="support-icon" aria-hidden="true" />
              <h5>Student Welfare Office</h5>
            </div>
            <p>Campus life advisory, residence guidance, and student activity support.</p>
          </div>
        </div>
      </Card>

      <PrivacyNotice variant="full" />
    </div>
  )}
</StudentLayout>

<style>
  .wellness-summary-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .card-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: var(--space-2);
  }

  .section-subtext {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .comparison-text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .rec-section-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .recommendations-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .recommendation-item {
    background-color: var(--color-bg-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary-600);
  }

  .rec-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-1);
  }

  .rec-cat {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-700);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .rec-added-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-success-700);
    background-color: #d1fae5;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .rec-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: var(--space-1);
  }

  .rec-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .rec-action-row {
    display: flex;
    justify-content: flex-end;
  }

  .view-task-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary-600);
    text-decoration: none;
  }

  .view-task-link:hover {
    text-decoration: underline;
  }

  .empty-rec-box {
    background-color: var(--color-bg-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-md);
  }

  .empty-rec {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .support-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .support-item {
    background-color: var(--color-bg-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
  }

  .support-item-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .support-icon {
    color: var(--color-primary-600);
  }

  .support-item h5 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin: 0;
  }

  .support-item p {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
</style>
