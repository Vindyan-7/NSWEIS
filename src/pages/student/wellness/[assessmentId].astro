---
import StudentLayout from '../../../layouts/StudentLayout.astro';
import PageHeader from '../../../components/navigation/PageHeader.astro';
import Card from '../../../components/ui/Card.astro';
import Button from '../../../components/ui/Button.astro';
import Badge from '../../../components/ui/Badge.astro';
import WellnessSnapshot from '../../../components/wellness/WellnessSnapshot.astro';
import CategoryIndicator from '../../../components/wellness/CategoryIndicator.astro';
import PrivacyNotice from '../../../components/privacy/PrivacyNotice.astro';
import { createSupabaseServerClient } from '../../../lib/supabase/server';
import { getAssessmentDetails } from '../../../services/assessments';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);
const { assessmentId } = Astro.params;

if (!user || !assessmentId) {
  return Astro.redirect('/student/wellness');
}

// Server-side authorization check: getAssessmentDetails verifies student_id = user.id
const details = await getAssessmentDetails(supabase, assessmentId, user.id);

if (!details) {
  return Astro.redirect('/student/wellness');
}

const { assessment, scores, recommendations } = details;
---

<StudentLayout title="Historical Check-in Result" activePath="/student/history">
  <PageHeader
    title={`Historical Check-in: ${assessment.cycle?.name || 'Reflection'}`}
    subtitle={`Completed on ${new Date(assessment.completed_at || '').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`}
  >
    <a href="/student/history">
      <Button variant="outline" size="sm">&larr; Back to History</Button>
    </a>
  </PageHeader>

  <div class="wellness-summary-layout">
    {/* Wellness Snapshot */}
    <WellnessSnapshot
      score={assessment.overall_indicator || 7.5}
      band={assessment.overall_band || 'stable'}
      lastCheckInDate={new Date(assessment.completed_at || '').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
    />

    {/* Category Breakdown */}
    <div class="category-breakdown-section">
      <h3 class="card-section-title">Category Breakdown</h3>
      <div class="category-grid">
        {scores.map((cs) => (
          <CategoryIndicator
            category={cs.category}
            score={cs.score}
            band={cs.band}
          />
        ))}
      </div>
    </div>

    {/* Recommendations */}
    <Card padding="lg" class="recommendations-card">
      <h3 class="card-section-title">Recommendations for this Session</h3>
      <div class="recommendations-list">
        {recommendations.length > 0 ? (
          recommendations.map((rec) => (
            <div class="recommendation-item">
              <div class="rec-header">
                <span class="rec-cat">{rec.category.replace('_', ' ')}</span>
                <Badge variant="primary" size="sm">Priority {rec.priority}</Badge>
              </div>
              <h4 class="rec-title">{rec.title}</h4>
              <p class="rec-desc">{rec.description}</p>
            </div>
          ))
        ) : (
          <p class="empty-rec">Indicators were stable for this reflection period.</p>
        )}
      </div>
    </Card>

    <PrivacyNotice variant="full" />
  </div>
</StudentLayout>

<style>
  .wellness-summary-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .card-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: var(--space-2);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .recommendations-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .recommendation-item {
    background-color: var(--color-bg-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary-600);
  }

  .rec-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-1);
  }

  .rec-cat {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary-700);
    text-transform: uppercase;
  }

  .rec-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: var(--space-1);
  }

  .rec-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
