---
import StudentLayout from '../../layouts/StudentLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import WellnessSnapshot from '../../components/wellness/WellnessSnapshot.astro';
import WellnessTrend from '../../components/wellness/WellnessTrend.astro';
import CategoryIndicator from '../../components/wellness/CategoryIndicator.astro';
import PrivacyNotice from '../../components/privacy/PrivacyNotice.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import {
  getActiveAssessmentCycle,
  getStudentAssessmentForCycle,
  getLatestCompletedAssessment,
  getStudentAssessmentHistory,
} from '../../services/assessments';
import {
  getActiveStudentTasks,
  getCompletedStudentTasks,
  getStudentCreditBalance,
} from '../../services/student-tasks';
import { getStudentRecommendations } from '../../services/recommendations';
import { ListChecks, Coins, CheckCircle2, ArrowRight, Sparkles } from '@lucide/astro';

import { createPrivacyRequest } from '../../services/privacy';

const user = Astro.locals.user;
const profile = Astro.locals.profile;

const supabase = createSupabaseServerClient(Astro);

let supportMessage = '';
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action_type')?.toString();
    if (action === 'contact_counsellor' && user) {
      const notes = formData.get('support_notes')?.toString().trim() || 'Student requested campus counsellor support contact.';
      await createPrivacyRequest(supabase, user.id, 'grievance', notes);
      supportMessage = 'Your request has been received by your College Officer to coordinate confidential human support.';
    }
  } catch (err: any) {
    console.error('[STUDENT DASHBOARD] Support request error:', err);
  }
}

// Load DB data
const activeCycle = await getActiveAssessmentCycle(supabase);
const currentAssessment = activeCycle && user ? await getStudentAssessmentForCycle(supabase, user.id, activeCycle.id) : null;
const latestData = user ? await getLatestCompletedAssessment(supabase, user.id) : null;
const history = user ? await getStudentAssessmentHistory(supabase, user.id) : [];

// Task & Credits summary for Your Week widget
const activeTasksList = user ? await getActiveStudentTasks(supabase, user.id) : [];
const completedTasksList = user ? await getCompletedStudentTasks(supabase, user.id) : [];
const credits = user ? await getStudentCreditBalance(supabase, user.id) : { currentBalance: 0, thisWeekEarned: 0, totalEarned: 0 };
const userRecs = user ? await getStudentRecommendations(supabase, user.id) : [];
const topRecommendation = userRecs.length > 0 ? userRecs[0] : null;

const sessionDurationMins = (activeCycle as any)?.session_duration_minutes || 10;
const isCurrentAssessmentExpired = currentAssessment?.status === 'in_progress' &&
  currentAssessment.started_at &&
  (Date.now() - new Date(currentAssessment.started_at).getTime()) >= sessionDurationMins * 60 * 1000;

const checkInStatus = (!currentAssessment || isCurrentAssessmentExpired)
  ? 'not_started'
  : currentAssessment.status;

const trendPoints = history.slice(0, 4).reverse().map((h, idx) => ({
  week: `Week ${idx + 1}`,
  completed: h.status === 'completed',
}));
---

<StudentLayout title="Student Dashboard" activePath="/student/dashboard">
  <PageHeader
    title={`Good morning, ${profile?.full_name || 'Alex'}`}
    subtitle="Your personal, non-clinical wellness check-in dashboard."
  />

  <div class="dashboard-grid">
    {/* Weekly Check-in Status Card */}
    <Card padding="lg" class="checkin-status-card glass-panel">
      <div class="card-status-header">
        <span class="status-cycle-tag">{activeCycle ? activeCycle.name : 'Weekly Reflection Cycle'}</span>
        {checkInStatus === 'completed' && <Badge variant="stable">Completed</Badge>}
        {checkInStatus === 'in_progress' && <Badge variant="improving">In Progress</Badge>}
        {checkInStatus === 'not_started' && <Badge variant="neutral">Ready</Badge>}
      </div>

      <div class="status-content">
        {checkInStatus === 'not_started' && (
          <>
            <h3 class="status-title">Your weekly check-in is ready</h3>
            <p class="status-desc">Take 3 minutes to reflect on your week. Your individual responses are private and confidential.</p>
            <a href="/student/check-in" class="status-cta">
              <Button variant="primary" size="lg">Start Check-in &rarr;</Button>
            </a>
          </>
        )}

        {checkInStatus === 'in_progress' && (
          <>
            <h3 class="status-title">Continue your weekly check-in</h3>
            <p class="status-desc">You have an active check-in in progress. Complete your self-reflection to update your wellness snapshot.</p>
            <a href="/student/check-in" class="status-cta">
              <Button variant="primary" size="lg">Continue Check-in &rarr;</Button>
            </a>
          </>
        )}

        {checkInStatus === 'completed' && (
          <>
            <h3 class="status-title">Your check-in is complete for this cycle</h3>
            <p class="status-desc">Thank you for taking time to reflect. You can review your wellness summary and personalized recommendations anytime.</p>
            <div class="status-actions">
              <a href="/student/progress">
                <Button variant="secondary" size="md">View Reflection History &rarr;</Button>
              </a>
            </div>
          </>
        )}
      </div>
    </Card>

    {/* Contact College Counsellor Card */}
    <Card padding="md" class="counsellor-card p-4 bg-primary-50 border border-primary-200 rounded-xl">
      <div class="flex justify-between items-center gap-4 flex-wrap">
        <div>
          <h4 class="font-bold text-primary-900 text-sm">Need to speak with someone on campus?</h4>
          <p class="text-xs text-primary-700 mt-0.5">
            Contact your College Officer to coordinate confidential human support. Your private check-in answers remain confidential.
          </p>
        </div>
        <form method="POST">
          <input type="hidden" name="action_type" value="contact_counsellor" />
          <Button type="submit" variant="primary" size="sm">Contact Counsellor</Button>
        </form>
      </div>
      {supportMessage && (
        <p class="text-xs text-success font-semibold mt-2 pt-2 border-t border-primary-200">
          ✓ {supportMessage}
        </p>
      )}
    </Card>

    {/* Your Week Activity & Progress Widget */}
    <Card padding="lg">
      <div class="your-week-header">
        <div>
          <h3 class="widget-title">This Week</h3>
          <p class="widget-sub">Active tasks, completion progress, and well-being credits.</p>
        </div>
        <div class="widget-actions">
          <a href="/student/progress">
            <Button variant="outline" size="sm">
              View Journey Progress <ArrowRight size={14} aria-hidden="true" />
            </Button>
          </a>
        </div>
      </div>

      <div class="your-week-stats">
        <div class="week-stat-item">
          <span class="stat-icon primary"><ListChecks size={18} aria-hidden="true" /></span>
          <div>
            <span class="week-stat-val">{activeTasksList.length}</span>
            <span class="week-stat-lbl">Active Tasks</span>
          </div>
        </div>

        <div class="week-stat-item">
          <span class="stat-icon success"><CheckCircle2 size={18} aria-hidden="true" /></span>
          <div>
            <span class="week-stat-val">{completedTasksList.length}</span>
            <span class="week-stat-lbl">Completed</span>
          </div>
        </div>

        <div class="week-stat-item">
          <span class="stat-icon accent"><Coins size={18} aria-hidden="true" /></span>
          <div>
            <span class="week-stat-val">+{credits.currentBalance}</span>
            <span class="week-stat-lbl">Credits Balance</span>
          </div>
        </div>
      </div>

      {topRecommendation && (
        <div class="highlighted-rec-box">
          <div class="highlighted-rec-header">
            <Sparkles size={14} class="highlighted-rec-icon" aria-hidden="true" />
            <span class="highlighted-rec-tag">Highlighted Focus Action</span>
          </div>
          <p class="highlighted-rec-title">{topRecommendation.title}</p>
          <p class="highlighted-rec-desc">{topRecommendation.description}</p>
        </div>
      )}
    </Card>

    {/* Personal Wellness Snapshot */}
    {latestData ? (
      <WellnessSnapshot
        lastCheckInDate={new Date(latestData.assessment.completed_at || '').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
        totalCheckIns={history.length}
      />
    ) : (
      <Card padding="lg">
        <EmptyState
          title="No completed check-ins yet"
          description="Complete your first weekly check-in to generate your personal wellness snapshot."
        >
          <a href="/student/check-in">
            <Button variant="primary">Start First Check-in</Button>
          </a>
        </EmptyState>
      </Card>
    )}

    {/* Category Breakdown */}
    {latestData && latestData.scores.length > 0 && (
      <div class="category-grid-section">
        <h3 class="section-heading">Reflection Focus Areas</h3>
        <div class="category-grid">
          {latestData.scores.map((cs) => (
            <CategoryIndicator
              category={cs.category}
            />
          ))}
        </div>
      </div>
    )}

    {/* Reflection Consistency */}
    {trendPoints.length > 0 ? (
      <WellnessTrend points={trendPoints} title="Your Reflection Consistency" />
    ) : null}

    {/* Privacy Guarantee Notice */}
    <PrivacyNotice variant="full" />
  </div>
</StudentLayout>

<style>
  .dashboard-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .checkin-status-card {
    background: linear-gradient(135deg, #ffffff 0%, var(--color-primary-50) 100%);
  }

  .card-status-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .status-cycle-tag {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary-700);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: var(--space-2);
  }

  .status-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin-bottom: var(--space-5);
  }

  .status-cta {
    display: inline-block;
  }

  .section-heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: var(--space-3);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .your-week-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .widget-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .widget-sub {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .your-week-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-3);
  }

  .week-stat-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background-color: var(--color-bg-subtle);
    padding: var(--space-3);
    border-radius: var(--radius-md);
  }

  .stat-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-icon.primary {
    background-color: var(--color-primary-100);
    color: var(--color-primary-700);
  }

  .stat-icon.success {
    background-color: #d1fae5;
    color: #047857;
  }

  .stat-icon.accent {
    background-color: #fef3c7;
    color: #b45309;
  }

  .week-stat-val {
    display: block;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .week-stat-lbl {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .highlighted-rec-box {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-primary-50);
    border: 1px solid var(--color-primary-200);
    border-radius: var(--radius-md);
  }

  .highlighted-rec-header {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-1);
  }

  .highlighted-rec-icon {
    color: var(--color-primary-600);
  }

  .highlighted-rec-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-primary-800);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .highlighted-rec-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: var(--space-1);
  }

  .highlighted-rec-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 767px) {
    .status-title {
      font-size: 1.25rem;
    }

    .status-desc {
      font-size: 0.875rem;
      margin-bottom: var(--space-4);
    }

    .status-cta, .status-cta button, .status-cta a {
      width: 100%;
      min-height: 52px;
      display: block;
    }

    .your-week-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .widget-actions, .widget-actions a, .widget-actions button {
      width: 100%;
      min-height: 48px;
    }

    .your-week-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }

    .category-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .your-week-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
