---
import StudentLayout from '../../layouts/StudentLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Alert from '../../components/ui/Alert.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import PrivacyNotice from '../../components/privacy/PrivacyNotice.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import {
  getActiveStudentTasks,
  getCompletedStudentTasks,
  getStudentCreditBalance,
  getStudentProgress,
  completeStudentTask,
} from '../../services/student-tasks';
import {
  ListChecks,
  CheckCircle2,
  Clock3,
  Coins,
  Sparkles,
  CircleCheck,
} from '@lucide/astro';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

if (!user) {
  return Astro.redirect('/login');
}

let errorMessage = '';
let successMessage = '';

// Handle Task Completion POST
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString();
    const taskId = formData.get('task_id')?.toString();

    if (action === 'complete_task' && taskId) {
      const res = await completeStudentTask(supabase, taskId, user.id);
      if (!res.success) {
        errorMessage = res.error || 'Unable to complete this activity right now. Please try again.';
      } else if (res.alreadyCompleted) {
        successMessage = 'Activity was already completed.';
      } else {
        successMessage = `Activity completed! +${res.creditsAwarded || 10} well-being credits earned.`;
      }
    }
  } catch (err: any) {
    errorMessage = 'Unable to complete this activity right now. Please try again.';
  }
}

const activeTasks = await getActiveStudentTasks(supabase, user.id);
const completedTasks = await getCompletedStudentTasks(supabase, user.id);
const creditBalance = await getStudentCreditBalance(supabase, user.id);
const progressSummary = await getStudentProgress(supabase, user.id);
---

<StudentLayout title="My Tasks" activePath="/student/tasks">
  <PageHeader
    title="My Well-being Tasks"
    subtitle="Small actions that can help you build healthier routines this week."
  >
    <a href="/student/check-in">
      <Button variant="primary" size="sm">
        <CheckCircle2 size={16} aria-hidden="true" /> Weekly Check-in
      </Button>
    </a>
  </PageHeader>

  <div class="tasks-page-layout">
    {errorMessage && (
      <Alert type="error" title="Action Failed">
        {errorMessage}
      </Alert>
    )}

    {successMessage && (
      <Alert type="success" title="Success">
        {successMessage}
      </Alert>
    )}

    {/* Current Week Summary & Credits Banner */}
    <div class="summary-grid">
      <Card padding="md">
        <div class="summary-metric">
          <div class="metric-icon-wrap primary">
            <ListChecks size={20} aria-hidden="true" />
          </div>
          <div>
            <span class="metric-label">Active Tasks</span>
            <span class="metric-value">{progressSummary.activeTasks}</span>
          </div>
        </div>
      </Card>

      <Card padding="md">
        <div class="summary-metric">
          <div class="metric-icon-wrap success">
            <CircleCheck size={20} aria-hidden="true" />
          </div>
          <div>
            <span class="metric-label">Completed Tasks</span>
            <span class="metric-value">{progressSummary.completedTasks}</span>
          </div>
        </div>
      </Card>

      <Card padding="md">
        <div class="summary-metric">
          <div class="metric-icon-wrap accent">
            <Coins size={20} aria-hidden="true" />
          </div>
          <div>
            <span class="metric-label">This Week's Credits</span>
            <span class="metric-value">+{creditBalance.thisWeekEarned}</span>
          </div>
        </div>
      </Card>

      <Card padding="md">
        <div class="summary-metric">
          <div class="metric-icon-wrap info">
            <Sparkles size={20} aria-hidden="true" />
          </div>
          <div>
            <span class="metric-label">Task Progress</span>
            <span class="metric-value">{progressSummary.completionPercentage}%</span>
          </div>
        </div>
      </Card>
    </div>

    {/* Well-being Credits Ledger Card */}
    <Card padding="lg">
      <div class="credits-card-header">
        <div>
          <h3 class="section-title">Well-being Credits</h3>
          <p class="section-subtitle">Earn credits by completing recommended reflection activities.</p>
        </div>
        <Badge variant="primary" size="md">
          <Coins size={14} aria-hidden="true" /> {creditBalance.currentBalance} Total Balance
        </Badge>
      </div>

      <div class="credits-stats-row">
        <div class="credit-stat-box">
          <span class="stat-num">{creditBalance.currentBalance}</span>
          <span class="stat-text">Current Balance</span>
        </div>
        <div class="credit-stat-box">
          <span class="stat-num">+{creditBalance.thisWeekEarned}</span>
          <span class="stat-text">Earned This Week</span>
        </div>
        <div class="credit-stat-box">
          <span class="stat-num">+{creditBalance.totalEarned}</span>
          <span class="stat-text">Total Earned</span>
        </div>
      </div>

      {creditBalance.totalEarned === 0 && (
        <p class="credit-empty-hint">
          Complete your first well-being activity to start building your progress.
        </p>
      )}
    </Card>

    {/* Active Tasks Section */}
    <div class="section-container">
      <div class="section-header-flex">
        <h3 class="section-title">Active Activities ({activeTasks.length})</h3>
        <span class="section-hint">Tasks assigned based on your weekly reflections.</span>
      </div>

      {activeTasks.length > 0 ? (
        <div class="tasks-grid">
          {activeTasks.map((task) => (
            <Card padding="lg" class="task-card">
              <div class="task-card-header">
                <Badge variant="neutral" size="sm">
                  {task.category.replace('_', ' ')}
                </Badge>
                <span class="credit-pill">
                  <Coins size={12} aria-hidden="true" /> +{task.credits_awarded} Credits
                </span>
              </div>

              <h4 class="task-title">{task.title}</h4>
              <p class="task-description">{task.description}</p>

              <div class="task-meta-row">
                <span class="meta-item">
                  <Clock3 size={14} aria-hidden="true" /> {task.estimated_minutes} mins
                </span>
                <span class="meta-item">
                  {task.status === 'in_progress' ? (
                    <Badge variant="watch" size="sm">In Progress</Badge>
                  ) : (
                    <Badge variant="neutral" size="sm">Pending</Badge>
                  )}
                </span>
              </div>

              <div class="task-card-footer">
                <form method="POST">
                  <input type="hidden" name="action" value="complete_task" />
                  <input type="hidden" name="task_id" value={task.id} />
                  <Button
                    variant="primary"
                    size="sm"
                    type="submit"
                    disabled={task.status === 'expired'}
                  >
                    <CheckCircle2 size={14} aria-hidden="true" /> Complete Activity
                  </Button>
                </form>
              </div>
            </Card>
          ))}
        </div>
      ) : (
        <EmptyState
          title="No Active Activities"
          description="Your next set of activities will appear after your weekly reflection."
          icon={ListChecks}
        />
      )}
    </div>

    {/* Completed Tasks Section */}
    <div class="section-container">
      <h3 class="section-title">Completed History ({completedTasks.length})</h3>

      {completedTasks.length > 0 ? (
        <Card padding="none">
          <div class="table-wrapper">
            <table class="history-table">
              <thead>
                <tr>
                  <th>Activity</th>
                  <th>Category</th>
                  <th>Completed Date</th>
                  <th>Credits</th>
                </tr>
              </thead>
              <tbody>
                {completedTasks.map((task) => (
                  <tr>
                    <td class="font-medium">{task.title}</td>
                    <td>
                      <Badge variant="neutral" size="sm">
                        {task.category.replace('_', ' ')}
                      </Badge>
                    </td>
                    <td class="text-muted">
                      {task.completed_at
                        ? new Date(task.completed_at).toLocaleDateString(undefined, {
                            month: 'short',
                            day: 'numeric',
                            year: 'numeric',
                          })
                        : 'Completed'}
                    </td>
                    <td>
                      <span class="credit-text">+{task.credits_awarded} Credits</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      ) : (
        <EmptyState
          title="No Completed Activities Yet"
          description="Completed activities will appear here."
          icon={CircleCheck}
        />
      )}
    </div>

    <PrivacyNotice variant="full" />
  </div>
</StudentLayout>

<style>
  .tasks-page-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .summary-metric {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .metric-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .metric-icon-wrap.primary {
    background-color: var(--color-primary-100);
    color: var(--color-primary-700);
  }

  .metric-icon-wrap.success {
    background-color: #d1fae5;
    color: #047857;
  }

  .metric-icon-wrap.accent {
    background-color: #fef3c7;
    color: #b45309;
  }

  .metric-icon-wrap.info {
    background-color: #e0f2fe;
    color: #0369a1;
  }

  .metric-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .metric-value {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .credits-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .section-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .section-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.125rem;
  }

  .credits-stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .credit-stat-box {
    background-color: var(--color-bg-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .stat-num {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary-600);
  }

  .stat-text {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .credit-empty-hint {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: var(--space-4);
  }

  .section-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }

  .section-hint {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .tasks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .task-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .credit-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #b45309;
    background-color: #fef3c7;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .task-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: var(--space-1);
  }

  .task-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin-bottom: var(--space-4);
  }

  .task-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-subtle);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .task-card-footer {
    display: flex;
    justify-content: flex-end;
  }

  .table-wrapper {
    overflow-x: auto;
  }

  .history-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .history-table th,
  .history-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .history-table th {
    background-color: var(--color-bg-subtle);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .font-medium {
    font-weight: 600;
    color: var(--color-text-main);
  }

  .text-muted {
    color: var(--color-text-muted);
  }

  .credit-text {
    font-weight: 700;
    color: #047857;
  }
</style>
