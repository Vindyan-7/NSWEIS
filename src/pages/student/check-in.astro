---
import StudentLayout from '../../layouts/StudentLayout.astro';
import PageHeader from '../../components/navigation/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import PrivacyNotice from '../../components/privacy/PrivacyNotice.astro';
import NonClinicalDisclaimer from '../../components/privacy/NonClinicalDisclaimer.astro';
import QuestionCard from '../../components/assessment/QuestionCard.astro';
import ReflectionBox from '../../components/assessment/ReflectionBox.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import {
  getStudentAssessmentForCycle,
  getBaseQuestions,
  saveAssessmentResponses,
  submitAssessmentResponsesAndScore,
} from '../../services/assessments';
import { getActiveWeeklyCycle } from '../../services/weekly-cycles';
import {
  generateStudentQuestionAssignment,
  getStudentQuestionAssignments,
} from '../../services/adaptive-question-selection';
import { generateRecommendationsForAssessment } from '../../services/recommendations';
import type { Question } from '../../types/domain';
import { Clock3, CheckCircle2, ShieldCheck, FileText, Timer } from '@lucide/astro';

const user = Astro.locals.user;
const profile = Astro.locals.profile;
const supabase = createSupabaseServerClient(Astro);

if (!user) {
  return Astro.redirect('/login');
}

if (profile && profile.role !== 'student' && profile.role !== 'super_admin') {
  return Astro.redirect('/student/dashboard');
}

// Server-side TEST MODE configuration flag (Only read on server; never exposed to browser)
const isTestMode = ((import.meta.env as any).NSWEIS_TEST_MODE ?? 'true') !== 'false';

let errorMessage = '';

// 1. Resolve Active Weekly Cycle
const activeCycle = await getActiveWeeklyCycle(supabase);

if (!activeCycle) {
  errorMessage = 'Your next weekly reflection is not available yet. Please check back soon.';
}

// 2. Resolve Student Department Code
let studentDeptCode = 'ALL';
if (profile?.department_id) {
  const { data: dept } = await (supabase.from('departments') as any)
    .select('code')
    .eq('id', profile.department_id)
    .single();
  if (dept) studentDeptCode = (dept as any).code;
}

// 3. Fetch Existing Assessment for Active Cycle (Does NOT auto-create on page open)
let assessment = (activeCycle && user)
  ? await getStudentAssessmentForCycle(supabase, user.id, activeCycle.id)
  : null;

// 4. Handle POST Form Actions (Start Assessment / Answer Submissions)
if (Astro.request.method === 'POST' && activeCycle && user) {
  try {
    const formData = await Astro.request.formData();
    const actionType = formData.get('action_type')?.toString();

    // A. Start Assessment Action (Establishes server-authoritative started_at & assignments)
    if (actionType === 'start_assessment') {
      console.log(`[CHECKIN START] authenticated user resolution: ${user.id}`);
      console.log(`[CHECKIN START] active cycle lookup: ${activeCycle.id}`);

      // Profile verification check to guarantee foreign key constraint assessments_student_id_fkey is satisfied
      const { data: profileCheck, error: profErr } = await (supabase.from('profiles') as any)
        .select('id')
        .eq('id', user.id)
        .single();

      console.log(`[CHECKIN START] profile verification: ${profileCheck ? 'EXISTS' : 'MISSING'}`);
      if (profErr && profErr.code !== 'PGRST116') {
        console.error('[CHECKIN START] profile verification error:', {
          code: profErr.code,
          message: profErr.message,
          details: profErr.details,
          hint: profErr.hint,
        });
      }

      if (!profileCheck) {
        console.log(`[CHECKIN START] auto-provisioning missing profile for user: ${user.id}`);
        const email = user.email || '';
        const inferredRole = email.includes('super')
          ? 'super_admin'
          : email.includes('admin')
          ? 'government_admin'
          : email.includes('college')
          ? 'college_officer'
          : 'student';

        const { error: profInsertErr } = await (supabase.from('profiles') as any).upsert({
          id: user.id,
          full_name: (user as any).user_metadata?.full_name || email.split('@')[0] || 'Student',
          role: inferredRole,
          institution_id: '11111111-1111-1111-1111-111111111111',
          active: true,
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString(),
        });

        if (profInsertErr) {
          console.error('[CHECKIN START] profile auto-provision error:', {
            code: profInsertErr.code,
            message: profInsertErr.message,
            details: profInsertErr.details,
            hint: profInsertErr.hint,
          });
        }
      }

      if (!assessment) {
        console.log(`[CHECKIN START] assessment creation initiating for user: ${user.id}, cycle: ${activeCycle.id}`);
        const { data: newAssessment, error: createError } = await (supabase.from('assessments') as any)
          .insert({
            student_id: user.id,
            cycle_id: activeCycle.id,
            status: 'in_progress',
            started_at: new Date().toISOString(),
          })
          .select()
          .single();

        if (createError || !newAssessment) {
          console.error('[CHECKIN START] assessment creation failed:', {
            user_id: user.id,
            cycle_id: activeCycle.id,
            code: createError?.code,
            message: createError?.message,
            details: createError?.details,
            hint: createError?.hint,
          });
          errorMessage = 'Could not start your weekly reflection session. Please try again.';
        } else {
          assessment = newAssessment as any;
          console.log(`[CHECKIN START] assessment created successfully: ${(newAssessment as any).id}`);
          console.log(`[CHECKIN START] assignment generation initiating`);

          const genRes = await generateStudentQuestionAssignment(supabase, user.id, activeCycle.id, studentDeptCode);
          if (!genRes.success) {
            console.error('[CHECKIN START] assignment generation error:', {
              user_id: user.id,
              cycle_id: activeCycle.id,
              error: genRes.error,
            });
          } else {
            console.log(`[CHECKIN START] assignment generation completed: ${genRes.assignments.length} assignments generated`);
          }
        }
      }
    } else if (assessment) {
      // B. Answer Submission / Completion Action
      if (assessment.status === 'completed') {
        return Astro.redirect('/student/wellness');
      }

      // Fetch questions currently assigned to this student for submission processing
      let currentAssigns = await getStudentQuestionAssignments(supabase, user.id, activeCycle.id);
      let submitDisplayQuestions = currentAssigns.map((a) => a.question).filter(Boolean);
      if (submitDisplayQuestions.length === 0) {
        submitDisplayQuestions = await getBaseQuestions(supabase, activeCycle.week_number, studentDeptCode);
      }

      // Calculate server-authoritative session timer
      const sessionDurationMins = activeCycle?.session_duration_minutes || 10;
      const REQUIRED_SESSION_SECONDS = sessionDurationMins * 60;
      const startedAtMs = assessment.started_at ? new Date(assessment.started_at).getTime() : Date.now();
      const nowMs = Date.now();
      const elapsedSeconds = Math.max(0, Math.floor((nowMs - startedAtMs) / 1000));
      const isTimerCompleteOnServer = elapsedSeconds >= REQUIRED_SESSION_SECONDS;

      const isTestSubmitAttempt = isTestMode && actionType === 'test_submit';
      const canPassTimeGate = isTimerCompleteOnServer || isTestSubmitAttempt;

      const rawResponses: Array<{
        questionId: string;
        category: any;
        selectedOptionId?: string;
        score: number;
        weight: number;
        textResponse?: string;
      }> = [];

      let missingRequired = false;

      for (const q of submitDisplayQuestions) {
        const val = formData.get(`q_${q.id}`)?.toString();
        if (q.required !== false && !val) {
          missingRequired = true;
        }

        if (val && q.options) {
          const opt = q.options.find((o) => o.id === val);
          if (opt) {
            rawResponses.push({
              questionId: q.id,
              category: q.category,
              selectedOptionId: val,
              score: Number(opt.score),
              weight: Number(q.weight || 1.0),
            });
          }
        }
      }

      const reflectionText = (formData.get('reflection_text') as string || '').trim();
      if (reflectionText && rawResponses.length > 0) {
        rawResponses[0].textResponse = reflectionText;
      }

      // Persist available responses immediately to database
      if (rawResponses.length > 0) {
        await saveAssessmentResponses(
          supabase,
          assessment.id,
          rawResponses.map((r) => ({
            questionId: r.questionId,
            selectedOptionId: r.selectedOptionId,
            textResponse: r.textResponse,
          }))
        );
      }

      if (!canPassTimeGate) {
        errorMessage = 'Your reflection session is still in progress. Please continue for a little longer.';
      } else if (missingRequired) {
        errorMessage = 'Please answer all required reflection questions before completing your session.';
      } else if (activeCycle?.reflection_required && !reflectionText && submitDisplayQuestions.length > 0) {
        errorMessage = 'Please share a brief personal reflection before completing your weekly session.';
      } else {
        const submitResult = await submitAssessmentResponsesAndScore(
          supabase,
          assessment.id,
          rawResponses
        );

        if (submitResult.success) {
          const answeredQIds = rawResponses.map((r) => r.questionId);
          if (answeredQIds.length > 0 && activeCycle) {
            await (supabase.from('student_question_assignments') as any)
              .update({ answered: true, answered_at: new Date().toISOString() })
              .eq('student_id', user.id)
              .eq('cycle_id', activeCycle.id)
              .in('question_id', answeredQIds);
          }

          try {
            await generateRecommendationsForAssessment(supabase, user.id, assessment.id);
          } catch (recErr) {
            // Log safely without rolling back assessment completion
          }

          assessment.status = 'completed';
        } else {
          errorMessage = 'Your reflection could not be submitted right now. Please review your responses and try again.';
        }
      }
    }
  } catch (err: any) {
    errorMessage = 'We couldn\'t continue your reflection session right now. Please try again.';
  }
}

// 5. Load Display Questions & Saved Responses if Session Active
let displayQuestions: Question[] = [];
const existingResponseMap = new Map<string, string>();
let existingReflectionText = '';

if (activeCycle && assessment && assessment.status !== 'completed') {
  let currentAssignments = await getStudentQuestionAssignments(supabase, user.id, activeCycle.id);

  if (currentAssignments.length === 0) {
    const genRes = await generateStudentQuestionAssignment(supabase, user.id, activeCycle.id, studentDeptCode);
    if (genRes.success) {
      currentAssignments = await getStudentQuestionAssignments(supabase, user.id, activeCycle.id);
    }
  }

  if (currentAssignments.length > 0) {
    displayQuestions = currentAssignments.map((a) => a.question).filter(Boolean);
  } else {
    displayQuestions = await getBaseQuestions(supabase, activeCycle.week_number, studentDeptCode);
  }

  // Load existing saved responses from database
  const { data: respData } = await (supabase.from('assessment_responses') as any)
    .select('question_id, selected_option_id, text_response')
    .eq('assessment_id', assessment.id);

  if (respData) {
    for (const r of respData as any[]) {
      if (r.selected_option_id) existingResponseMap.set(r.question_id, r.selected_option_id);
      if (r.text_response && !existingReflectionText) existingReflectionText = r.text_response;
    }
  }
}

// 6. Calculate Session Duration & Remaining Time
const sessionDurationMins = activeCycle?.session_duration_minutes || 10;
const REQUIRED_SESSION_SECONDS = sessionDurationMins * 60;
const startedAtMs = assessment?.started_at ? new Date(assessment.started_at).getTime() : Date.now();
const nowMs = Date.now();
const elapsedSeconds = Math.max(0, Math.floor((nowMs - startedAtMs) / 1000));
const remainingSeconds = Math.max(0, REQUIRED_SESSION_SECONDS - elapsedSeconds);
const isTimerCompleteOnServer = elapsedSeconds >= REQUIRED_SESSION_SECONDS;
---

<StudentLayout title="Weekly Check-in" activePath="/student/check-in">
  <PageHeader
    title="Weekly Well-being Reflection"
    subtitle="Confidential self-reflection check-in"
  />

  <div class="checkin-page-layout">
    {errorMessage && (
      <Alert type="error" title="Session Notice">
        {errorMessage}
      </Alert>
    )}

    {!activeCycle ? (
      <Card padding="lg">
        <div class="empty-cycle-box">
          <Clock3 size={32} class="text-muted" aria-hidden="true" />
          <h3>Your next weekly reflection is not available yet</h3>
          <p>There are no active weekly check-in cycles open currently. Please check back soon.</p>
        </div>
      </Card>
    ) : assessment?.status === 'completed' ? (
      <Card padding="lg" class="completed-session-card">
        <div class="completed-session-box">
          <div class="completed-icon-wrap">
            <CheckCircle2 size={36} aria-hidden="true" />
          </div>
          <h3 class="completed-title">Week 1 Reflection Complete</h3>
          <p class="completed-text">
            Thank you for taking time to complete your weekly reflection for {activeCycle.name}. Your responses have been securely stored.
          </p>
          <div class="completed-actions">
            <a href="/student/wellness">
              <Button variant="primary" size="md">
                View Wellness Results &rarr;
              </Button>
            </a>
            <a href="/student/tasks">
              <Button variant="secondary" size="md">
                View Your Activities &rarr;
              </Button>
            </a>
            <a href="/student/progress">
              <Button variant="outline" size="md">
                View Journey Progress &rarr;
              </Button>
            </a>
          </div>
        </div>
      </Card>
    ) : !assessment ? (
      /* Clean Week 1 Introduction Card (Shown before student starts session) */
      <Card padding="lg" class="start-session-card">
        <div class="start-session-box">
          <span class="cycle-tag">{activeCycle.name}</span>
          <h2 class="start-session-title">Weekly Well-being Reflection</h2>
          <p class="start-session-desc">
            Take a quiet moment to reflect on your week. Your honest self-reflection helps us personalize your support and weekly focus.
          </p>

          <div class="session-meta-grid">
            <div class="meta-item">
              <FileText size={20} class="meta-icon" aria-hidden="true" />
              <div class="meta-content">
                <span class="meta-value">{activeCycle.total_questions} questions</span>
                <span class="meta-label">Total Questions</span>
              </div>
            </div>
            <div class="meta-item">
              <Timer size={20} class="meta-icon" aria-hidden="true" />
              <div class="meta-content">
                <span class="meta-value">{sessionDurationMins} minutes</span>
                <span class="meta-label">Reflection Duration</span>
              </div>
            </div>
          </div>

          <PrivacyNotice variant="notice" />

          <form method="POST" class="start-form">
            <input type="hidden" name="action_type" value="start_assessment" />
            <Button variant="primary" size="lg" type="submit">
              Start Assessment &rarr;
            </Button>
          </form>

          <NonClinicalDisclaimer />
        </div>
      </Card>
    ) : (
      /* Active Session View (10 Questions + Timer) */
      <div class="session-container">
        {/* Session Header Bar */}
        <Card padding="md" class="session-header-card">
          <div class="header-flex-top">
            <div class="header-info">
              <span class="cycle-name-tag">{activeCycle.name}</span>
              <h3 class="session-header-title">Weekly Reflection</h3>
            </div>
            
            <div class="timer-box">
              <span class="timer-label">Time Remaining</span>
              <span id="timer-display" class="timer-digits">
                {Math.floor(remainingSeconds / 60).toString().padStart(2, '0')}:
                {(remainingSeconds % 60).toString().padStart(2, '0')}
              </span>
            </div>
          </div>

          <div class="header-flex-bottom">
            <div class="progress-bar-wrap">
              <div class="progress-bar-track">
                <div class="progress-bar-fill" style="width: 100%"></div>
              </div>
              <span class="progress-text">{displayQuestions.length} questions</span>
            </div>
            <span class="save-status-text">
              <ShieldCheck size={14} aria-hidden="true" /> Your responses are private and used to personalize future reflection content.
            </span>
          </div>
        </Card>

        {/* Questions Form */}
        <Card padding="lg" class="questions-card">
          <form method="POST" id="reflection-form">
            <div class="questions-list">
              {displayQuestions.map((q, idx) => (
                <QuestionCard
                  question={q}
                  questionNumber={idx + 1}
                  selectedOptionId={existingResponseMap.get(q.id)}
                />
              ))}
            </div>

            {/* Reflection Box */}
            <ReflectionBox value={existingReflectionText} />

            {/* Pre-completion UI status notice */}
            <div class="precompletion-notice-box" id="notice-box">
              <span id="completion-status-text" class="status-msg">
                {isTimerCompleteOnServer
                  ? 'Your reflection responses are ready to submit.'
                  : 'Your responses are complete. Please continue reflecting until your session timer finishes.'}
              </span>
            </div>

            <PrivacyNotice variant="compact" />

            <div class="session-nav-actions">
              <a href="/student/dashboard">
                <Button variant="outline" type="button">
                  &larr; Leave Reflection
                </Button>
              </a>
              
              <div class="submit-action-group">
                <Button
                  variant="primary"
                  type="submit"
                  id="submit-btn"
                  name="action_type"
                  value="student_submit"
                  disabled={!isTimerCompleteOnServer}
                >
                  <CheckCircle2 size={16} aria-hidden="true" />
                  <span id="btn-label">
                    {isTimerCompleteOnServer ? 'Complete Weekly Reflection' : 'Session In Progress'}
                  </span>
                </Button>

                {isTestMode && (
                  <div class="test-submit-control">
                    <span class="test-submit-note">Testing only — skips the 10-minute waiting period.</span>
                    <Button
                      variant="secondary"
                      type="submit"
                      name="action_type"
                      value="test_submit"
                      class="test-submit-btn"
                      disabled
                    >
                      Test Submit
                    </Button>
                  </div>
                )}
              </div>
            </div>
          </form>
        </Card>
      </div>
    )}
  </div>
</StudentLayout>

<script is:inline define:vars={{ remainingSeconds, isTimerCompleteOnServer, isTestMode }}>
  (function () {
    var timerDisplay = document.getElementById('timer-display');
    var submitBtn = document.getElementById('submit-btn');
    var btnLabel = document.getElementById('btn-label');
    var statusText = document.getElementById('completion-status-text');

    var secondsLeft = remainingSeconds;
    var timerInterval = null;

    function formatTime(secs) {
      var m = Math.floor(secs / 60);
      var s = secs % 60;
      return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
    }

    function checkFormValidity() {
      var form = document.getElementById('reflection-form');
      if (!form) return false;

      var requiredQuestions = form.querySelectorAll('.question-card');
      var allAnswered = true;

      requiredQuestions.forEach(function (card) {
        var radios = card.querySelectorAll('input[type="radio"]');
        if (radios.length > 0) {
          var isChecked = Array.from(radios).some(function (r) { return r.checked; });
          if (!isChecked) allAnswered = false;
        }
      });

      return allAnswered;
    }

    function updateState() {
      var isAnswered = checkFormValidity();
      var isTimeUp = secondsLeft <= 0;
      var testSubmitBtn = document.querySelector('.test-submit-btn');

      if (timerDisplay) {
        timerDisplay.textContent = formatTime(secondsLeft);
      }

      if (!isAnswered) {
        if (statusText) statusText.textContent = 'Complete all required reflections to continue.';
        if (submitBtn) submitBtn.disabled = true;
        if (btnLabel) btnLabel.textContent = 'Session In Progress';
        if (testSubmitBtn) testSubmitBtn.disabled = true;
      } else {
        if (testSubmitBtn) testSubmitBtn.disabled = false;

        if (!isTimeUp) {
          if (statusText) statusText.textContent = 'Your responses are complete. Please continue reflecting until your session is ready to complete.';
          if (submitBtn) submitBtn.disabled = true;
          if (btnLabel) btnLabel.textContent = 'Session In Progress (' + formatTime(secondsLeft) + ')';
        } else {
          if (statusText) statusText.textContent = 'Your reflection is ready to complete.';
          if (submitBtn) submitBtn.disabled = false;
          if (btnLabel) btnLabel.textContent = 'Complete Weekly Reflection';
        }
      }
    }

    if (secondsLeft > 0) {
      timerInterval = setInterval(function () {
        secondsLeft--;
        updateState();
        if (secondsLeft <= 0) {
          clearInterval(timerInterval);
        }
      }, 1000);
    }

    var form = document.getElementById('reflection-form');
    if (form) {
      form.addEventListener('change', updateState);
    }

    updateState();
  })();
</script>

<style>
  .checkin-page-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 760px;
    margin: 0 auto;
  }

  .empty-cycle-box {
    text-align: center;
    padding: var(--space-8);
  }

  .start-session-card {
    background: linear-gradient(135deg, #ffffff 0%, var(--color-primary-50) 100%);
    border: 1px solid var(--color-primary-100);
  }

  .start-session-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-8) var(--space-6);
  }

  .cycle-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-700);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: var(--color-primary-100);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }

  .start-session-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin-bottom: var(--space-3);
  }

  .start-session-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 520px;
    margin-bottom: var(--space-8);
    line-height: 1.5;
  }

  .session-meta-grid {
    display: flex;
    justify-content: center;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    background-color: #ffffff;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .meta-icon {
    color: var(--color-primary-600);
  }

  .meta-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .meta-value {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .meta-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .start-form {
    margin-bottom: var(--space-6);
  }

  .start-session-privacy {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .completed-session-card {
    background: linear-gradient(135deg, #ffffff 0%, var(--color-primary-50) 100%);
  }

  .completed-session-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-6);
  }

  .completed-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: #d1fae5;
    color: #047857;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .completed-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: var(--space-2);
  }

  .completed-text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 500px;
    margin-bottom: var(--space-6);
  }

  .completed-actions {
    display: flex;
    gap: var(--space-3);
  }

  .session-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .session-header-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
  }

  .header-flex-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .cycle-name-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-700);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .session-header-title {
    font-size: 1.25rem;
    font-weight: 700;
