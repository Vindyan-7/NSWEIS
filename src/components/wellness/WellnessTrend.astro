---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { CheckCircle2 } from '@lucide/astro';

interface TrendPoint {
  week: string;
  completed?: boolean;
}

interface Props {
  points?: TrendPoint[];
  title?: string;
}

const {
  points = [
    { week: 'W1', completed: true },
  ],
  title = 'Reflection Consistency',
} = Astro.props;
---

<Card padding="md">
  <div class="trend-header">
    <h4 class="trend-title">{title}</h4>
    <span class="trend-tag">Weekly Participation</span>
  </div>
  <div class="trend-grid">
    {points.map((p) => (
      <div class="trend-item">
        <span class="trend-week">{p.week}</span>
        <div class="trend-status-icon">
          <CheckCircle2 size={20} class="text-success" aria-hidden="true" />
        </div>
        <Badge variant="stable" size="sm">Completed</Badge>
      </div>
    ))}
  </div>
</Card>

<style>
  .trend-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .trend-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .trend-tag {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .trend-grid {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) 0;
  }

  .trend-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-md);
  }

  .trend-week {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .trend-status-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .text-success {
    color: #047857;
  }
</style>
