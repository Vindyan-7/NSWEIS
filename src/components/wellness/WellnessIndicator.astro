---
import type { WellnessBand } from '../../types/domain';
import Badge from '../ui/Badge.astro';

interface Props {
  score?: number | null;
  band?: WellnessBand | null;
  size?: 'sm' | 'md' | 'lg';
}

const { score = 7.5, band = 'stable', size = 'md' } = Astro.props;

const bandLabel = band ? band.replace('_', ' ') : 'stable';
---

<div class={`wellness-indicator indicator-${size}`}>
  <div class="score-dial">
    <span class="score-value">{score ? score.toFixed(1) : '--'}</span>
    <span class="score-max">/10</span>
  </div>
  <div class="indicator-meta">
    <Badge variant={band || 'stable'} size={size === 'lg' ? 'md' : 'sm'}>
      {bandLabel}
    </Badge>
    <span class="indicator-tag">Overall Indicator</span>
  </div>
</div>

<style>
  .wellness-indicator {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .score-dial {
    display: flex;
    align-items: baseline;
  }

  .score-value {
    font-weight: 800;
    color: var(--color-primary-600);
    line-height: 1;
  }

  .score-max {
    font-size: 0.875rem;
    color: var(--color-text-subtle);
    font-weight: 500;
  }

  .indicator-md .score-value {
    font-size: 2.25rem;
  }

  .indicator-lg .score-value {
    font-size: 3rem;
  }

  .indicator-sm .score-value {
    font-size: 1.5rem;
  }

  .indicator-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .indicator-tag {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }
</style>
