---
import type { WellnessCategory } from '../../types/domain';
import Badge from '../ui/Badge.astro';

interface Props {
  category: WellnessCategory;
  score?: number;
  band?: string;
}

const { category } = Astro.props;

const formattedCategory = category.replace('_', ' ').replace(/\b\w/g, (l) => l.toUpperCase());
---

<div class="category-indicator">
  <div class="cat-header">
    <span class="cat-name">{formattedCategory}</span>
    <Badge variant="neutral" size="sm">Reflection Focus</Badge>
  </div>
  <p class="cat-desc">Self-reflection topic for your weekly focus steps and activities.</p>
</div>

<style>
  .category-indicator {
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cat-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .cat-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
