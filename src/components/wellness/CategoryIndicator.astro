---
import type { WellnessCategory, WellnessBand } from '../../types/domain';
import Badge from '../ui/Badge.astro';
import Progress from '../ui/Progress.astro';

interface Props {
  category: WellnessCategory;
  score: number;
  band: WellnessBand;
}

const { category, score, band } = Astro.props;

const formattedCategory = category.replace('_', ' ').replace(/\b\w/g, (l) => l.toUpperCase());

const progressVariantMap: Record<WellnessBand, 'stable' | 'improving' | 'attention' | 'elevated'> = {
  stable: 'stable',
  watch: 'improving',
  needs_attention: 'attention',
  elevated: 'elevated',
};
---

<div class="category-indicator">
  <div class="cat-header">
    <span class="cat-name">{formattedCategory}</span>
    <Badge variant={band} size="sm">{band.replace('_', ' ')}</Badge>
  </div>
  <div class="cat-body">
    <Progress value={score * 10} variant={progressVariantMap[band]} />
    <span class="cat-score">{score.toFixed(1)} / 10</span>
  </div>
</div>

<style>
  .category-indicator {
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cat-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .cat-body {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .cat-score {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
</style>
