---
interface Props {
  class?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  id?: string;
}

const { class: className = '', padding = 'md', id } = Astro.props;
---

<div id={id} class={`card card-padding-${padding} ${className}`}>
  <slot />
</div>

<style>
  .card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-normal);
  }

  .card-padding-none {
    padding: 0;
  }
  .card-padding-sm {
    padding: var(--space-3);
  }
  .card-padding-md {
    padding: var(--space-5);
  }
  .card-padding-lg {
    padding: var(--space-8);
  }

  @media (max-width: 767px) {
    .card {
      border-radius: 18px;
    }
    .card-padding-lg {
      padding: 1.375rem;
    }
    .card-padding-md {
      padding: 1.125rem;
    }
  }
</style>
