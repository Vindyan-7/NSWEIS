---
interface Props {
  title?: string;
  message?: string;
}

const { title = 'Something went wrong', message = 'An error occurred while loading this section.' } = Astro.props;
---

<div class="error-state">
  <div class="error-icon">⚠️</div>
  <h4 class="error-title">{title}</h4>
  <p class="error-desc">{message}</p>
  <div class="error-actions">
    <slot />
  </div>
</div>

<style>
  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-8);
    background-color: var(--color-band-elevated-bg);
    border: 1px solid var(--color-band-elevated-border);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .error-icon {
    font-size: 2rem;
    margin-bottom: var(--space-2);
  }

  .error-title {
    font-size: 1rem;
    font-weight: 600;
    color: #991b1b;
  }

  .error-desc {
    font-size: 0.875rem;
    color: #b91c1c;
    margin-top: var(--space-1);
  }

  .error-actions {
    margin-top: var(--space-4);
  }
</style>
