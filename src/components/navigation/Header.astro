---
import Avatar from '../ui/Avatar.astro';

interface Props {
  userName?: string;
  userRole?: string;
  avatarUrl?: string | null;
}
 
const { userName = 'Guest', userRole = 'User', avatarUrl } = Astro.props;
---

<header class="app-header glass-panel">
  <div class="header-content">
    <div class="header-left">
      <div class="mobile-brand-mark">
        <div class="brand-logo-badge font-bold">NS</div>
        <span class="brand-app-name font-bold">NSWEIS</span>
      </div>
      <slot name="left" />
    </div>

    <div class="header-right">
      <div class="user-info">
        <span class="user-name font-semibold">{userName}</span>
        <span class="user-role">{userRole}</span>
      </div>
      <Avatar name={userName} src={avatarUrl} size="sm" />
      <form action="/logout" method="POST" class="logout-form">
        <button type="submit" class="logout-btn" title="Logout">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </button>
      </form>
    </div>
  </div>
</header>

<style>
  .app-header {
    height: 4rem;
    padding: 0 var(--space-6);
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-border-subtle);
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg-surface);
  }

  .header-content {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mobile-brand-mark {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-logo-badge {
    width: 2rem;
    height: 2rem;
    background-color: var(--color-primary-600);
    color: #ffffff;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .brand-app-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-main);
    letter-spacing: -0.01em;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .user-info {
    display: flex;
    flex-direction: column;
    text-align: right;
  }

  .user-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .user-role {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: capitalize;
  }

  .logout-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: var(--space-1);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--transition-fast);
  }

  .logout-btn:hover {
    color: var(--color-band-elevated);
  }

  @media (max-width: 1023px) {
    .mobile-brand-mark {
      display: flex;
    }
  }

  @media (max-width: 767px) {
    .app-header {
      height: 3.75rem;
      padding: 0 1rem;
    }

    .user-info {
      max-width: 140px;
    }

    .user-name {
      font-size: 0.8125rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .user-role {
      font-size: 0.6875rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .logout-form {
      display: none;
    }
  }
</style>
