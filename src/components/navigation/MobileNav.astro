---
import { MoreHorizontal, X, LogOut } from '@lucide/astro';
import NSWESILogo from '../brand/NSWESILogo.astro';

interface NavItem {
  label: string;
  mobileLabel?: string;
  href: string;
  icon?: any;
  active?: boolean;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;

// Primary items: up to 4 items + "More"
const primaryItems = items.slice(0, 4);
const secondaryItems = items.slice(4);

const hasMore = secondaryItems.length > 0;
---

<nav class="mobile-nav glass-panel" aria-label="Mobile Navigation">
  <div class="mobile-nav-bar">
    {primaryItems.map((item) => {
      const IconComponent = typeof item.icon === 'function' || (typeof item.icon === 'object' && item.icon !== null) ? item.icon : null;
      const displayLabel = item.mobileLabel || (item.label === 'Weekly Check-in' ? 'Check-in' : item.label);
      return (
        <a href={item.href} class={`mobile-nav-item ${item.active ? 'is-active' : ''}`}>
          <div class="nav-icon-pill">
            {IconComponent ? (
              <IconComponent size={22} />
            ) : (
              item.icon && <span class="mobile-nav-icon">{item.icon}</span>
            )}
          </div>
          <span class="mobile-nav-label">{displayLabel}</span>
        </a>
      );
    })}

    {hasMore && (
      <button type="button" class="mobile-nav-item more-btn" id="mobile-more-toggle" aria-expanded="false" aria-label="Open more navigation menu">
        <div class="nav-icon-pill">
          <MoreHorizontal size={22} />
        </div>
        <span class="mobile-nav-label">More</span>
      </button>
    )}
  </div>
</nav>

{hasMore && (
  <div class="mobile-more-overlay" id="mobile-more-overlay" aria-hidden="true">
    <div class="mobile-more-sheet glass-panel" role="dialog" aria-modal="true" aria-label="Secondary navigation">
      <div class="sheet-header">
        <div class="sheet-title-wrap">
          <NSWESILogo variant="symbol" size={24} />
          <span class="sheet-title font-bold">NSWESI Menu</span>
        </div>
        <button type="button" class="sheet-close-btn" id="mobile-more-close" aria-label="Close menu">
          <X size={20} />
        </button>
      </div>

      <div class="sheet-nav-list">
        {secondaryItems.map((item) => {
          const IconComponent = typeof item.icon === 'function' || (typeof item.icon === 'object' && item.icon !== null) ? item.icon : null;
          return (
            <a href={item.href} class={`sheet-nav-link ${item.active ? 'is-active' : ''}`}>
              {IconComponent ? (
                <IconComponent size={20} />
              ) : (
                item.icon && <span class="nav-icon">{item.icon}</span>
              )}
              <span>{item.label}</span>
            </a>
          );
        })}
      </div>

      <form action="/logout" method="POST" class="sheet-logout-form">
        <button type="submit" class="sheet-logout-btn font-semibold">
          <LogOut size={20} />
          <span>Sign Out</span>
        </button>
      </form>
    </div>
  </div>
)}

<script>
  const toggleBtn = document.getElementById('mobile-more-toggle');
  const closeBtn = document.getElementById('mobile-more-close');
  const overlay = document.getElementById('mobile-more-overlay');

  function openSheet() {
    if (overlay) {
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeSheet() {
    if (overlay) {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  }

  toggleBtn?.addEventListener('click', openSheet);
  closeBtn?.addEventListener('click', closeSheet);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeSheet();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay?.classList.contains('is-open')) {
      closeSheet();
    }
  });
</script>

<style>
  .mobile-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: #ffffff;
    border-top: 1px solid var(--color-border-subtle);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-shadow: 0 -4px 16px rgba(15, 23, 42, 0.06);
  }

  @media (max-width: 1023px) {
    .mobile-nav {
      display: block;
    }
  }

  .mobile-nav-bar {
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 4.25rem;
    padding: 0 var(--space-2);
  }

  .mobile-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    flex: 1;
    min-height: 48px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-icon-pill {
    padding: 3px 12px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .mobile-nav-item.is-active {
    color: var(--color-primary-700);
    font-weight: 700;
  }

  .mobile-nav-item.is-active .nav-icon-pill {
    background-color: var(--color-primary-100);
    color: var(--color-primary-700);
  }

  .mobile-nav-label {
    font-size: 0.71875rem;
    line-height: 1.1;
  }

  .mobile-more-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(6px);
    z-index: 300;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .mobile-more-overlay.is-open {
    display: flex;
    opacity: 1;
  }

  .mobile-more-sheet {
    width: 100%;
    max-width: 480px;
    background: #ffffff;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    padding: var(--space-5) var(--space-4) calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    box-shadow: var(--shadow-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transform: translateY(100%);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-more-overlay.is-open .mobile-more-sheet {
    transform: translateY(0);
  }

  .sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .sheet-title-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .sheet-title {
    font-size: 1rem;
    color: var(--color-text-main);
  }

  .sheet-close-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: var(--space-1);
    min-height: 44px;
    min-width: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
  }

  .sheet-nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sheet-nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    color: var(--color-text-main);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    min-height: 48px;
    transition: background var(--transition-fast);
  }

  .sheet-nav-link:hover, .sheet-nav-link.is-active {
    background: var(--color-primary-50);
    color: var(--color-primary-700);
  }

  .sheet-logout-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--color-band-elevated-bg);
    color: var(--color-band-elevated);
    border: 1px solid var(--color-band-elevated-border);
    border-radius: var(--radius-lg);
    font-size: 0.9375rem;
    cursor: pointer;
    min-height: 52px;
  }
</style>
