---
import type { Intervention } from '../../types/domain';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  intervention: Intervention;
}

const { intervention } = Astro.props;

const formattedDate = new Date(intervention.scheduled_at).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
---

<Card padding="md" class="intervention-card">
  <div class="int-header">
    <span class="int-cat">{intervention.category.replace('_', ' ')}</span>
    <Badge
      variant={
        intervention.status === 'completed'
          ? 'stable'
          : intervention.status === 'ongoing'
          ? 'improving'
          : intervention.status === 'cancelled'
          ? 'neutral'
          : 'primary'
      }
      size="sm"
    >
      {intervention.status}
    </Badge>
  </div>
  <h4 class="int-title">{intervention.title}</h4>
  <p class="int-desc">{intervention.description}</p>

  <div class="int-footer">
    <div class="int-meta">
      <span class="int-meta-item">📍 {intervention.location}</span>
      <span class="int-meta-item">📅 {formattedDate}</span>
    </div>
    {intervention.capacity && (
      <span class="int-capacity">Cap: {intervention.capacity} seats</span>
    )}
  </div>

  <div class="int-actions">
    {intervention.status !== 'completed' && intervention.status !== 'cancelled' && (
      <form method="POST" class="status-form">
        <input type="hidden" name="intervention_id" value={intervention.id} />
        {intervention.status === 'scheduled' && (
          <button type="submit" name="action_type" value="mark_ongoing" class="action-btn active-btn">
            Start Session (Ongoing)
          </button>
        )}
        {(intervention.status === 'scheduled' || intervention.status === 'ongoing') && (
          <button type="submit" name="action_type" value="mark_completed" class="action-btn complete-btn">
            Complete
          </button>
        )}
        <button type="submit" name="action_type" value="mark_cancelled" class="action-btn cancel-btn">
          Cancel
        </button>
      </form>
    )}
  </div>
</Card>

<style>
  .intervention-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .int-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .int-cat {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary-600);
    text-transform: capitalize;
    background-color: var(--color-primary-50);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .int-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .int-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .int-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-subtle);
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }

  .int-meta {
    display: flex;
    gap: var(--space-3);
  }

  .int-capacity {
    font-weight: 500;
  }

  .int-actions {
    margin-top: var(--space-2);
  }

  .status-form {
    display: flex;
    gap: var(--space-2);
    justify-content: flex-end;
  }

  .action-btn {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
    cursor: pointer;
    background: transparent;
  }

  .active-btn {
    color: var(--color-primary-700);
    border-color: var(--color-primary-300);
    background-color: var(--color-primary-50);
  }

  .complete-btn {
    color: #047857;
    border-color: #a7f3d0;
    background-color: #ecfdf5;
  }

  .cancel-btn {
    color: var(--color-text-muted);
  }
</style>

