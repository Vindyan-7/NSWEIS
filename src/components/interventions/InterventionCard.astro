---
import type { Intervention } from '../../types/domain';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  intervention: Intervention;
}

const { intervention } = Astro.props;

const formattedDate = new Date(intervention.scheduled_at).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
---

<Card padding="md" class="intervention-card">
  <div class="int-header">
    <span class="int-cat">{intervention.category.replace('_', ' ')}</span>
    <Badge variant={intervention.status === 'completed' ? 'stable' : 'primary'} size="sm">
      {intervention.status}
    </Badge>
  </div>
  <h4 class="int-title">{intervention.title}</h4>
  <p class="int-desc">{intervention.description}</p>
  <div class="int-footer">
    <div class="int-meta">
      <span class="int-meta-item">📍 {intervention.location}</span>
      <span class="int-meta-item">📅 {formattedDate}</span>
    </div>
    {intervention.capacity && (
      <span class="int-capacity">Cap: {intervention.capacity} seats</span>
    )}
  </div>
</Card>

<style>
  .intervention-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .int-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .int-cat {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary-600);
    text-transform: capitalize;
    background-color: var(--color-primary-50);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .int-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .int-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .int-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }

  .int-meta {
    display: flex;
    gap: var(--space-3);
  }

  .int-capacity {
    font-weight: 500;
  }
</style>
