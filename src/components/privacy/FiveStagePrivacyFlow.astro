---
import { Lock, UserCheck, BarChart3, Building, ShieldCheck } from '@lucide/astro';

const stages = [
  {
    number: 1,
    title: 'Student Self-Reflection',
    badge: 'Private & Voluntary',
    badgeVariant: 'primary',
    description: 'Weekly reflection responses submitted confidentially by students.',
    icon: Lock,
  },
  {
    number: 2,
    title: 'Personal Insight',
    badge: 'Student Only',
    badgeVariant: 'success',
    description: 'Confidential personal wellness indicators and supportive suggestions.',
    icon: UserCheck,
  },
  {
    number: 3,
    title: 'Anonymous Intelligence',
    badge: 'College Officer',
    badgeVariant: 'warning',
    description: 'Campus-wide aggregate trends. Privacy threshold (&ge; 10 completed) suppresses small groups.',
    icon: BarChart3,
  },
  {
    number: 4,
    title: 'Targeted Intervention',
    badge: 'College Officer',
    badgeVariant: 'info',
    description: 'Institutional-level wellness initiatives created without accessing individual responses.',
    icon: Building,
  },
  {
    number: 5,
    title: 'Government Oversight',
    badge: 'Statewide Aggregate',
    badgeVariant: 'neutral',
    description: 'High-level multi-college participation trends across authorized institutions.',
    icon: ShieldCheck,
  },
];
---

<div class="five-stage-privacy-flow">
  <div class="flow-header">
    <h3 class="flow-title">NSWEIS Privacy-Preserving Data Flow</h3>
    <p class="flow-subtitle">Designed around DPDP privacy principles: Private student reflection separated from anonymous institutional intelligence.</p>
  </div>

  <div class="stages-container">
    {stages.map((stg, idx) => (
      <div class="stage-card">
        <div class="stage-number-badge">{stg.number}</div>
        <div class="stage-icon-box">
          <stg.icon size={20} />
        </div>
        <div class="stage-details">
          <div class="stage-top font-semibold">
            <span class="stage-name">{stg.title}</span>
            <span class={`pill-tag tag-${stg.badgeVariant}`}>{stg.badge}</span>
          </div>
          <p class="stage-desc">{stg.description}</p>
        </div>
        {idx < stages.length - 1 && (
          <div class="flow-arrow" aria-hidden="true">&darr;</div>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .five-stage-privacy-flow {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .flow-title {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text-main);
  }

  .flow-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .stages-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .stage-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-primary);
  }

  .stage-number-badge {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    font-weight: 700;
    font-size: var(--font-size-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stage-icon-box {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .stage-details {
    flex: 1;
  }

  .stage-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .stage-name {
    font-size: var(--font-size-md);
    color: var(--color-text-main);
  }

  .stage-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .pill-tag {
    font-size: var(--font-size-xs);
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .tag-primary { background: rgba(99, 102, 241, 0.12); color: var(--color-primary); }
  .tag-success { background: rgba(16, 185, 129, 0.12); color: #10b981; }
  .tag-warning { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
  .tag-info { background: rgba(14, 165, 233, 0.12); color: #0ea5e9; }
  .tag-neutral { background: rgba(100, 116, 139, 0.12); color: var(--color-text-muted); }

  .flow-arrow {
    position: absolute;
    bottom: -16px;
    left: 28px;
    font-weight: 700;
    color: var(--color-primary);
    font-size: 14px;
    z-index: 2;
  }
</style>
