---
import '../styles/globals.css';
import PrivacyNotice from '../components/privacy/PrivacyNotice.astro';
import NSWESILogo from '../components/brand/NSWESILogo.astro';

interface Props {
  title: string;
  brandName?: string;
  minimalNav?: boolean;
  navRightAction?: { label: string; href: string; subtext?: string };
}

const {
  title,
  minimalNav = false,
  navRightAction,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — NSWESI</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0D1B3D" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="public-layout">
      <header class="public-nav glass-panel">
        <div class="container nav-content">
          <NSWESILogo variant="compact" size="sm" href="/" />
          <div class="nav-links">
            {navRightAction ? (
              <div class="nav-auth-switch">
                {navRightAction.subtext && <span class="nav-auth-subtext">{navRightAction.subtext}</span>}
                <a href={navRightAction.href} class="nav-auth-btn">{navRightAction.label}</a>
              </div>
            ) : minimalNav ? (
              <a href="/login" class="nav-login-btn">Sign in</a>
            ) : (
              <>
                <a href="/">Home</a>
                <a href="/privacy">Privacy</a>
                <a href="/login" class="nav-login-btn">Login</a>
              </>
            )}
          </div>
        </div>
      </header>
      <main class="public-main">
        <slot />
      </main>
      <footer class="public-footer">
        <div class="container footer-content">
          <PrivacyNotice variant="compact" />
          <p class="footer-copy">&copy; 2026 National Student Wellbeing & Emotional Support Intelligence (NSWESI). Non-clinical early-intervention ecosystem.</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .public-layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .public-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .nav-content {
    height: 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-title {
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    color: var(--color-text-main);
    transition: color 0.15s ease;
  }

  .nav-brand:hover .brand-title {
    color: var(--color-primary-600);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-weight: 500;
  }

  .nav-auth-switch {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-auth-subtext {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .nav-auth-btn,
  .nav-login-btn {
    background-color: var(--color-primary-600);
    color: var(--color-text-inverse) !important;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .nav-auth-btn:hover,
  .nav-login-btn:hover {
    background-color: var(--color-primary-700);
  }

  .public-main {
    flex: 1;
  }

  .public-footer {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-surface);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }
</style>
