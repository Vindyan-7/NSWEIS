---
import '../styles/globals.css';
import PrivacyNotice from '../components/privacy/PrivacyNotice.astro';
import NSWESILogo from '../components/brand/NSWESILogo.astro';

interface Props {
  title: string;
  brandName?: string;
  minimalNav?: boolean;
  navRightAction?: { label: string; href: string; subtext?: string };
}

const {
  title,
  minimalNav = false,
  navRightAction,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — NSWESI</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0D1B3D" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="public-layout">
      <header class="public-nav glass-panel">
        <div class="container nav-content">
          <NSWESILogo variant="compact" size="sm" href="/" />
          <nav class="nav-links" aria-label="Main Navigation">
            {navRightAction ? (
              <div class="nav-auth-switch">
                {navRightAction.subtext && <span class="nav-auth-subtext">{navRightAction.subtext}</span>}
                <a href={navRightAction.href} class="nav-auth-btn">{navRightAction.label}</a>
              </div>
            ) : minimalNav ? (
              <a href="/login" class="nav-login-btn">Sign in</a>
            ) : (
              <>
                <a href="/" class="nav-link">Home</a>
                <a href="/privacy" class="nav-link">Privacy</a>
                <a href="/login" class="nav-login-btn">Login</a>
              </>
            )}
          </nav>
        </div>
      </header>
      <main class="public-main">
        <slot />
      </main>
      <footer class="public-footer">
        <div class="container footer-content">
          <div class="footer-top">
            <div class="footer-brand-col">
              <NSWESILogo variant="compact" size="sm" href="/" />
              <p class="footer-tagline">National Student Wellbeing &amp; Emotional Support Intelligence</p>
            </div>
            <nav class="footer-nav" aria-label="Footer Navigation">
              <a href="/">Home</a>
              <a href="/privacy">Privacy</a>
              <a href="/login">Login</a>
            </nav>
          </div>
          <div class="footer-divider"></div>
          <div class="footer-bottom">
            <p class="footer-disclaimer">
              <strong>Non-Clinical Notice:</strong> NSWESI is designed for early awareness and preventive wellbeing support — not clinical diagnosis or medical treatment.
            </p>
            <p class="footer-copy">
              &copy; {new Date().getFullYear()} National Student Wellbeing &amp; Emotional Support Intelligence (NSWESI). All rights reserved.
            </p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .public-layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .public-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
  }

  .nav-content {
    height: 4.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-title {
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    color: var(--color-text-main);
    transition: color 0.15s ease;
  }

  .nav-brand:hover .brand-title {
    color: var(--color-primary-600);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-6, 1.5rem);
    font-weight: 500;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--brand-navy, #0D1B3D);
  }

  .nav-auth-switch {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-auth-subtext {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .nav-auth-btn,
  .nav-login-btn {
    background-color: var(--brand-navy, #0D1B3D);
    color: #ffffff !important;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-md, 0.5rem);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .nav-auth-btn:hover,
  .nav-login-btn:hover {
    background-color: #162a56;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(13, 27, 61, 0.18);
  }

  @media (max-width: 640px) {
    .nav-content {
      height: 3.75rem;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .nav-links {
      gap: 0.875rem;
    }

    .nav-link {
      font-size: 0.875rem;
    }

    .nav-login-btn {
      padding: 0.4375rem 0.875rem;
      font-size: 0.8125rem;
      min-height: 40px;
      display: inline-flex;
      align-items: center;
    }
  }

  @media (max-width: 380px) {
    .nav-content {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    .nav-links {
      gap: 0.625rem;
    }

    .nav-link {
      font-size: 0.8125rem;
    }

    .nav-login-btn {
      padding: 0.375rem 0.75rem;
    }
  }

  .public-main {
    flex: 1;
  }

  .public-footer {
    padding: var(--space-12, 3rem) 0 var(--space-8, 2rem);
    border-top: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-surface);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6, 1.5rem);
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4, 1rem);
  }

  @media (min-width: 640px) {
    .footer-top {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .footer-tagline {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6, 1.5rem);
  }

  .footer-nav a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-nav a:hover {
    color: var(--color-primary-600);
  }

  .footer-divider {
    height: 1px;
    background: var(--color-border-subtle);
    width: 100%;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
    text-align: left;
  }

  .footer-disclaimer {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    margin: 0;
  }
</style>
